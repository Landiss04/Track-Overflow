// Compile errors: load into wayside 1 and it is refused, with every
// problem listed. The running program keeps running.

VAR_IN  OCC_1..20 SWREV_12 MAINT
VAR_OUT SW_12 XING_19 AUTH_1 AUTH_2
VAR_IN  OCC_21                      // wayside 1 has no block 21
VAR_OUT AUTH_5..1                   // a range must ascend

SW_12 := OCC_1 AND                  // the expression ends too soon
XING_19 := (OCC_18 OR OCC_19        // unbalanced parenthesis
OCC_3 := 1                          // an input cannot be assigned
AUTH_1 := OCC_2 & OCC_3             // & is not an operator; use AND
AUTH_2 := 2                         // values are single bits: 0 or 1
AUTH_3 OCC_4                        // not VAR_IN, VAR_OUT or NAME := ...

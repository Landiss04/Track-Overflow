// Green line, wayside 3: blocks 74-88, sections M-O.
// Switch 76 joins 76-77 when normal and 77-101 when reversed.
// Switch 85 joins 85-86 when normal and 100-85 when reversed.
// Blocks 100 and 101 lie outside this wayside.
//
// The wayside runs this program and nothing else, so every protection
// is here. AUTH_n passes the CTC Office's authority to the train in
// block n; 0 sends authority 0. The CTC Office's speed for block n
// arrives as five bits, SPD_n_0 (1 m/s) to SPD_n_4 (16 m/s), and goes
// out as CMD_n_0..4, capped at the block's limit.

VAR_IN  OCC_74..88
VAR_IN  CLOSED_74..88
VAR_IN  SWREV_76 CTCSW_76 CTCREV_76
VAR_IN  SWREV_85 CTCSW_85 CTCREV_85
VAR_IN  SPD_74_0..4 SPD_75_0..4 SPD_76_0..4 SPD_77_0..4 SPD_78_0..4
VAR_IN  SPD_79_0..4 SPD_80_0..4 SPD_81_0..4 SPD_82_0..4 SPD_83_0..4
VAR_IN  SPD_84_0..4 SPD_85_0..4 SPD_86_0..4 SPD_87_0..4 SPD_88_0..4
VAR_OUT AUTH_74..88
VAR_OUT SW_76 SW_85
VAR_OUT SIG_76_R SIG_76_Y SIG_76_G SIG_76_SG
VAR_OUT SIG_85_R SIG_85_Y SIG_85_G SIG_85_SG
VAR_OUT CMD_74_0..4 CMD_75_0..4 CMD_76_0..4 CMD_77_0..4 CMD_78_0..4
VAR_OUT CMD_79_0..4 CMD_80_0..4 CMD_81_0..4 CMD_82_0..4 CMD_83_0..4
VAR_OUT CMD_84_0..4 CMD_85_0..4 CMD_86_0..4 CMD_87_0..4 CMD_88_0..4

// Each switch obeys the CTC Office while it commands it (maintenance).
// Otherwise it routes around its normal leg while that leg is closed.
// A train on the points locks a switch where it reports: blocks 76 and
// 77 for switch 76, block 85 for switch 85.
WANT_76 := (CTCSW_76 AND CTCREV_76) OR (NOT CTCSW_76 AND CLOSED_76)
LOCK_76 := OCC_76 OR OCC_77
SW_76   := (LOCK_76 AND SWREV_76) OR (NOT LOCK_76 AND WANT_76)
WANT_85 := (CTCSW_85 AND CTCREV_85) OR (NOT CTCSW_85 AND CLOSED_86)
LOCK_85 := OCC_85
SW_85   := (LOCK_85 AND SWREV_85) OR (NOT LOCK_85 AND WANT_85)
// A switch that does not report where it is commanded is moving, or
// failed. Nothing may use the route over it: 76 and 77, or 85 and 86.
BAD_76  := SW_76 XOR SWREV_76
BAD_85  := SW_85 XOR SWREV_85

// Signal 76 shows the route into block 77. Exactly one aspect is lit
// for every input: red, else yellow, else green or super green.
BLOCKED_76 := OCC_77 OR CLOSED_77 OR BAD_76
CAUTION_76 := OCC_78 OR SWREV_76 OR CTCSW_76
SIG_76_R  := BLOCKED_76
SIG_76_Y  := NOT BLOCKED_76 AND CAUTION_76
SIG_76_G  := NOT BLOCKED_76 AND NOT CAUTION_76 AND OCC_79
SIG_76_SG := NOT BLOCKED_76 AND NOT CAUTION_76 AND NOT OCC_79

// Signal 85 shows the route out of block 85.
BLOCKED_85 := BAD_85 OR (NOT SWREV_85 AND (OCC_86 OR CLOSED_86))
CAUTION_85 := SWREV_85 OR OCC_87 OR CTCSW_85
SIG_85_R  := BLOCKED_85
SIG_85_Y  := NOT BLOCKED_85 AND CAUTION_85
SIG_85_G  := NOT BLOCKED_85 AND NOT CAUTION_85 AND OCC_88
SIG_85_SG := NOT BLOCKED_85 AND NOT CAUTION_85 AND NOT OCC_88

// A train keeps its authority while its own block is open and the
// blocks beside it, on the route the switches have set, are clear.
AUTH_74 := NOT (CLOSED_74 OR OCC_75)
AUTH_75 := NOT (CLOSED_75 OR OCC_74 OR OCC_76)
AUTH_76 := NOT (CLOSED_76 OR OCC_75 OR (NOT SWREV_76 AND OCC_77) OR BAD_76)
AUTH_77 := NOT (CLOSED_77 OR OCC_78 OR (NOT SWREV_76 AND OCC_76) OR BAD_76)
AUTH_78 := NOT (CLOSED_78 OR OCC_77 OR OCC_79)
AUTH_79 := NOT (CLOSED_79 OR OCC_78 OR OCC_80)
AUTH_80 := NOT (CLOSED_80 OR OCC_79 OR OCC_81)
AUTH_81 := NOT (CLOSED_81 OR OCC_80 OR OCC_82)
AUTH_82 := NOT (CLOSED_82 OR OCC_81 OR OCC_83)
AUTH_83 := NOT (CLOSED_83 OR OCC_82 OR OCC_84)
AUTH_84 := NOT (CLOSED_84 OR OCC_83 OR OCC_85)
AUTH_85 := NOT (CLOSED_85 OR OCC_84 OR (NOT SWREV_85 AND OCC_86) OR BAD_85)
AUTH_86 := NOT (CLOSED_86 OR OCC_87 OR (NOT SWREV_85 AND OCC_85) OR BAD_85)
AUTH_87 := NOT (CLOSED_87 OR OCC_86 OR OCC_88)
AUTH_88 := NOT (CLOSED_88 OR OCC_87)

// Speed. OVER_n is 1 when the CTC Office's speed for block n is above
// the block's limit, rounded down to whole m/s; then the limit's own
// bits go out instead. Nothing goes out without AUTH_n.

// Limit 40 km/h: 11 m/s, 01011 (bit 4 first).
OVER_74  := SPD_74_4 OR (SPD_74_3 AND SPD_74_2)
CMD_74_0 := AUTH_74 AND (OVER_74 OR SPD_74_0)
CMD_74_1 := AUTH_74 AND (OVER_74 OR SPD_74_1)
CMD_74_2 := AUTH_74 AND NOT OVER_74 AND SPD_74_2
CMD_74_3 := AUTH_74 AND (OVER_74 OR SPD_74_3)
CMD_74_4 := AUTH_74 AND NOT OVER_74 AND SPD_74_4
OVER_75  := SPD_75_4 OR (SPD_75_3 AND SPD_75_2)
CMD_75_0 := AUTH_75 AND (OVER_75 OR SPD_75_0)
CMD_75_1 := AUTH_75 AND (OVER_75 OR SPD_75_1)
CMD_75_2 := AUTH_75 AND NOT OVER_75 AND SPD_75_2
CMD_75_3 := AUTH_75 AND (OVER_75 OR SPD_75_3)
CMD_75_4 := AUTH_75 AND NOT OVER_75 AND SPD_75_4
OVER_76  := SPD_76_4 OR (SPD_76_3 AND SPD_76_2)
CMD_76_0 := AUTH_76 AND (OVER_76 OR SPD_76_0)
CMD_76_1 := AUTH_76 AND (OVER_76 OR SPD_76_1)
CMD_76_2 := AUTH_76 AND NOT OVER_76 AND SPD_76_2
CMD_76_3 := AUTH_76 AND (OVER_76 OR SPD_76_3)
CMD_76_4 := AUTH_76 AND NOT OVER_76 AND SPD_76_4

// Limit 70 km/h: 19 m/s, 10011 (bit 4 first).
OVER_77  := SPD_77_4 AND (SPD_77_3 OR SPD_77_2)
CMD_77_0 := AUTH_77 AND (OVER_77 OR SPD_77_0)
CMD_77_1 := AUTH_77 AND (OVER_77 OR SPD_77_1)
CMD_77_2 := AUTH_77 AND NOT OVER_77 AND SPD_77_2
CMD_77_3 := AUTH_77 AND NOT OVER_77 AND SPD_77_3
CMD_77_4 := AUTH_77 AND (OVER_77 OR SPD_77_4)
OVER_78  := SPD_78_4 AND (SPD_78_3 OR SPD_78_2)
CMD_78_0 := AUTH_78 AND (OVER_78 OR SPD_78_0)
CMD_78_1 := AUTH_78 AND (OVER_78 OR SPD_78_1)
CMD_78_2 := AUTH_78 AND NOT OVER_78 AND SPD_78_2
CMD_78_3 := AUTH_78 AND NOT OVER_78 AND SPD_78_3
CMD_78_4 := AUTH_78 AND (OVER_78 OR SPD_78_4)
OVER_79  := SPD_79_4 AND (SPD_79_3 OR SPD_79_2)
CMD_79_0 := AUTH_79 AND (OVER_79 OR SPD_79_0)
CMD_79_1 := AUTH_79 AND (OVER_79 OR SPD_79_1)
CMD_79_2 := AUTH_79 AND NOT OVER_79 AND SPD_79_2
CMD_79_3 := AUTH_79 AND NOT OVER_79 AND SPD_79_3
CMD_79_4 := AUTH_79 AND (OVER_79 OR SPD_79_4)
OVER_80  := SPD_80_4 AND (SPD_80_3 OR SPD_80_2)
CMD_80_0 := AUTH_80 AND (OVER_80 OR SPD_80_0)
CMD_80_1 := AUTH_80 AND (OVER_80 OR SPD_80_1)
CMD_80_2 := AUTH_80 AND NOT OVER_80 AND SPD_80_2
CMD_80_3 := AUTH_80 AND NOT OVER_80 AND SPD_80_3
CMD_80_4 := AUTH_80 AND (OVER_80 OR SPD_80_4)
OVER_81  := SPD_81_4 AND (SPD_81_3 OR SPD_81_2)
CMD_81_0 := AUTH_81 AND (OVER_81 OR SPD_81_0)
CMD_81_1 := AUTH_81 AND (OVER_81 OR SPD_81_1)
CMD_81_2 := AUTH_81 AND NOT OVER_81 AND SPD_81_2
CMD_81_3 := AUTH_81 AND NOT OVER_81 AND SPD_81_3
CMD_81_4 := AUTH_81 AND (OVER_81 OR SPD_81_4)
OVER_82  := SPD_82_4 AND (SPD_82_3 OR SPD_82_2)
CMD_82_0 := AUTH_82 AND (OVER_82 OR SPD_82_0)
CMD_82_1 := AUTH_82 AND (OVER_82 OR SPD_82_1)
CMD_82_2 := AUTH_82 AND NOT OVER_82 AND SPD_82_2
CMD_82_3 := AUTH_82 AND NOT OVER_82 AND SPD_82_3
CMD_82_4 := AUTH_82 AND (OVER_82 OR SPD_82_4)
OVER_83  := SPD_83_4 AND (SPD_83_3 OR SPD_83_2)
CMD_83_0 := AUTH_83 AND (OVER_83 OR SPD_83_0)
CMD_83_1 := AUTH_83 AND (OVER_83 OR SPD_83_1)
CMD_83_2 := AUTH_83 AND NOT OVER_83 AND SPD_83_2
CMD_83_3 := AUTH_83 AND NOT OVER_83 AND SPD_83_3
CMD_83_4 := AUTH_83 AND (OVER_83 OR SPD_83_4)
OVER_84  := SPD_84_4 AND (SPD_84_3 OR SPD_84_2)
CMD_84_0 := AUTH_84 AND (OVER_84 OR SPD_84_0)
CMD_84_1 := AUTH_84 AND (OVER_84 OR SPD_84_1)
CMD_84_2 := AUTH_84 AND NOT OVER_84 AND SPD_84_2
CMD_84_3 := AUTH_84 AND NOT OVER_84 AND SPD_84_3
CMD_84_4 := AUTH_84 AND (OVER_84 OR SPD_84_4)
OVER_85  := SPD_85_4 AND (SPD_85_3 OR SPD_85_2)
CMD_85_0 := AUTH_85 AND (OVER_85 OR SPD_85_0)
CMD_85_1 := AUTH_85 AND (OVER_85 OR SPD_85_1)
CMD_85_2 := AUTH_85 AND NOT OVER_85 AND SPD_85_2
CMD_85_3 := AUTH_85 AND NOT OVER_85 AND SPD_85_3
CMD_85_4 := AUTH_85 AND (OVER_85 OR SPD_85_4)

// Limit 25 km/h: 6 m/s, 00110 (bit 4 first).
OVER_86  := SPD_86_4 OR SPD_86_3 OR (SPD_86_2 AND SPD_86_1 AND SPD_86_0)
CMD_86_0 := AUTH_86 AND NOT OVER_86 AND SPD_86_0
CMD_86_1 := AUTH_86 AND (OVER_86 OR SPD_86_1)
CMD_86_2 := AUTH_86 AND (OVER_86 OR SPD_86_2)
CMD_86_3 := AUTH_86 AND NOT OVER_86 AND SPD_86_3
CMD_86_4 := AUTH_86 AND NOT OVER_86 AND SPD_86_4
OVER_87  := SPD_87_4 OR SPD_87_3 OR (SPD_87_2 AND SPD_87_1 AND SPD_87_0)
CMD_87_0 := AUTH_87 AND NOT OVER_87 AND SPD_87_0
CMD_87_1 := AUTH_87 AND (OVER_87 OR SPD_87_1)
CMD_87_2 := AUTH_87 AND (OVER_87 OR SPD_87_2)
CMD_87_3 := AUTH_87 AND NOT OVER_87 AND SPD_87_3
CMD_87_4 := AUTH_87 AND NOT OVER_87 AND SPD_87_4
OVER_88  := SPD_88_4 OR SPD_88_3 OR (SPD_88_2 AND SPD_88_1 AND SPD_88_0)
CMD_88_0 := AUTH_88 AND NOT OVER_88 AND SPD_88_0
CMD_88_1 := AUTH_88 AND (OVER_88 OR SPD_88_1)
CMD_88_2 := AUTH_88 AND (OVER_88 OR SPD_88_2)
CMD_88_3 := AUTH_88 AND NOT OVER_88 AND SPD_88_3
CMD_88_4 := AUTH_88 AND NOT OVER_88 AND SPD_88_4

// Green line, wayside 3: blocks 74-88, sections M-O.
// Switch 76 joins 76-77 when normal and 77-101 when reversed.
// Switch 85 joins 85-86 when normal and 100-85 when reversed.
// Blocks 100 and 101 lie outside this wayside.
//
// The wayside runs this program and nothing else, so every protection
// is here. AUTH_n passes the CTC Office's speed and authority to the
// train in block n; 0 sends speed 0, authority 0.

VAR_IN  OCC_74..88
VAR_IN  CLOSED_74..88
VAR_IN  SWREV_76 CTCSW_76 CTCREV_76
VAR_IN  SWREV_85 CTCSW_85 CTCREV_85
VAR_OUT AUTH_74..88
VAR_OUT SW_76 SW_85
VAR_OUT SIG_76_R SIG_76_Y SIG_76_G SIG_76_SG
VAR_OUT SIG_85_R SIG_85_Y SIG_85_G SIG_85_SG

// Each switch obeys the CTC Office while it commands it (maintenance).
// Otherwise it routes around its normal leg while that leg is closed.
// A train on the points locks a switch where it reports: blocks 76 and
// 77 for switch 76, block 85 for switch 85.
WANT_76 := (CTCSW_76 AND CTCREV_76) OR (NOT CTCSW_76 AND CLOSED_76)
LOCK_76 := OCC_76 OR OCC_77
SW_76   := (LOCK_76 AND SWREV_76) OR (NOT LOCK_76 AND WANT_76)
WANT_85 := (CTCSW_85 AND CTCREV_85) OR (NOT CTCSW_85 AND CLOSED_86)
LOCK_85 := OCC_85
SW_85   := (LOCK_85 AND SWREV_85) OR (NOT LOCK_85 AND WANT_85)
// A switch that does not report where it is commanded is moving, or
// failed. Nothing may use the route over it: 76 and 77, or 85 and 86.
BAD_76  := SW_76 XOR SWREV_76
BAD_85  := SW_85 XOR SWREV_85

// Signal 76 shows the route into block 77. Exactly one aspect is lit
// for every input: red, else yellow, else green or super green.
BLOCKED_76 := OCC_77 OR CLOSED_77 OR BAD_76
CAUTION_76 := OCC_78 OR SWREV_76 OR CTCSW_76
SIG_76_R  := BLOCKED_76
SIG_76_Y  := NOT BLOCKED_76 AND CAUTION_76
SIG_76_G  := NOT BLOCKED_76 AND NOT CAUTION_76 AND OCC_79
SIG_76_SG := NOT BLOCKED_76 AND NOT CAUTION_76 AND NOT OCC_79

// Signal 85 shows the route out of block 85.
BLOCKED_85 := BAD_85 OR (NOT SWREV_85 AND (OCC_86 OR CLOSED_86))
CAUTION_85 := SWREV_85 OR OCC_87 OR CTCSW_85
SIG_85_R  := BLOCKED_85
SIG_85_Y  := NOT BLOCKED_85 AND CAUTION_85
SIG_85_G  := NOT BLOCKED_85 AND NOT CAUTION_85 AND OCC_88
SIG_85_SG := NOT BLOCKED_85 AND NOT CAUTION_85 AND NOT OCC_88

// A train keeps its authority while its own block is open and the
// blocks beside it, on the route the switches have set, are clear.
AUTH_74 := NOT (CLOSED_74 OR OCC_75)
AUTH_75 := NOT (CLOSED_75 OR OCC_74 OR OCC_76)
AUTH_76 := NOT (CLOSED_76 OR OCC_75 OR (NOT SWREV_76 AND OCC_77) OR BAD_76)
AUTH_77 := NOT (CLOSED_77 OR OCC_78 OR (NOT SWREV_76 AND OCC_76) OR BAD_76)
AUTH_78 := NOT (CLOSED_78 OR OCC_77 OR OCC_79)
AUTH_79 := NOT (CLOSED_79 OR OCC_78 OR OCC_80)
AUTH_80 := NOT (CLOSED_80 OR OCC_79 OR OCC_81)
AUTH_81 := NOT (CLOSED_81 OR OCC_80 OR OCC_82)
AUTH_82 := NOT (CLOSED_82 OR OCC_81 OR OCC_83)
AUTH_83 := NOT (CLOSED_83 OR OCC_82 OR OCC_84)
AUTH_84 := NOT (CLOSED_84 OR OCC_83 OR OCC_85)
AUTH_85 := NOT (CLOSED_85 OR OCC_84 OR (NOT SWREV_85 AND OCC_86) OR BAD_85)
AUTH_86 := NOT (CLOSED_86 OR OCC_87 OR (NOT SWREV_85 AND OCC_85) OR BAD_85)
AUTH_87 := NOT (CLOSED_87 OR OCC_86 OR OCC_88)
AUTH_88 := NOT (CLOSED_88 OR OCC_87)

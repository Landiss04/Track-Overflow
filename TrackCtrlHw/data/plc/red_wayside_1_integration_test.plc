// Red line, wayside Red-1: blocks 1..24, 73..76.
// Switches 9 (points 9: normal 8, reverse yard); 15 (points 16: normal 15, reverse 1).
// Crossings: 11.
// Neighbouring blocks read, never driven: 25, 27, 72.
//
// Braden Bosilovich, 2026-10-26. Replaces the Red integration test
// copies (Kevin, K4). After this program the wayside scans its
// read-only vital block, which can only restrict these outputs.

VAR_IN  OCC_1..25 OCC_27 OCC_72..76
VAR_IN  CLOSED_1..24 CLOSED_73..76
VAR_IN  SWREV_9 CTCSW_9 CTCREV_9 SWREV_15 CTCSW_15 CTCREV_15
VAR_IN  SPD_1_0..4 SPD_2_0..4 SPD_3_0..4 SPD_4_0..4 SPD_5_0..4 SPD_6_0..4
VAR_IN  SPD_7_0..4 SPD_8_0..4 SPD_9_0..4 SPD_10_0..4 SPD_11_0..4 SPD_12_0..4
VAR_IN  SPD_13_0..4 SPD_14_0..4 SPD_15_0..4 SPD_16_0..4 SPD_17_0..4 SPD_18_0..4
VAR_IN  SPD_19_0..4 SPD_20_0..4 SPD_21_0..4 SPD_22_0..4 SPD_23_0..4 SPD_24_0..4
VAR_IN  SPD_73_0..4 SPD_74_0..4 SPD_75_0..4 SPD_76_0..4
VAR_OUT AUTH_1..24 AUTH_73..76
VAR_OUT SW_9 SIG_9_R SIG_9_Y SIG_9_G SIG_9_SG
VAR_OUT SW_15 SIG_15_R SIG_15_Y SIG_15_G SIG_15_SG
VAR_OUT XING_11
VAR_OUT CMD_1_0..4 CMD_2_0..4 CMD_3_0..4 CMD_4_0..4 CMD_5_0..4 CMD_6_0..4
VAR_OUT CMD_7_0..4 CMD_8_0..4 CMD_9_0..4 CMD_10_0..4 CMD_11_0..4 CMD_12_0..4
VAR_OUT CMD_13_0..4 CMD_14_0..4 CMD_15_0..4 CMD_16_0..4 CMD_17_0..4 CMD_18_0..4
VAR_OUT CMD_19_0..4 CMD_20_0..4 CMD_21_0..4 CMD_22_0..4 CMD_23_0..4 CMD_24_0..4
VAR_OUT CMD_73_0..4 CMD_74_0..4 CMD_75_0..4 CMD_76_0..4

// Switch 9: points at 9, normal leg to 8, reverse leg to yard.
// The yard leg is the CTC Office's to choose (maintenance); the
// program never routes into the yard on its own.
AUTO_9 := 0
// The CTC Office's command wins while it sends one (maintenance).
WANT_9 := (CTCSW_9 AND CTCREV_9) OR (NOT CTCSW_9 AND AUTO_9)
// A train on 9 locks it where it reports.
LOCK_9 := OCC_9
SW_9 := (LOCK_9 AND SWREV_9) OR (NOT LOCK_9 AND WANT_9)
// Commanded but not reported: moving or failed. Nothing uses its route.
BAD_9 := SW_9 XOR SWREV_9

// Switch 15: points at 16, normal leg to 15, reverse leg to 1.
// Reverse for a train waiting on 1, or when 15 is closed; never
// into a train on 15 or a closed 1.
AUTO_15 := (OCC_1 OR CLOSED_15) AND NOT OCC_15 AND NOT CLOSED_1
// The CTC Office's command wins while it sends one (maintenance).
WANT_15 := (CTCSW_15 AND CTCREV_15) OR (NOT CTCSW_15 AND AUTO_15)
// A train on 15 or 16 locks it where it reports.
LOCK_15 := OCC_15 OR OCC_16
SW_15 := (LOCK_15 AND SWREV_15) OR (NOT LOCK_15 AND WANT_15)
// Commanded but not reported: moving or failed. Nothing uses its route.
BAD_15 := SW_15 XOR SWREV_15

// Signal 9 guards the points at 9: red over a busy or closed route,
// yellow on the diverging route, in maintenance or with 7 busy, green
// with a train on 6, else super green. Exactly one is lit.
BLOCKED_9 := OCC_9 OR CLOSED_9 OR BAD_9 OR (NOT SWREV_9 AND (OCC_8 OR CLOSED_8))
CAUTION_9 := SWREV_9 OR CTCSW_9 OR OCC_7 OR CLOSED_7
SIG_9_R := BLOCKED_9
SIG_9_Y := NOT BLOCKED_9 AND CAUTION_9
SIG_9_G := NOT BLOCKED_9 AND NOT CAUTION_9 AND OCC_6
SIG_9_SG := NOT BLOCKED_9 AND NOT CAUTION_9 AND NOT OCC_6

// Signal 15 guards the points at 16: red over a busy or closed route,
// yellow on the diverging route, in maintenance or with 14 busy, green
// with a train on 13, else super green. Exactly one is lit.
BLOCKED_15 := OCC_16 OR CLOSED_16 OR BAD_15 OR (NOT SWREV_15 AND (OCC_15 OR CLOSED_15)) OR (SWREV_15 AND (OCC_1 OR CLOSED_1))
CAUTION_15 := SWREV_15 OR CTCSW_15 OR OCC_14 OR CLOSED_14
SIG_15_R := BLOCKED_15
SIG_15_Y := NOT BLOCKED_15 AND CAUTION_15
SIG_15_G := NOT BLOCKED_15 AND NOT CAUTION_15 AND OCC_13
SIG_15_SG := NOT BLOCKED_15 AND NOT CAUTION_15 AND NOT OCC_13

// Crossing 11: lights and gates for a train on 10, 11, 12.
XING_11 := OCC_10 OR OCC_11 OR OCC_12

// A train keeps its authority while its block is open, no switch
// on its route is moving, and every block it could move into is
// clear. At points only the leg the switch reports set counts; a
// train on a leg is held by a train on the points either way.
AUTH_1 := NOT (CLOSED_1 OR (OCC_1 AND (OCC_2 OR OCC_16)) OR BAD_15)
AUTH_2 := NOT (CLOSED_2 OR (OCC_2 AND (OCC_1 OR OCC_3)))
AUTH_3 := NOT (CLOSED_3 OR (OCC_3 AND (OCC_2 OR OCC_4)))
AUTH_4 := NOT (CLOSED_4 OR (OCC_4 AND (OCC_3 OR OCC_5)))
AUTH_5 := NOT (CLOSED_5 OR (OCC_5 AND (OCC_4 OR OCC_6)))
AUTH_6 := NOT (CLOSED_6 OR (OCC_6 AND (OCC_5 OR OCC_7)))
AUTH_7 := NOT (CLOSED_7 OR (OCC_7 AND (OCC_6 OR OCC_8)))
AUTH_8 := NOT (CLOSED_8 OR (OCC_8 AND (OCC_7 OR OCC_9)) OR BAD_9)
AUTH_9 := NOT (CLOSED_9 OR (OCC_9 AND ((NOT SWREV_9 AND OCC_8) OR OCC_10)) OR BAD_9)
AUTH_10 := NOT (CLOSED_10 OR (OCC_10 AND (OCC_9 OR OCC_11)))
AUTH_11 := NOT (CLOSED_11 OR (OCC_11 AND (OCC_10 OR OCC_12)))
AUTH_12 := NOT (CLOSED_12 OR (OCC_12 AND (OCC_11 OR OCC_13)))
AUTH_13 := NOT (CLOSED_13 OR (OCC_13 AND (OCC_12 OR OCC_14)))
AUTH_14 := NOT (CLOSED_14 OR (OCC_14 AND (OCC_13 OR OCC_15)))
AUTH_15 := NOT (CLOSED_15 OR (OCC_15 AND (OCC_14 OR OCC_16)) OR BAD_15)
AUTH_16 := NOT (CLOSED_16 OR (OCC_16 AND ((SWREV_15 AND OCC_1) OR (NOT SWREV_15 AND OCC_15) OR OCC_17)) OR BAD_15)
AUTH_17 := NOT (CLOSED_17 OR (OCC_17 AND (OCC_16 OR OCC_18)))
AUTH_18 := NOT (CLOSED_18 OR (OCC_18 AND (OCC_17 OR OCC_19)))
AUTH_19 := NOT (CLOSED_19 OR (OCC_19 AND (OCC_18 OR OCC_20)))
AUTH_20 := NOT (CLOSED_20 OR (OCC_20 AND (OCC_19 OR OCC_21)))
AUTH_21 := NOT (CLOSED_21 OR (OCC_21 AND (OCC_20 OR OCC_22)))
AUTH_22 := NOT (CLOSED_22 OR (OCC_22 AND (OCC_21 OR OCC_23)))
AUTH_23 := NOT (CLOSED_23 OR (OCC_23 AND (OCC_22 OR OCC_24)))
AUTH_24 := NOT (CLOSED_24 OR (OCC_24 AND (OCC_23 OR OCC_25)))
AUTH_73 := NOT (CLOSED_73 OR (OCC_73 AND (OCC_72 OR OCC_74)))
AUTH_74 := NOT (CLOSED_74 OR (OCC_74 AND (OCC_73 OR OCC_75)))
AUTH_75 := NOT (CLOSED_75 OR (OCC_75 AND (OCC_74 OR OCC_76)))
AUTH_76 := NOT (CLOSED_76 OR (OCC_76 AND (OCC_27 OR OCC_75)))

// Speed: the CTC Office's suggestion, only with authority. The
// wayside's vital block caps it at each block's limit.
CMD_1_0 := AUTH_1 AND SPD_1_0
CMD_1_1 := AUTH_1 AND SPD_1_1
CMD_1_2 := AUTH_1 AND SPD_1_2
CMD_1_3 := AUTH_1 AND SPD_1_3
CMD_1_4 := AUTH_1 AND SPD_1_4
CMD_2_0 := AUTH_2 AND SPD_2_0
CMD_2_1 := AUTH_2 AND SPD_2_1
CMD_2_2 := AUTH_2 AND SPD_2_2
CMD_2_3 := AUTH_2 AND SPD_2_3
CMD_2_4 := AUTH_2 AND SPD_2_4
CMD_3_0 := AUTH_3 AND SPD_3_0
CMD_3_1 := AUTH_3 AND SPD_3_1
CMD_3_2 := AUTH_3 AND SPD_3_2
CMD_3_3 := AUTH_3 AND SPD_3_3
CMD_3_4 := AUTH_3 AND SPD_3_4
CMD_4_0 := AUTH_4 AND SPD_4_0
CMD_4_1 := AUTH_4 AND SPD_4_1
CMD_4_2 := AUTH_4 AND SPD_4_2
CMD_4_3 := AUTH_4 AND SPD_4_3
CMD_4_4 := AUTH_4 AND SPD_4_4
CMD_5_0 := AUTH_5 AND SPD_5_0
CMD_5_1 := AUTH_5 AND SPD_5_1
CMD_5_2 := AUTH_5 AND SPD_5_2

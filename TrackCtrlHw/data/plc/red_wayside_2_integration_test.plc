// Red line, wayside Red-2: blocks 25..45, 67..72.
// Switches 27 (points 27: normal 28, reverse 76); 32 (points 33: normal 32, reverse 72); 38 (points 38: normal 39, reverse 71); 43 (points 44: normal 43, reverse 67).
// Crossings: none.
// Neighbouring blocks read, never driven: 24, 46, 73, 76.
//
// Braden Bosilovich, 2026-10-26. Replaces the Red integration test
// copies (Kevin, K4). After this program the wayside scans its
// read-only vital block, which can only restrict these outputs.

VAR_IN  OCC_24..46 OCC_67..73 OCC_76
VAR_IN  CLOSED_25..45 CLOSED_67..72 CLOSED_76
VAR_IN  SWREV_27 CTCSW_27 CTCREV_27 SWREV_32 CTCSW_32 CTCREV_32
VAR_IN  SWREV_38 CTCSW_38 CTCREV_38 SWREV_43 CTCSW_43 CTCREV_43
VAR_IN  SPD_25_0..4 SPD_26_0..4 SPD_27_0..4 SPD_28_0..4 SPD_29_0..4 SPD_30_0..4
VAR_IN  SPD_31_0..4 SPD_32_0..4 SPD_33_0..4 SPD_34_0..4 SPD_35_0..4 SPD_36_0..4
VAR_IN  SPD_37_0..4 SPD_38_0..4 SPD_39_0..4 SPD_40_0..4 SPD_41_0..4 SPD_42_0..4
VAR_IN  SPD_43_0..4 SPD_44_0..4 SPD_45_0..4 SPD_67_0..4 SPD_68_0..4 SPD_69_0..4
VAR_IN  SPD_70_0..4 SPD_71_0..4 SPD_72_0..4
VAR_OUT AUTH_25..45 AUTH_67..72
VAR_OUT SW_27 SIG_27_R SIG_27_Y SIG_27_G SIG_27_SG
VAR_OUT SW_32 SIG_32_R SIG_32_Y SIG_32_G SIG_32_SG
VAR_OUT SW_38 SIG_38_R SIG_38_Y SIG_38_G SIG_38_SG
VAR_OUT SW_43 SIG_43_R SIG_43_Y SIG_43_G SIG_43_SG
VAR_OUT CMD_25_0..4 CMD_26_0..4 CMD_27_0..4 CMD_28_0..4 CMD_29_0..4 CMD_30_0..4
VAR_OUT CMD_31_0..4 CMD_32_0..4 CMD_33_0..4 CMD_34_0..4 CMD_35_0..4 CMD_36_0..4
VAR_OUT CMD_37_0..4 CMD_38_0..4 CMD_39_0..4 CMD_40_0..4 CMD_41_0..4 CMD_42_0..4
VAR_OUT CMD_43_0..4 CMD_44_0..4 CMD_45_0..4 CMD_67_0..4 CMD_68_0..4 CMD_69_0..4
VAR_OUT CMD_70_0..4 CMD_71_0..4 CMD_72_0..4

// Switch 27: points at 27, normal leg to 28, reverse leg to 76.
// Reverse for a train waiting on 76, or when 28 is closed; never
// into a train on 28 or a closed 76.
AUTO_27 := (OCC_76 OR CLOSED_28) AND NOT OCC_28 AND NOT CLOSED_76
// The CTC Office's command wins while it sends one (maintenance).
WANT_27 := (CTCSW_27 AND CTCREV_27) OR (NOT CTCSW_27 AND AUTO_27)
// A train on 27 locks it where it reports.
LOCK_27 := OCC_27
SW_27 := (LOCK_27 AND SWREV_27) OR (NOT LOCK_27 AND WANT_27)
// Commanded but not reported: moving or failed. Nothing uses its route.
BAD_27 := SW_27 XOR SWREV_27

// Switch 32: points at 33, normal leg to 32, reverse leg to 72.
// Reverse for a train waiting on 72, or when 32 is closed; never
// into a train on 32 or a closed 72.
AUTO_32 := (OCC_72 OR CLOSED_32) AND NOT OCC_32 AND NOT CLOSED_72
// The CTC Office's command wins while it sends one (maintenance).
WANT_32 := (CTCSW_32 AND CTCREV_32) OR (NOT CTCSW_32 AND AUTO_32)
// A train on 32 or 33 locks it where it reports.
LOCK_32 := OCC_32 OR OCC_33
SW_32 := (LOCK_32 AND SWREV_32) OR (NOT LOCK_32 AND WANT_32)
// Commanded but not reported: moving or failed. Nothing uses its route.
BAD_32 := SW_32 XOR SWREV_32

// Switch 38: points at 38, normal leg to 39, reverse leg to 71.
// Reverse for a train waiting on 71, or when 39 is closed; never
// into a train on 39 or a closed 71.
AUTO_38 := (OCC_71 OR CLOSED_39) AND NOT OCC_39 AND NOT CLOSED_71
// The CTC Office's command wins while it sends one (maintenance).
WANT_38 := (CTCSW_38 AND CTCREV_38) OR (NOT CTCSW_38 AND AUTO_38)
// A train on 38 locks it where it reports.
LOCK_38 := OCC_38
SW_38 := (LOCK_38 AND SWREV_38) OR (NOT LOCK_38 AND WANT_38)
// Commanded but not reported: moving or failed. Nothing uses its route.
BAD_38 := SW_38 XOR SWREV_38

// Switch 43: points at 44, normal leg to 43, reverse leg to 67.
// Reverse for a train waiting on 67, or when 43 is closed; never
// into a train on 43 or a closed 67.
AUTO_43 := (OCC_67 OR CLOSED_43) AND NOT OCC_43 AND NOT CLOSED_67
// The CTC Office's command wins while it sends one (maintenance).
WANT_43 := (CTCSW_43 AND CTCREV_43) OR (NOT CTCSW_43 AND AUTO_43)
// A train on 43 or 44 locks it where it reports.
LOCK_43 := OCC_43 OR OCC_44
SW_43 := (LOCK_43 AND SWREV_43) OR (NOT LOCK_43 AND WANT_43)
// Commanded but not reported: moving or failed. Nothing uses its route.
BAD_43 := SW_43 XOR SWREV_43

// Signal 27 guards the points at 27: red over a busy or closed route,
// yellow on the diverging route, in maintenance or with 29 busy, green
// with a train on 30, else super green. Exactly one is lit.
BLOCKED_27 := OCC_27 OR CLOSED_27 OR BAD_27 OR (NOT SWREV_27 AND (OCC_28 OR CLOSED_28)) OR (SWREV_27 AND (OCC_76 OR CLOSED_76))
CAUTION_27 := SWREV_27 OR CTCSW_27 OR OCC_29 OR CLOSED_29
SIG_27_R := BLOCKED_27
SIG_27_Y := NOT BLOCKED_27 AND CAUTION_27
SIG_27_G := NOT BLOCKED_27 AND NOT CAUTION_27 AND OCC_30
SIG_27_SG := NOT BLOCKED_27 AND NOT CAUTION_27 AND NOT OCC_30

// Signal 32 guards the points at 33: red over a busy or closed route,
// yellow on the diverging route, in maintenance or with 31 busy, green
// with a train on 30, else super green. Exactly one is lit.
BLOCKED_32 := OCC_33 OR CLOSED_33 OR BAD_32 OR (NOT SWREV_32 AND (OCC_32 OR CLOSED_32)) OR (SWREV_32 AND (OCC_72 OR CLOSED_72))
CAUTION_32 := SWREV_32 OR CTCSW_32 OR OCC_31 OR CLOSED_31
SIG_32_R := BLOCKED_32
SIG_32_Y := NOT BLOCKED_32 AND CAUTION_32
SIG_32_G := NOT BLOCKED_32 AND NOT CAUTION_32 AND OCC_30
SIG_32_SG := NOT BLOCKED_32 AND NOT CAUTION_32 AND NOT OCC_30

// Signal 38 guards the points at 38: red over a busy or closed route,
// yellow on the diverging route, in maintenance or with 40 busy, green
// with a train on 41, else super green. Exactly one is lit.
BLOCKED_38 := OCC_38 OR CLOSED_38 OR BAD_38 OR (NOT SWREV_38 AND (OCC_39 OR CLOSED_39)) OR (SWREV_38 AND (OCC_71 OR CLOSED_71))
CAUTION_38 := SWREV_38 OR CTCSW_38 OR OCC_40 OR CLOSED_40
SIG_38_R := BLOCKED_38
SIG_38_Y := NOT BLOCKED_38 AND CAUTION_38
SIG_38_G := NOT BLOCKED_38 AND NOT CAUTION_38 AND OCC_41
SIG_38_SG := NOT BLOCKED_38 AND NOT CAUTION_38 AND NOT OCC_41

// Signal 43 guards the points at 44: red over a busy or closed route,
// yellow on the diverging route, in maintenance or with 42 busy, green
// with a train on 41, else super green. Exactly one is lit.
BLOCKED_43 := OCC_44 OR CLOSED_44 OR BAD_43 OR (NOT SWREV_43 AND (OCC_43 OR CLOSED_43)) OR (SWREV_43 AND (OCC_67 OR CLOSED_67))
CAUTION_43 := SWREV_43 OR CTCSW_43 OR OCC_42 OR CLOSED_42
SIG_43_R := BLOCKED_43
SIG_43_Y := NOT BLOCKED_43 AND CAUTION_43
SIG_43_G := NOT BLOCKED_43 AND NOT CAUTION_43 AND OCC_41
SIG_43_SG := NOT BLOCKED_43 AND NOT CAUTION_43 AND NOT OCC_41

// A train keeps its authority while its block is open, no switch
// on its route is moving, and every block it could move into is
// clear. At points only the leg the switch reports set counts; a
// train on a leg is held by a train on the points either way.
AUTH_25 := NOT (CLOSED_25 OR (OCC_25 AND (OCC_24 OR OCC_26)))
AUTH_26 := NOT (CLOSED_26 OR (OCC_26 AND (OCC_25 OR OCC_27)))
AUTH_27 := NOT (CLOSED_27 OR (OCC_27 AND (OCC_26 OR (NOT SWREV_27 AND OCC_28) OR (SWREV_27 AND OCC_76))) OR BAD_27)
AUTH_28 := NOT (CLOSED_28 OR (OCC_28 AND (OCC_27 OR OCC_29)) OR BAD_27)
AUTH_29 := NOT (CLOSED_29 OR (OCC_29 AND (OCC_28 OR OCC_30)))
AUTH_30 := NOT (CLOSED_30 OR (OCC_30 AND (OCC_29 OR OCC_31)))
AUTH_31 := NOT (CLOSED_31 OR (OCC_31 AND (OCC_30 OR OCC_32)))
AUTH_32 := NOT (CLOSED_32 OR (OCC_32 AND (OCC_31 OR OCC_33)) OR BAD_32)
AUTH_33 := NOT (CLOSED_33 OR (OCC_33 AND ((NOT SWREV_32 AND OCC_32) OR OCC_34 OR (SWREV_32 AND OCC_72))) OR BAD_32)
AUTH_34 := NOT (CLOSED_34 OR (OCC_34 AND (OCC_33 OR OCC_35)))
AUTH_35 := NOT (CLOSED_35 OR (OCC_35 AND (OCC_34 OR OCC_36)))
AUTH_36 := NOT (CLOSED_36 OR (OCC_36 AND (OCC_35 OR OCC_37)))
AUTH_37 := NOT (CLOSED_37 OR (OCC_37 AND (OCC_36 OR OCC_38)))
AUTH_38 := NOT (CLOSED_38 OR (OCC_38 AND (OCC_37 OR (NOT SWREV_38 AND OCC_39) OR (SWREV_38 AND OCC_71))) OR BAD_38)
AUTH_39 := NOT (CLOSED_39 OR (OCC_39 AND (OCC_38 OR OCC_40)) OR BAD_38)
AUTH_40 := NOT (CLOSED_40 OR (OCC_40 AND (OCC_39 OR OCC_41)))
AUTH_41 := NOT (CLOSED_41 OR (OCC_41 AND (OCC_40 OR OCC_42)))
AUTH_42 := NOT (CLOSED_42 OR (OCC_42 AND (OCC_41 OR OCC_43)))
AUTH_43 := NOT (CLOSED_43 OR (OCC_43 AND (OCC_42 OR OCC_44)) OR BAD_43)
AUTH_44 := NOT (CLOSED_44 OR (OCC_44 AND ((NOT SWREV_43 AND OCC_43) OR OCC_45 OR (SWREV_43 AND OCC_67))) OR BAD_43)
AUTH_45 := NOT (CLOSED_45 OR (OCC_45 AND (OCC_44 OR OCC_46)))
AUTH_67 := NOT (CLOSED_67 OR (OCC_67 AND (OCC_44 OR OCC_68)) OR BAD_43)
AUTH_68 := NOT (CLOSED_68 OR (OCC_68 AND (OCC_67 OR OCC_69)))
AUTH_69 := NOT (CLOSED_69 OR (OCC_69 AND (OCC_68 OR OCC_70)))
AUTH_70 := NOT (CLOSED_70 OR (OCC_70 AND (OCC_69 OR OCC_71)))
AUTH_71 := NOT (CLOSED_71 OR (OCC_71 AND (OCC_38 OR OCC_70)) OR BAD_38)
AUTH_72 := NOT (CLOSED_72 OR (OCC_72 AND (OCC_33 OR OCC_73)) OR BAD_32)

// Speed: the CTC Office's suggestion, only with authority. The
// wayside's vital block caps it at each block's limit.
CMD_25_0 := AUTH_25 AND SPD_25_0
CMD_25_1 := AUTH_25 AND SPD_25_1
CMD_25_2 := AUTH_25 AND SPD_25_2
CMD_25_3 := AUTH_25 AND SPD_25_3
CMD_25_4 := AUTH_25 AND SPD_25_4
CMD_26_0 := AUTH_26 AND SPD_26_0
CMD_26_1 := AUTH_26 AND SPD_26_1
CMD_26_2 := AUTH_26 AND SPD_26_2
CMD_26_3 := AUTH_26 AND SPD_26_3
CMD_26_4 := AUTH_26 AND SPD_26_4
CMD_27_0 := AUTH_27 AND SPD_27_0
CMD_27_1 := AUTH_27 AND SPD_27_1
CMD_27_2 := AUTH_27 AND SPD_27_2

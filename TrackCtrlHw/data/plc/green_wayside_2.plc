// Green line, wayside 2: blocks 21-35, sections F-H.
// Switch 28 joins 28-29 when normal and 150-28 when reversed. Block 150
// lies outside this wayside. The signal shows the route out of 28.
//
// The wayside runs this program and nothing else, so every protection
// is here. AUTH_n passes the CTC Office's authority to the train in
// block n; 0 sends authority 0. The CTC Office's speed for block n
// arrives as five bits, SPD_n_0 (1 m/s) to SPD_n_4 (16 m/s), and goes
// out as CMD_n_0..4, capped at the block's limit.

VAR_IN  OCC_21..35
VAR_IN  CLOSED_21..35
VAR_IN  SWREV_28 CTCSW_28 CTCREV_28
VAR_IN  SPD_21_0..4 SPD_22_0..4 SPD_23_0..4 SPD_24_0..4 SPD_25_0..4
VAR_IN  SPD_26_0..4 SPD_27_0..4 SPD_28_0..4 SPD_29_0..4 SPD_30_0..4
VAR_IN  SPD_31_0..4 SPD_32_0..4 SPD_33_0..4 SPD_34_0..4 SPD_35_0..4
VAR_OUT AUTH_21..35
VAR_OUT SW_28
VAR_OUT SIG_28_R SIG_28_Y SIG_28_G SIG_28_SG
VAR_OUT CMD_21_0..4 CMD_22_0..4 CMD_23_0..4 CMD_24_0..4 CMD_25_0..4
VAR_OUT CMD_26_0..4 CMD_27_0..4 CMD_28_0..4 CMD_29_0..4 CMD_30_0..4
VAR_OUT CMD_31_0..4 CMD_32_0..4 CMD_33_0..4 CMD_34_0..4 CMD_35_0..4

// Switch 28: while the CTC Office commands it (maintenance), obey.
// Otherwise route around block 29 while it is closed. A train on the
// points (block 28) locks the switch where it reports.
WANT_28 := (CTCSW_28 AND CTCREV_28) OR (NOT CTCSW_28 AND CLOSED_29)
LOCK_28 := OCC_28
SW_28   := (LOCK_28 AND SWREV_28) OR (NOT LOCK_28 AND WANT_28)
// The switch does not report where it is commanded: moving, or failed.
// Nothing may use the route over it (blocks 28 and 29).
BAD_28  := SW_28 XOR SWREV_28

// Signal 28: red while the main route into 29 is blocked; caution on
// the diverging route, which leaves this wayside. Exactly one aspect
// is lit for every input.
BLOCKED := BAD_28 OR (NOT SWREV_28 AND (OCC_29 OR CLOSED_29))
CAUTION := SWREV_28 OR OCC_30 OR CTCSW_28
SIG_28_R  := BLOCKED
SIG_28_Y  := NOT BLOCKED AND CAUTION
SIG_28_G  := NOT BLOCKED AND NOT CAUTION AND OCC_31
SIG_28_SG := NOT BLOCKED AND NOT CAUTION AND NOT OCC_31

// A train keeps its authority while its own block is open and the
// blocks beside it, on the route the switch has set, are clear.
AUTH_21 := NOT (CLOSED_21 OR OCC_22)
AUTH_22 := NOT (CLOSED_22 OR OCC_21 OR OCC_23)
AUTH_23 := NOT (CLOSED_23 OR OCC_22 OR OCC_24)
AUTH_24 := NOT (CLOSED_24 OR OCC_23 OR OCC_25)
AUTH_25 := NOT (CLOSED_25 OR OCC_24 OR OCC_26)
AUTH_26 := NOT (CLOSED_26 OR OCC_25 OR OCC_27)
AUTH_27 := NOT (CLOSED_27 OR OCC_26 OR OCC_28)
AUTH_28 := NOT (CLOSED_28 OR OCC_27 OR (NOT SWREV_28 AND OCC_29) OR BAD_28)
AUTH_29 := NOT (CLOSED_29 OR OCC_30 OR (NOT SWREV_28 AND OCC_28) OR BAD_28)
AUTH_30 := NOT (CLOSED_30 OR OCC_29 OR OCC_31)
AUTH_31 := NOT (CLOSED_31 OR OCC_30 OR OCC_32)
AUTH_32 := NOT (CLOSED_32 OR OCC_31 OR OCC_33)
AUTH_33 := NOT (CLOSED_33 OR OCC_32 OR OCC_34)
AUTH_34 := NOT (CLOSED_34 OR OCC_33 OR OCC_35)
AUTH_35 := NOT (CLOSED_35 OR OCC_34)

// Speed. OVER_n is 1 when the CTC Office's speed for block n is above
// the block's limit, rounded down to whole m/s; then the limit's own
// bits go out instead. Nothing goes out without AUTH_n.

// Limit 70 km/h: 19 m/s, 10011 (bit 4 first).
OVER_21  := SPD_21_4 AND (SPD_21_3 OR SPD_21_2)
CMD_21_0 := AUTH_21 AND (OVER_21 OR SPD_21_0)
CMD_21_1 := AUTH_21 AND (OVER_21 OR SPD_21_1)
CMD_21_2 := AUTH_21 AND NOT OVER_21 AND SPD_21_2
CMD_21_3 := AUTH_21 AND NOT OVER_21 AND SPD_21_3
CMD_21_4 := AUTH_21 AND (OVER_21 OR SPD_21_4)
OVER_22  := SPD_22_4 AND (SPD_22_3 OR SPD_22_2)
CMD_22_0 := AUTH_22 AND (OVER_22 OR SPD_22_0)
CMD_22_1 := AUTH_22 AND (OVER_22 OR SPD_22_1)
CMD_22_2 := AUTH_22 AND NOT OVER_22 AND SPD_22_2
CMD_22_3 := AUTH_22 AND NOT OVER_22 AND SPD_22_3
CMD_22_4 := AUTH_22 AND (OVER_22 OR SPD_22_4)
OVER_23  := SPD_23_4 AND (SPD_23_3 OR SPD_23_2)
CMD_23_0 := AUTH_23 AND (OVER_23 OR SPD_23_0)
CMD_23_1 := AUTH_23 AND (OVER_23 OR SPD_23_1)
CMD_23_2 := AUTH_23 AND NOT OVER_23 AND SPD_23_2
CMD_23_3 := AUTH_23 AND NOT OVER_23 AND SPD_23_3
CMD_23_4 := AUTH_23 AND (OVER_23 OR SPD_23_4)
OVER_24  := SPD_24_4 AND (SPD_24_3 OR SPD_24_2)
CMD_24_0 := AUTH_24 AND (OVER_24 OR SPD_24_0)
CMD_24_1 := AUTH_24 AND (OVER_24 OR SPD_24_1)
CMD_24_2 := AUTH_24 AND NOT OVER_24 AND SPD_24_2
CMD_24_3 := AUTH_24 AND NOT OVER_24 AND SPD_24_3
CMD_24_4 := AUTH_24 AND (OVER_24 OR SPD_24_4)
OVER_25  := SPD_25_4 AND (SPD_25_3 OR SPD_25_2)
CMD_25_0 := AUTH_25 AND (OVER_25 OR SPD_25_0)
CMD_25_1 := AUTH_25 AND (OVER_25 OR SPD_25_1)
CMD_25_2 := AUTH_25 AND NOT OVER_25 AND SPD_25_2
CMD_25_3 := AUTH_25 AND NOT OVER_25 AND SPD_25_3
CMD_25_4 := AUTH_25 AND (OVER_25 OR SPD_25_4)
OVER_26  := SPD_26_4 AND (SPD_26_3 OR SPD_26_2)
CMD_26_0 := AUTH_26 AND (OVER_26 OR SPD_26_0)
CMD_26_1 := AUTH_26 AND (OVER_26 OR SPD_26_1)
CMD_26_2 := AUTH_26 AND NOT OVER_26 AND SPD_26_2
CMD_26_3 := AUTH_26 AND NOT OVER_26 AND SPD_26_3
CMD_26_4 := AUTH_26 AND (OVER_26 OR SPD_26_4)

// Limit 30 km/h: 8 m/s, 01000 (bit 4 first).
OVER_27  := SPD_27_4 OR (SPD_27_3 AND (SPD_27_2 OR SPD_27_1 OR SPD_27_0))
CMD_27_0 := AUTH_27 AND NOT OVER_27 AND SPD_27_0
CMD_27_1 := AUTH_27 AND NOT OVER_27 AND SPD_27_1
CMD_27_2 := AUTH_27 AND NOT OVER_27 AND SPD_27_2
CMD_27_3 := AUTH_27 AND (OVER_27 OR SPD_27_3)
CMD_27_4 := AUTH_27 AND NOT OVER_27 AND SPD_27_4
OVER_28  := SPD_28_4 OR (SPD_28_3 AND (SPD_28_2 OR SPD_28_1 OR SPD_28_0))
CMD_28_0 := AUTH_28 AND NOT OVER_28 AND SPD_28_0
CMD_28_1 := AUTH_28 AND NOT OVER_28 AND SPD_28_1
CMD_28_2 := AUTH_28 AND NOT OVER_28 AND SPD_28_2
CMD_28_3 := AUTH_28 AND (OVER_28 OR SPD_28_3)
CMD_28_4 := AUTH_28 AND NOT OVER_28 AND SPD_28_4
OVER_29  := SPD_29_4 OR (SPD_29_3 AND (SPD_29_2 OR SPD_29_1 OR SPD_29_0))
CMD_29_0 := AUTH_29 AND NOT OVER_29 AND SPD_29_0
CMD_29_1 := AUTH_29 AND NOT OVER_29 AND SPD_29_1
CMD_29_2 := AUTH_29 AND NOT OVER_29 AND SPD_29_2
CMD_29_3 := AUTH_29 AND (OVER_29 OR SPD_29_3)
CMD_29_4 := AUTH_29 AND NOT OVER_29 AND SPD_29_4
OVER_30  := SPD_30_4 OR (SPD_30_3 AND (SPD_30_2 OR SPD_30_1 OR SPD_30_0))
CMD_30_0 := AUTH_30 AND NOT OVER_30 AND SPD_30_0
CMD_30_1 := AUTH_30 AND NOT OVER_30 AND SPD_30_1
CMD_30_2 := AUTH_30 AND NOT OVER_30 AND SPD_30_2
CMD_30_3 := AUTH_30 AND (OVER_30 OR SPD_30_3)
CMD_30_4 := AUTH_30 AND NOT OVER_30 AND SPD_30_4
OVER_31  := SPD_31_4 OR (SPD_31_3 AND (SPD_31_2 OR SPD_31_1 OR SPD_31_0))
CMD_31_0 := AUTH_31 AND NOT OVER_31 AND SPD_31_0
CMD_31_1 := AUTH_31 AND NOT OVER_31 AND SPD_31_1
CMD_31_2 := AUTH_31 AND NOT OVER_31 AND SPD_31_2
CMD_31_3 := AUTH_31 AND (OVER_31 OR SPD_31_3)
CMD_31_4 := AUTH_31 AND NOT OVER_31 AND SPD_31_4
OVER_32  := SPD_32_4 OR (SPD_32_3 AND (SPD_32_2 OR SPD_32_1 OR SPD_32_0))
CMD_32_0 := AUTH_32 AND NOT OVER_32 AND SPD_32_0
CMD_32_1 := AUTH_32 AND NOT OVER_32 AND SPD_32_1
CMD_32_2 := AUTH_32 AND NOT OVER_32 AND SPD_32_2
CMD_32_3 := AUTH_32 AND (OVER_32 OR SPD_32_3)
CMD_32_4 := AUTH_32 AND NOT OVER_32 AND SPD_32_4
OVER_33  := SPD_33_4 OR (SPD_33_3 AND (SPD_33_2 OR SPD_33_1 OR SPD_33_0))
CMD_33_0 := AUTH_33 AND NOT OVER_33 AND SPD_33_0
CMD_33_1 := AUTH_33 AND NOT OVER_33 AND SPD_33_1
CMD_33_2 := AUTH_33 AND NOT OVER_33 AND SPD_33_2
CMD_33_3 := AUTH_33 AND (OVER_33 OR SPD_33_3)
CMD_33_4 := AUTH_33 AND NOT OVER_33 AND SPD_33_4
OVER_34  := SPD_34_4 OR (SPD_34_3 AND (SPD_34_2 OR SPD_34_1 OR SPD_34_0))
CMD_34_0 := AUTH_34 AND NOT OVER_34 AND SPD_34_0
CMD_34_1 := AUTH_34 AND NOT OVER_34 AND SPD_34_1
CMD_34_2 := AUTH_34 AND NOT OVER_34 AND SPD_34_2
CMD_34_3 := AUTH_34 AND (OVER_34 OR SPD_34_3)
CMD_34_4 := AUTH_34 AND NOT OVER_34 AND SPD_34_4
OVER_35  := SPD_35_4 OR (SPD_35_3 AND (SPD_35_2 OR SPD_35_1 OR SPD_35_0))
CMD_35_0 := AUTH_35 AND NOT OVER_35 AND SPD_35_0
CMD_35_1 := AUTH_35 AND NOT OVER_35 AND SPD_35_1
CMD_35_2 := AUTH_35 AND NOT OVER_35 AND SPD_35_2
CMD_35_3 := AUTH_35 AND (OVER_35 OR SPD_35_3)
CMD_35_4 := AUTH_35 AND NOT OVER_35 AND SPD_35_4

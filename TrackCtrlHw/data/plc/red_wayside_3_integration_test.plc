// Red line, wayside Red-3: blocks 46..66.
// Switches 52 (points 52: normal 53, reverse 66).
// Crossings: 47.
// Neighbouring blocks read, never driven: 45.
//
// Braden Bosilovich, 2026-10-26. Replaces the Red integration test
// copies (Kevin, K4). After this program the wayside scans its
// read-only vital block, which can only restrict these outputs.

VAR_IN  OCC_45..66
VAR_IN  CLOSED_46..66
VAR_IN  SWREV_52 CTCSW_52 CTCREV_52
VAR_IN  SPD_46_0..4 SPD_47_0..4 SPD_48_0..4 SPD_49_0..4 SPD_50_0..4 SPD_51_0..4
VAR_IN  SPD_52_0..4 SPD_53_0..4 SPD_54_0..4 SPD_55_0..4 SPD_56_0..4 SPD_57_0..4
VAR_IN  SPD_58_0..4 SPD_59_0..4 SPD_60_0..4 SPD_61_0..4 SPD_62_0..4 SPD_63_0..4
VAR_IN  SPD_64_0..4 SPD_65_0..4 SPD_66_0..4
VAR_OUT AUTH_46..66
VAR_OUT SW_52 SIG_52_R SIG_52_Y SIG_52_G SIG_52_SG
VAR_OUT XING_47
VAR_OUT CMD_46_0..4 CMD_47_0..4 CMD_48_0..4 CMD_49_0..4 CMD_50_0..4 CMD_51_0..4
VAR_OUT CMD_52_0..4 CMD_53_0..4 CMD_54_0..4 CMD_55_0..4 CMD_56_0..4 CMD_57_0..4
VAR_OUT CMD_58_0..4 CMD_59_0..4 CMD_60_0..4 CMD_61_0..4 CMD_62_0..4 CMD_63_0..4
VAR_OUT CMD_64_0..4 CMD_65_0..4 CMD_66_0..4

// Switch 52: points at 52, normal leg to 53, reverse leg to 66.
// Reverse for a train waiting on 66, or when 53 is closed; never
// into a train on 53 or a closed 66.
AUTO_52 := (OCC_66 OR CLOSED_53) AND NOT OCC_53 AND NOT CLOSED_66
// The CTC Office's command wins while it sends one (maintenance).
WANT_52 := (CTCSW_52 AND CTCREV_52) OR (NOT CTCSW_52 AND AUTO_52)
// A train on 52 locks it where it reports.
LOCK_52 := OCC_52
SW_52 := (LOCK_52 AND SWREV_52) OR (NOT LOCK_52 AND WANT_52)
// Commanded but not reported: moving or failed. Nothing uses its route.
BAD_52 := SW_52 XOR SWREV_52

// Signal 52 guards the points at 52: red over a busy or closed route,
// yellow on the diverging route, in maintenance or with 54 busy, green
// with a train on 55, else super green. Exactly one is lit.
BLOCKED_52 := OCC_52 OR CLOSED_52 OR BAD_52 OR (NOT SWREV_52 AND (OCC_53 OR CLOSED_53)) OR (SWREV_52 AND (OCC_66 OR CLOSED_66))
CAUTION_52 := SWREV_52 OR CTCSW_52 OR OCC_54 OR CLOSED_54
SIG_52_R := BLOCKED_52
SIG_52_Y := NOT BLOCKED_52 AND CAUTION_52
SIG_52_G := NOT BLOCKED_52 AND NOT CAUTION_52 AND OCC_55
SIG_52_SG := NOT BLOCKED_52 AND NOT CAUTION_52 AND NOT OCC_55

// Crossing 47: lights and gates for a train on 46, 47, 48.
XING_47 := OCC_46 OR OCC_47 OR OCC_48

// A train keeps its authority while its block is open, no switch
// on its route is moving, and every block it could move into is
// clear. At points only the leg the switch reports set counts; a
// train on a leg is held by a train on the points either way.
AUTH_46 := NOT (CLOSED_46 OR (OCC_46 AND (OCC_45 OR OCC_47)))
AUTH_47 := NOT (CLOSED_47 OR (OCC_47 AND (OCC_46 OR OCC_48)))
AUTH_48 := NOT (CLOSED_48 OR (OCC_48 AND (OCC_47 OR OCC_49)))
AUTH_49 := NOT (CLOSED_49 OR (OCC_49 AND (OCC_48 OR OCC_50)))
AUTH_50 := NOT (CLOSED_50 OR (OCC_50 AND (OCC_49 OR OCC_51)))
AUTH_51 := NOT (CLOSED_51 OR (OCC_51 AND (OCC_50 OR OCC_52)))
AUTH_52 := NOT (CLOSED_52 OR (OCC_52 AND (OCC_51 OR (NOT SWREV_52 AND OCC_53) OR (SWREV_52 AND OCC_66))) OR BAD_52)
AUTH_53 := NOT (CLOSED_53 OR (OCC_53 AND (OCC_52 OR OCC_54)) OR BAD_52)
AUTH_54 := NOT (CLOSED_54 OR (OCC_54 AND (OCC_53 OR OCC_55)))
AUTH_55 := NOT (CLOSED_55 OR (OCC_55 AND (OCC_54 OR OCC_56)))
AUTH_56 := NOT (CLOSED_56 OR (OCC_56 AND (OCC_55 OR OCC_57)))
AUTH_57 := NOT (CLOSED_57 OR (OCC_57 AND (OCC_56 OR OCC_58)))
AUTH_58 := NOT (CLOSED_58 OR (OCC_58 AND (OCC_57 OR OCC_59)))
AUTH_59 := NOT (CLOSED_59 OR (OCC_59 AND (OCC_58 OR OCC_60)))
AUTH_60 := NOT (CLOSED_60 OR (OCC_60 AND (OCC_59 OR OCC_61)))
AUTH_61 := NOT (CLOSED_61 OR (OCC_61 AND (OCC_60 OR OCC_62)))
AUTH_62 := NOT (CLOSED_62 OR (OCC_62 AND (OCC_61 OR OCC_63)))
AUTH_63 := NOT (CLOSED_63 OR (OCC_63 AND (OCC_62 OR OCC_64)))
AUTH_64 := NOT (CLOSED_64 OR (OCC_64 AND (OCC_63 OR OCC_65)))
AUTH_65 := NOT (CLOSED_65 OR (OCC_65 AND (OCC_64 OR OCC_66)))
AUTH_66 := NOT (CLOSED_66 OR (OCC_66 AND (OCC_52 OR OCC_65)) OR BAD_52)

// Speed: the CTC Office's suggestion, only with authority. The
// wayside's vital block caps it at each block's limit.
CMD_46_0 := AUTH_46 AND SPD_46_0
CMD_46_1 := AUTH_46 AND SPD_46_1
CMD_46_2 := AUTH_46 AND SPD_46_2
CMD_46_3 := AUTH_46 AND SPD_46_3
CMD_46_4 := AUTH_46 AND SPD_46_4
CMD_47_0 := AUTH_47 AND SPD_47_0
CMD_47_1 := AUTH_47 AND SPD_47_1
CMD_47_2 := AUTH_47 AND SPD_47_2
CMD_47_3 := AUTH_47 AND SPD_47_3
CMD_47_4 := AUTH_47 AND SPD_47_4
CMD_48_0 := AUTH_48 AND SPD_48_0
CMD_48_1 := AUTH_48 AND SPD_48_1
CMD_48_2 := AUTH_48 AND SPD_48_2
CMD_48_3 := AUTH_48 AND SPD_48_3
CMD_48_4 := AUTH_48 AND SPD_48_4
CMD_49_0 := AUTH_49 AND SPD_49_0
CMD_49_1 := AUTH_49 AND SPD_49_1

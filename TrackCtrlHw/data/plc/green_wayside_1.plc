// Green line, wayside 1: blocks 1-20, sections A-E.
// Switch 12 joins 12-13 when normal and 1-13 when reversed. Its signal
// shows the route into block 13. Railway crossing on block 19.
//
// The wayside runs this program and nothing else, so every protection
// is here. AUTH_n passes the CTC Office's authority to the train in
// block n; 0 sends authority 0. The CTC Office's speed for block n
// arrives as five bits, SPD_n_0 (1 m/s) to SPD_n_4 (16 m/s), and goes
// out as CMD_n_0..4, capped at the block's limit.

VAR_IN  OCC_1..20
VAR_IN  CLOSED_1..20
VAR_IN  SWREV_12 CTCSW_12 CTCREV_12
VAR_IN  SPD_1_0..4 SPD_2_0..4 SPD_3_0..4 SPD_4_0..4 SPD_5_0..4
VAR_IN  SPD_6_0..4 SPD_7_0..4 SPD_8_0..4 SPD_9_0..4 SPD_10_0..4
VAR_IN  SPD_11_0..4 SPD_12_0..4 SPD_13_0..4 SPD_14_0..4 SPD_15_0..4
VAR_IN  SPD_16_0..4 SPD_17_0..4 SPD_18_0..4 SPD_19_0..4 SPD_20_0..4
VAR_OUT AUTH_1..20
VAR_OUT SW_12
VAR_OUT SIG_12_R SIG_12_Y SIG_12_G SIG_12_SG
VAR_OUT XING_19
VAR_OUT CMD_1_0..4 CMD_2_0..4 CMD_3_0..4 CMD_4_0..4 CMD_5_0..4
VAR_OUT CMD_6_0..4 CMD_7_0..4 CMD_8_0..4 CMD_9_0..4 CMD_10_0..4
VAR_OUT CMD_11_0..4 CMD_12_0..4 CMD_13_0..4 CMD_14_0..4 CMD_15_0..4
VAR_OUT CMD_16_0..4 CMD_17_0..4 CMD_18_0..4 CMD_19_0..4 CMD_20_0..4

// Switch 12: while the CTC Office commands it (maintenance), obey.
// Otherwise send a train waiting on the loop (block 1) into 13 once
// the main-line approach is clear, and keep the main line.
AUTO_12 := OCC_1 AND NOT OCC_12 AND NOT OCC_13
WANT_12 := (CTCSW_12 AND CTCREV_12) OR (NOT CTCSW_12 AND AUTO_12)
// A train on the points (block 12 or 13) locks the switch where it
// reports.
LOCK_12 := OCC_12 OR OCC_13
SW_12   := (LOCK_12 AND SWREV_12) OR (NOT LOCK_12 AND WANT_12)
// The switch does not report where it is commanded: moving, or failed.
// Nothing may use the route over it (blocks 1, 12 and 13).
BAD_12  := SW_12 XOR SWREV_12

// Signal 12 reads the route into 13 and the block beyond it. Exactly
// one aspect is lit for every input: red, else yellow, else green or
// super green.
BLOCKED := OCC_13 OR CLOSED_13 OR BAD_12
CAUTION := OCC_14 OR CLOSED_14 OR SWREV_12 OR CTCSW_12
SIG_12_R  := BLOCKED
SIG_12_Y  := NOT BLOCKED AND CAUTION
SIG_12_G  := NOT BLOCKED AND NOT CAUTION AND OCC_15
SIG_12_SG := NOT BLOCKED AND NOT CAUTION AND NOT OCC_15

// Crossing 19: lights and gates for a train on 18, 19 or 20.
XING_19 := OCC_18 OR OCC_19 OR OCC_20

// A train keeps its authority while its own block is open and the
// blocks beside it, on the route the switch has set, are clear.
NEAR_13 := OCC_14 OR (NOT SWREV_12 AND OCC_12) OR (SWREV_12 AND OCC_1)
AUTH_1  := NOT (CLOSED_1 OR OCC_2 OR (SWREV_12 AND OCC_13) OR BAD_12)
AUTH_2  := NOT (CLOSED_2 OR OCC_1 OR OCC_3)
AUTH_3  := NOT (CLOSED_3 OR OCC_2 OR OCC_4)
AUTH_4  := NOT (CLOSED_4 OR OCC_3 OR OCC_5)
AUTH_5  := NOT (CLOSED_5 OR OCC_4 OR OCC_6)
AUTH_6  := NOT (CLOSED_6 OR OCC_5 OR OCC_7)
AUTH_7  := NOT (CLOSED_7 OR OCC_6 OR OCC_8)
AUTH_8  := NOT (CLOSED_8 OR OCC_7 OR OCC_9)
AUTH_9  := NOT (CLOSED_9 OR OCC_8 OR OCC_10)
AUTH_10 := NOT (CLOSED_10 OR OCC_9 OR OCC_11)
AUTH_11 := NOT (CLOSED_11 OR OCC_10 OR OCC_12)
AUTH_12 := NOT (CLOSED_12 OR OCC_11 OR (NOT SWREV_12 AND OCC_13) OR BAD_12)
AUTH_13 := NOT (CLOSED_13 OR NEAR_13 OR BAD_12)
AUTH_14 := NOT (CLOSED_14 OR OCC_13 OR OCC_15)
AUTH_15 := NOT (CLOSED_15 OR OCC_14 OR OCC_16)
AUTH_16 := NOT (CLOSED_16 OR OCC_15 OR OCC_17)
AUTH_17 := NOT (CLOSED_17 OR OCC_16 OR OCC_18)
AUTH_18 := NOT (CLOSED_18 OR OCC_17 OR OCC_19)
AUTH_19 := NOT (CLOSED_19 OR OCC_18 OR OCC_20)
AUTH_20 := NOT (CLOSED_20 OR OCC_19)

// Speed. OVER_n is 1 when the CTC Office's speed for block n is above
// the block's limit, rounded down to whole m/s; then the limit's own
// bits go out instead. Nothing goes out without AUTH_n.

// Limit 45 km/h: 12 m/s, 01100 (bit 4 first).
OVER_1  := SPD_1_4 OR (SPD_1_3 AND SPD_1_2 AND (SPD_1_1 OR SPD_1_0))
CMD_1_0 := AUTH_1 AND NOT OVER_1 AND SPD_1_0
CMD_1_1 := AUTH_1 AND NOT OVER_1 AND SPD_1_1
CMD_1_2 := AUTH_1 AND (OVER_1 OR SPD_1_2)
CMD_1_3 := AUTH_1 AND (OVER_1 OR SPD_1_3)
CMD_1_4 := AUTH_1 AND NOT OVER_1 AND SPD_1_4
OVER_2  := SPD_2_4 OR (SPD_2_3 AND SPD_2_2 AND (SPD_2_1 OR SPD_2_0))
CMD_2_0 := AUTH_2 AND NOT OVER_2 AND SPD_2_0
CMD_2_1 := AUTH_2 AND NOT OVER_2 AND SPD_2_1
CMD_2_2 := AUTH_2 AND (OVER_2 OR SPD_2_2)
CMD_2_3 := AUTH_2 AND (OVER_2 OR SPD_2_3)
CMD_2_4 := AUTH_2 AND NOT OVER_2 AND SPD_2_4
OVER_3  := SPD_3_4 OR (SPD_3_3 AND SPD_3_2 AND (SPD_3_1 OR SPD_3_0))
CMD_3_0 := AUTH_3 AND NOT OVER_3 AND SPD_3_0
CMD_3_1 := AUTH_3 AND NOT OVER_3 AND SPD_3_1
CMD_3_2 := AUTH_3 AND (OVER_3 OR SPD_3_2)
CMD_3_3 := AUTH_3 AND (OVER_3 OR SPD_3_3)
CMD_3_4 := AUTH_3 AND NOT OVER_3 AND SPD_3_4
OVER_4  := SPD_4_4 OR (SPD_4_3 AND SPD_4_2 AND (SPD_4_1 OR SPD_4_0))
CMD_4_0 := AUTH_4 AND NOT OVER_4 AND SPD_4_0
CMD_4_1 := AUTH_4 AND NOT OVER_4 AND SPD_4_1
CMD_4_2 := AUTH_4 AND (OVER_4 OR SPD_4_2)
CMD_4_3 := AUTH_4 AND (OVER_4 OR SPD_4_3)
CMD_4_4 := AUTH_4 AND NOT OVER_4 AND SPD_4_4
OVER_5  := SPD_5_4 OR (SPD_5_3 AND SPD_5_2 AND (SPD_5_1 OR SPD_5_0))
CMD_5_0 := AUTH_5 AND NOT OVER_5 AND SPD_5_0
CMD_5_1 := AUTH_5 AND NOT OVER_5 AND SPD_5_1
CMD_5_2 := AUTH_5 AND (OVER_5 OR SPD_5_2)
CMD_5_3 := AUTH_5 AND (OVER_5 OR SPD_5_3)
CMD_5_4 := AUTH_5 AND NOT OVER_5 AND SPD_5_4
OVER_6  := SPD_6_4 OR (SPD_6_3 AND SPD_6_2 AND (SPD_6_1 OR SPD_6_0))
CMD_6_0 := AUTH_6 AND NOT OVER_6 AND SPD_6_0
CMD_6_1 := AUTH_6 AND NOT OVER_6 AND SPD_6_1
CMD_6_2 := AUTH_6 AND (OVER_6 OR SPD_6_2)
CMD_6_3 := AUTH_6 AND (OVER_6 OR SPD_6_3)
CMD_6_4 := AUTH_6 AND NOT OVER_6 AND SPD_6_4
OVER_7  := SPD_7_4 OR (SPD_7_3 AND SPD_7_2 AND (SPD_7_1 OR SPD_7_0))
CMD_7_0 := AUTH_7 AND NOT OVER_7 AND SPD_7_0
CMD_7_1 := AUTH_7 AND NOT OVER_7 AND SPD_7_1
CMD_7_2 := AUTH_7 AND (OVER_7 OR SPD_7_2)
CMD_7_3 := AUTH_7 AND (OVER_7 OR SPD_7_3)
CMD_7_4 := AUTH_7 AND NOT OVER_7 AND SPD_7_4
OVER_8  := SPD_8_4 OR (SPD_8_3 AND SPD_8_2 AND (SPD_8_1 OR SPD_8_0))
CMD_8_0 := AUTH_8 AND NOT OVER_8 AND SPD_8_0
CMD_8_1 := AUTH_8 AND NOT OVER_8 AND SPD_8_1
CMD_8_2 := AUTH_8 AND (OVER_8 OR SPD_8_2)
CMD_8_3 := AUTH_8 AND (OVER_8 OR SPD_8_3)
CMD_8_4 := AUTH_8 AND NOT OVER_8 AND SPD_8_4
OVER_9  := SPD_9_4 OR (SPD_9_3 AND SPD_9_2 AND (SPD_9_1 OR SPD_9_0))
CMD_9_0 := AUTH_9 AND NOT OVER_9 AND SPD_9_0
CMD_9_1 := AUTH_9 AND NOT OVER_9 AND SPD_9_1
CMD_9_2 := AUTH_9 AND (OVER_9 OR SPD_9_2)
CMD_9_3 := AUTH_9 AND (OVER_9 OR SPD_9_3)
CMD_9_4 := AUTH_9 AND NOT OVER_9 AND SPD_9_4
OVER_10  := SPD_10_4 OR (SPD_10_3 AND SPD_10_2 AND (SPD_10_1 OR SPD_10_0))
CMD_10_0 := AUTH_10 AND NOT OVER_10 AND SPD_10_0
CMD_10_1 := AUTH_10 AND NOT OVER_10 AND SPD_10_1
CMD_10_2 := AUTH_10 AND (OVER_10 OR SPD_10_2)
CMD_10_3 := AUTH_10 AND (OVER_10 OR SPD_10_3)
CMD_10_4 := AUTH_10 AND NOT OVER_10 AND SPD_10_4
OVER_11  := SPD_11_4 OR (SPD_11_3 AND SPD_11_2 AND (SPD_11_1 OR SPD_11_0))
CMD_11_0 := AUTH_11 AND NOT OVER_11 AND SPD_11_0
CMD_11_1 := AUTH_11 AND NOT OVER_11 AND SPD_11_1
CMD_11_2 := AUTH_11 AND (OVER_11 OR SPD_11_2)
CMD_11_3 := AUTH_11 AND (OVER_11 OR SPD_11_3)
CMD_11_4 := AUTH_11 AND NOT OVER_11 AND SPD_11_4
OVER_12  := SPD_12_4 OR (SPD_12_3 AND SPD_12_2 AND (SPD_12_1 OR SPD_12_0))
CMD_12_0 := AUTH_12 AND NOT OVER_12 AND SPD_12_0
CMD_12_1 := AUTH_12 AND NOT OVER_12 AND SPD_12_1
CMD_12_2 := AUTH_12 AND (OVER_12 OR SPD_12_2)
CMD_12_3 := AUTH_12 AND (OVER_12 OR SPD_12_3)
CMD_12_4 := AUTH_12 AND NOT OVER_12 AND SPD_12_4

// Limit 70 km/h: 19 m/s, 10011 (bit 4 first).
OVER_13  := SPD_13_4 AND (SPD_13_3 OR SPD_13_2)
CMD_13_0 := AUTH_13 AND (OVER_13 OR SPD_13_0)
CMD_13_1 := AUTH_13 AND (OVER_13 OR SPD_13_1)
CMD_13_2 := AUTH_13 AND NOT OVER_13 AND SPD_13_2
CMD_13_3 := AUTH_13 AND NOT OVER_13 AND SPD_13_3
CMD_13_4 := AUTH_13 AND (OVER_13 OR SPD_13_4)
OVER_14  := SPD_14_4 AND (SPD_14_3 OR SPD_14_2)
CMD_14_0 := AUTH_14 AND (OVER_14 OR SPD_14_0)
CMD_14_1 := AUTH_14 AND (OVER_14 OR SPD_14_1)
CMD_14_2 := AUTH_14 AND NOT OVER_14 AND SPD_14_2
CMD_14_3 := AUTH_14 AND NOT OVER_14 AND SPD_14_3
CMD_14_4 := AUTH_14 AND (OVER_14 OR SPD_14_4)
OVER_15  := SPD_15_4 AND (SPD_15_3 OR SPD_15_2)
CMD_15_0 := AUTH_15 AND (OVER_15 OR SPD_15_0)
CMD_15_1 := AUTH_15 AND (OVER_15 OR SPD_15_1)
CMD_15_2 := AUTH_15 AND NOT OVER_15 AND SPD_15_2
CMD_15_3 := AUTH_15 AND NOT OVER_15 AND SPD_15_3
CMD_15_4 := AUTH_15 AND (OVER_15 OR SPD_15_4)
OVER_16  := SPD_16_4 AND (SPD_16_3 OR SPD_16_2)
CMD_16_0 := AUTH_16 AND (OVER_16 OR SPD_16_0)
CMD_16_1 := AUTH_16 AND (OVER_16 OR SPD_16_1)
CMD_16_2 := AUTH_16 AND NOT OVER_16 AND SPD_16_2
CMD_16_3 := AUTH_16 AND NOT OVER_16 AND SPD_16_3
CMD_16_4 := AUTH_16 AND (OVER_16 OR SPD_16_4)

// Limit 60 km/h: 16 m/s, 10000 (bit 4 first).
OVER_17  := SPD_17_4 AND (SPD_17_3 OR SPD_17_2 OR SPD_17_1 OR SPD_17_0)
CMD_17_0 := AUTH_17 AND NOT OVER_17 AND SPD_17_0
CMD_17_1 := AUTH_17 AND NOT OVER_17 AND SPD_17_1
CMD_17_2 := AUTH_17 AND NOT OVER_17 AND SPD_17_2
CMD_17_3 := AUTH_17 AND NOT OVER_17 AND SPD_17_3
CMD_17_4 := AUTH_17 AND (OVER_17 OR SPD_17_4)
OVER_18  := SPD_18_4 AND (SPD_18_3 OR SPD_18_2 OR SPD_18_1 OR SPD_18_0)
CMD_18_0 := AUTH_18 AND NOT OVER_18 AND SPD_18_0
CMD_18_1 := AUTH_18 AND NOT OVER_18 AND SPD_18_1
CMD_18_2 := AUTH_18 AND NOT OVER_18 AND SPD_18_2
CMD_18_3 := AUTH_18 AND NOT OVER_18 AND SPD_18_3
CMD_18_4 := AUTH_18 AND (OVER_18 OR SPD_18_4)
OVER_19  := SPD_19_4 AND (SPD_19_3 OR SPD_19_2 OR SPD_19_1 OR SPD_19_0)
CMD_19_0 := AUTH_19 AND NOT OVER_19 AND SPD_19_0
CMD_19_1 := AUTH_19 AND NOT OVER_19 AND SPD_19_1
CMD_19_2 := AUTH_19 AND NOT OVER_19 AND SPD_19_2
CMD_19_3 := AUTH_19 AND NOT OVER_19 AND SPD_19_3
CMD_19_4 := AUTH_19 AND (OVER_19 OR SPD_19_4)
OVER_20  := SPD_20_4 AND (SPD_20_3 OR SPD_20_2 OR SPD_20_1 OR SPD_20_0)
CMD_20_0 := AUTH_20 AND NOT OVER_20 AND SPD_20_0
CMD_20_1 := AUTH_20 AND NOT OVER_20 AND SPD_20_1
CMD_20_2 := AUTH_20 AND NOT OVER_20 AND SPD_20_2
CMD_20_3 := AUTH_20 AND NOT OVER_20 AND SPD_20_3
CMD_20_4 := AUTH_20 AND (OVER_20 OR SPD_20_4)

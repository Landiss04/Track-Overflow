// GTC-06  Green Line  blocks 126..150
// OCC_n and CLOSED_n report block n. AUTH_n passes the CTC Office's speed and
// authority for block n to the train in it (1), or sends speed 0, authority 0 (0).

VAR_IN   OCC_126..150
VAR_IN   CLOSED_126..150
VAR_IN   MAINT
VAR_IN   PEER_OCC_12 PEER_OCC_11 PEER_OCC_10 PEER_OCC_9 PEER_OCC_8 PEER_OCC_7
VAR_OUT  AUTH_126..150

// Loop guard DEF: a train in 12..7 and another on 145..150: hold the approach,
// and once 13..28 is clear set 12 reverse, 28 normal, so the loop drains first.
DRAIN_DEF := (PEER_OCC_12 OR PEER_OCC_11 OR PEER_OCC_10 OR PEER_OCC_9 OR PEER_OCC_8 OR PEER_OCC_7) AND (OCC_145 OR OCC_146 OR OCC_147 OR OCC_148 OR OCC_149 OR OCC_150)

// Separation: hold a train whose next block is occupied. A block with no train
// in it passes its suggestion: it is the next block of the train behind it.
AUTH_126 := NOT (OCC_126 AND OCC_127)
AUTH_127 := NOT (OCC_127 AND OCC_128)
AUTH_128 := NOT (OCC_128 AND OCC_129)
AUTH_129 := NOT (OCC_129 AND OCC_130)
AUTH_130 := NOT (OCC_130 AND OCC_131)
AUTH_131 := NOT (OCC_131 AND OCC_132)
AUTH_132 := NOT (OCC_132 AND OCC_133)
AUTH_133 := NOT (OCC_133 AND OCC_134)
AUTH_134 := NOT (OCC_134 AND OCC_135)
AUTH_135 := NOT (OCC_135 AND OCC_136)
AUTH_136 := NOT (OCC_136 AND OCC_137)
AUTH_137 := NOT (OCC_137 AND OCC_138)
AUTH_138 := NOT (OCC_138 AND OCC_139)
AUTH_139 := NOT (OCC_139 AND OCC_140)
AUTH_140 := NOT (OCC_140 AND OCC_141)
AUTH_141 := NOT (OCC_141 AND OCC_142)
AUTH_142 := NOT (OCC_142 AND OCC_143)
AUTH_143 := NOT (OCC_143 AND OCC_144)
AUTH_144 := NOT (OCC_144 AND OCC_145)
AUTH_145 := NOT (OCC_145 AND OCC_146) AND NOT DRAIN_DEF
AUTH_146 := NOT (OCC_146 AND OCC_147) AND NOT DRAIN_DEF
AUTH_147 := NOT (OCC_147 AND OCC_148) AND NOT DRAIN_DEF
AUTH_148 := NOT (OCC_148 AND OCC_149) AND NOT DRAIN_DEF
AUTH_149 := NOT (OCC_149 AND OCC_150) AND NOT DRAIN_DEF
AUTH_150 := NOT DRAIN_DEF

// GTC-01  Green Line  blocks 1..25
// OCC_n and CLOSED_n report block n. AUTH_n passes the CTC Office's speed and
// authority for block n to the train in it (1), or sends speed 0, authority 0 (0).

VAR_IN   OCC_1..25
VAR_IN   CLOSED_1..25
VAR_IN   MAINT
VAR_IN   SWREV_12
VAR_IN   CTCSW_12 CTCREV_12
VAR_IN   REQSW_12 REQREV_12
VAR_IN   PEER_OCC_145 PEER_OCC_146 PEER_OCC_147 PEER_OCC_148 PEER_OCC_149 PEER_OCC_150 PEER_OCC_26 PEER_OCC_27 PEER_OCC_28
VAR_OUT  AUTH_1..25
VAR_OUT  SW_12
VAR_OUT  SIG_12_R SIG_12_Y SIG_12_G SIG_12_SG
VAR_OUT  XING_19

// Loop guard DEF: a train in 12..7 and another on 145..150: hold the approach,
// and once 13..28 is clear set 12 reverse, 28 normal, so the loop drains first.
DRAIN_DEF := (OCC_12 OR OCC_11 OR OCC_10 OR OCC_9 OR OCC_8 OR OCC_7) AND (PEER_OCC_145 OR PEER_OCC_146 OR PEER_OCC_147 OR PEER_OCC_148 OR PEER_OCC_149 OR PEER_OCC_150)
SET_DEF := DRAIN_DEF AND NOT (OCC_13 OR OCC_14 OR OCC_15 OR OCC_16 OR OCC_17 OR OCC_18 OR OCC_19 OR OCC_20 OR OCC_21 OR OCC_22 OR OCC_23 OR OCC_24 OR OCC_25 OR PEER_OCC_26 OR PEER_OCC_27 OR PEER_OCC_28)

// Switch 12: points at 13, normal to 12, reverse to 1.
// Stands normal until a train is seen coming for the other position;
// held while 13 is occupied or trains come for both; normal in maintenance.
WANT_N_12 := 0
WANT_R_12 := OCC_1
HOLD_12 := OCC_13 OR (WANT_N_12 AND WANT_R_12)
SW_12 := (CTCSW_12 AND CTCREV_12) OR (NOT CTCSW_12 AND (SET_DEF OR (NOT SET_DEF AND ((REQSW_12 AND REQREV_12 AND NOT CLOSED_1) OR (NOT ((REQSW_12 AND REQREV_12 AND NOT CLOSED_1) OR (REQSW_12 AND NOT REQREV_12 AND NOT CLOSED_12)) AND ((HOLD_12 AND SWREV_12) OR (NOT HOLD_12 AND NOT MAINT AND WANT_R_12)))))))

// Signal 12: red on a bad block or switch, else yellow if the route ahead is
// busy, else green. Exactly one aspect is lit for every input.
AHEAD_12 := OCC_1 OR OCC_10 OR OCC_11 OR OCC_13 OR OCC_14
SIG_12_R := OCC_12 OR CLOSED_12
SIG_12_Y := NOT SIG_12_R AND AHEAD_12
SIG_12_G := NOT SIG_12_R AND NOT AHEAD_12
SIG_12_SG := 0

// Crossing 19: lights and gates while a train is on it or beside it.
XING_19 := OCC_18 OR OCC_19 OR OCC_20

// Separation: hold a train whose next block is occupied. A block with no train
// in it passes its suggestion: it is the next block of the train behind it.
AUTH_1 := NOT (OCC_1 AND OCC_13)
AUTH_2 := NOT (OCC_2 AND OCC_1)
AUTH_3 := NOT (OCC_3 AND OCC_2)
AUTH_4 := NOT (OCC_4 AND OCC_3)
AUTH_5 := NOT (OCC_5 AND OCC_4)
AUTH_6 := NOT (OCC_6 AND OCC_5)
AUTH_7 := NOT (OCC_7 AND OCC_6)
AUTH_8 := NOT (OCC_8 AND OCC_7)
AUTH_9 := NOT (OCC_9 AND OCC_8)
AUTH_10 := NOT (OCC_10 AND OCC_9)
AUTH_11 := NOT (OCC_11 AND OCC_10)
AUTH_12 := NOT (OCC_12 AND OCC_11)
AUTH_13 := NOT (OCC_13 AND (OCC_12 OR OCC_14))
AUTH_14 := NOT (OCC_14 AND (OCC_13 OR OCC_15))
AUTH_15 := NOT (OCC_15 AND (OCC_14 OR OCC_16))
AUTH_16 := NOT (OCC_16 AND (OCC_15 OR OCC_17))
AUTH_17 := NOT (OCC_17 AND (OCC_16 OR OCC_18))
AUTH_18 := NOT (OCC_18 AND (OCC_17 OR OCC_19))
AUTH_19 := NOT (OCC_19 AND (OCC_18 OR OCC_20))
AUTH_20 := NOT (OCC_20 AND (OCC_19 OR OCC_21))
AUTH_21 := NOT (OCC_21 AND (OCC_20 OR OCC_22))
AUTH_22 := NOT (OCC_22 AND (OCC_21 OR OCC_23))
AUTH_23 := NOT (OCC_23 AND (OCC_22 OR OCC_24))
AUTH_24 := NOT (OCC_24 AND (OCC_23 OR OCC_25))
AUTH_25 := NOT (OCC_25 AND OCC_24)

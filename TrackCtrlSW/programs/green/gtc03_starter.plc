// GTC-03  Green Line  blocks 51..75
// OCC_n and CLOSED_n report block n. AUTH_n passes the CTC Office's speed and
// authority for block n to the train in it (1), or sends speed 0, authority 0 (0).

VAR_IN   OCC_51..75
VAR_IN   CLOSED_51..75
VAR_IN   MAINT
VAR_IN   SWREV_58 SWREV_62
VAR_IN   CTCSW_58 CTCREV_58 CTCSW_62 CTCREV_62
VAR_IN   REQSW_58 REQREV_58 REQSW_62 REQREV_62
VAR_IN   PEER_CNT_GTC04_0 PEER_CNT_GTC04_1 PEER_CNT_GTC04_2 PEER_CNT_GTC04_3 PEER_CNT_GTC04_4
VAR_OUT  AUTH_51..75
VAR_OUT  SW_58 SW_62
VAR_OUT  SIG_58_R SIG_58_Y SIG_58_G SIG_58_SG
VAR_OUT  SIG_62_R SIG_62_Y SIG_62_G SIG_62_SG

// GTC-04 reports how many of its blocks are occupied; over 5
// it is crowded, and the train on 75 waits.
FULL_GTC04 := (PEER_CNT_GTC04_4) OR (PEER_CNT_GTC04_3 AND NOT PEER_CNT_GTC04_4) OR (PEER_CNT_GTC04_1 AND NOT PEER_CNT_GTC04_4 AND NOT PEER_CNT_GTC04_3 AND PEER_CNT_GTC04_2)

// Switch 58: points at 57, normal to 58, reverse to yard.
// Stands normal until a train is seen coming for the other position;
// held while 57 is occupied or trains come for both; normal in maintenance.
WANT_N_58 := NOT OCC_57 AND OCC_56
WANT_R_58 := 0
HOLD_58 := OCC_57 OR (WANT_N_58 AND WANT_R_58)
SW_58 := (CTCSW_58 AND CTCREV_58) OR (NOT CTCSW_58 AND ((REQSW_58 AND REQREV_58) OR (NOT ((REQSW_58 AND REQREV_58) OR (REQSW_58 AND NOT REQREV_58 AND NOT CLOSED_58)) AND ((HOLD_58 AND SWREV_58) OR (NOT HOLD_58 AND NOT MAINT AND WANT_R_58)))))

// Switch 62: points at 63, normal to 62, reverse to yard.
// Stands normal until a train is seen coming for the other position;
// held while 63 is occupied or trains come for both; normal in maintenance.
WANT_N_62 := OCC_62 OR OCC_61
WANT_R_62 := 0
HOLD_62 := OCC_63 OR (WANT_N_62 AND WANT_R_62)
SW_62 := (CTCSW_62 AND CTCREV_62) OR (NOT CTCSW_62 AND ((REQSW_62 AND REQREV_62) OR (NOT ((REQSW_62 AND REQREV_62) OR (REQSW_62 AND NOT REQREV_62 AND NOT CLOSED_62)) AND ((HOLD_62 AND SWREV_62) OR (NOT HOLD_62 AND NOT MAINT AND WANT_R_62)))))

// Signal 58: red on a bad block or switch, else yellow if the route ahead is
// busy, else green. Exactly one aspect is lit for every input.
AHEAD_58 := OCC_56 OR OCC_57 OR OCC_59 OR OCC_60
SIG_58_R := OCC_58 OR CLOSED_58
SIG_58_Y := NOT SIG_58_R AND AHEAD_58
SIG_58_G := NOT SIG_58_R AND NOT AHEAD_58
SIG_58_SG := 0

// Signal 62: red on a bad block or switch, else yellow if the route ahead is
// busy, else green. Exactly one aspect is lit for every input.
AHEAD_62 := OCC_60 OR OCC_61 OR OCC_63 OR OCC_64
SIG_62_R := OCC_62 OR CLOSED_62
SIG_62_Y := NOT SIG_62_R AND AHEAD_62
SIG_62_G := NOT SIG_62_R AND NOT AHEAD_62
SIG_62_SG := 0

// Separation: hold a train whose next block is occupied. A block with no train
// in it passes its suggestion: it is the next block of the train behind it.
AUTH_51 := NOT (OCC_51 AND OCC_52)
AUTH_52 := NOT (OCC_52 AND OCC_53)
AUTH_53 := NOT (OCC_53 AND OCC_54)
AUTH_54 := NOT (OCC_54 AND OCC_55)
AUTH_55 := NOT (OCC_55 AND OCC_56)
AUTH_56 := NOT (OCC_56 AND OCC_57)
AUTH_57 := NOT (OCC_57 AND OCC_58)
AUTH_58 := NOT (OCC_58 AND OCC_59)
AUTH_59 := NOT (OCC_59 AND OCC_60)
AUTH_60 := NOT (OCC_60 AND OCC_61)
AUTH_61 := NOT (OCC_61 AND OCC_62)
AUTH_62 := NOT (OCC_62 AND OCC_63)
AUTH_63 := NOT (OCC_63 AND OCC_64)
AUTH_64 := NOT (OCC_64 AND OCC_65)
AUTH_65 := NOT (OCC_65 AND OCC_66)
AUTH_66 := NOT (OCC_66 AND OCC_67)
AUTH_67 := NOT (OCC_67 AND OCC_68)
AUTH_68 := NOT (OCC_68 AND OCC_69)
AUTH_69 := NOT (OCC_69 AND OCC_70)
AUTH_70 := NOT (OCC_70 AND OCC_71)
AUTH_71 := NOT (OCC_71 AND OCC_72)
AUTH_72 := NOT (OCC_72 AND OCC_73)
AUTH_73 := NOT (OCC_73 AND OCC_74)
AUTH_74 := NOT (OCC_74 AND OCC_75)
AUTH_75 := NOT FULL_GTC04

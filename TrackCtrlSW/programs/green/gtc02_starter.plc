// GTC-02  Green Line  blocks 26..50
// OCC_n and CLOSED_n report block n. AUTH_n passes the CTC Office's speed and
// authority for block n to the train in it (1), or sends speed 0, authority 0 (0).

VAR_IN   OCC_26..50
VAR_IN   CLOSED_26..50
VAR_IN   MAINT
VAR_IN   SWREV_28
VAR_IN   CTCSW_28 CTCREV_28
VAR_IN   REQSW_28 REQREV_28
VAR_IN   PEER_OCC_12 PEER_OCC_11 PEER_OCC_10 PEER_OCC_9 PEER_OCC_8 PEER_OCC_7 PEER_OCC_145 PEER_OCC_146 PEER_OCC_147 PEER_OCC_148 PEER_OCC_149 PEER_OCC_150 PEER_OCC_13 PEER_OCC_14 PEER_OCC_15 PEER_OCC_16 PEER_OCC_17 PEER_OCC_18 PEER_OCC_19 PEER_OCC_20 PEER_OCC_21 PEER_OCC_22 PEER_OCC_23 PEER_OCC_24 PEER_OCC_25
VAR_OUT  AUTH_26..50
VAR_OUT  SW_28
VAR_OUT  SIG_28_R SIG_28_Y SIG_28_G SIG_28_SG

// Loop guard DEF: a train in 12..7 and another on 145..150: hold the approach,
// and once 13..28 is clear set 12 reverse, 28 normal, so the loop drains first.
DRAIN_DEF := (PEER_OCC_12 OR PEER_OCC_11 OR PEER_OCC_10 OR PEER_OCC_9 OR PEER_OCC_8 OR PEER_OCC_7) AND (PEER_OCC_145 OR PEER_OCC_146 OR PEER_OCC_147 OR PEER_OCC_148 OR PEER_OCC_149 OR PEER_OCC_150)
SET_DEF := DRAIN_DEF AND NOT (PEER_OCC_13 OR PEER_OCC_14 OR PEER_OCC_15 OR PEER_OCC_16 OR PEER_OCC_17 OR PEER_OCC_18 OR PEER_OCC_19 OR PEER_OCC_20 OR PEER_OCC_21 OR PEER_OCC_22 OR PEER_OCC_23 OR PEER_OCC_24 OR PEER_OCC_25 OR OCC_26 OR OCC_27 OR OCC_28)

// Switch 28: points at 28, normal to 29, reverse to 150.
// Stands reverse until a train is seen coming for the other position;
// held while 28 is occupied or trains come for both; normal in maintenance.
WANT_N_28 := 0
WANT_R_28 := 0
HOLD_28 := OCC_28 OR (WANT_N_28 AND WANT_R_28)
SW_28 := (CTCSW_28 AND CTCREV_28) OR (NOT CTCSW_28 AND (NOT SET_DEF AND ((REQSW_28 AND REQREV_28) OR (NOT ((REQSW_28 AND REQREV_28) OR (REQSW_28 AND NOT REQREV_28 AND NOT CLOSED_29)) AND ((HOLD_28 AND SWREV_28) OR (NOT HOLD_28 AND NOT MAINT AND NOT WANT_N_28))))))

// Signal 28: red on a bad block or switch, else yellow if the route ahead is
// busy, else green. Exactly one aspect is lit for every input.
AHEAD_28 := OCC_26 OR OCC_27 OR OCC_29 OR OCC_30
SIG_28_R := OCC_28 OR CLOSED_28
SIG_28_Y := NOT SIG_28_R AND AHEAD_28
SIG_28_G := NOT SIG_28_R AND NOT AHEAD_28
SIG_28_SG := 0

// Separation: hold a train whose next block is occupied. A block with no train
// in it passes its suggestion: it is the next block of the train behind it.
AUTH_26 := NOT (OCC_26 AND OCC_27)
AUTH_27 := NOT (OCC_27 AND (OCC_26 OR OCC_28))
AUTH_28 := NOT (OCC_28 AND (OCC_27 OR OCC_29))
AUTH_29 := NOT (OCC_29 AND OCC_30)
AUTH_30 := NOT (OCC_30 AND OCC_31)
AUTH_31 := NOT (OCC_31 AND OCC_32)
AUTH_32 := NOT (OCC_32 AND OCC_33)
AUTH_33 := NOT (OCC_33 AND OCC_34)
AUTH_34 := NOT (OCC_34 AND OCC_35)
AUTH_35 := NOT (OCC_35 AND OCC_36)
AUTH_36 := NOT (OCC_36 AND OCC_37)
AUTH_37 := NOT (OCC_37 AND OCC_38)
AUTH_38 := NOT (OCC_38 AND OCC_39)
AUTH_39 := NOT (OCC_39 AND OCC_40)
AUTH_40 := NOT (OCC_40 AND OCC_41)
AUTH_41 := NOT (OCC_41 AND OCC_42)
AUTH_42 := NOT (OCC_42 AND OCC_43)
AUTH_43 := NOT (OCC_43 AND OCC_44)
AUTH_44 := NOT (OCC_44 AND OCC_45)
AUTH_45 := NOT (OCC_45 AND OCC_46)
AUTH_46 := NOT (OCC_46 AND OCC_47)
AUTH_47 := NOT (OCC_47 AND OCC_48)
AUTH_48 := NOT (OCC_48 AND OCC_49)
AUTH_49 := NOT (OCC_49 AND OCC_50)
AUTH_50 := 1

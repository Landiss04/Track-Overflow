+    def test_track_controllers_take_their_own_lines_suggestions(
+        self,
+    ) -> None:
+        ctc = {CTC_OFFICE: {"track_controller": {
+            "suggestions": [
+                suggestion("63", 12, 2),
+                {**suggestion("9", 10, 3), "train_id": "R1",
+                 "line": "Red"},
+            ],
+            "closed_blocks": [], "switch_commands": [],
+        }}}
+        hw = self.inputs(TRACK_CONTROLLER_HW, ctc)
+        self.assertEqual(
+            [(each["line"], each["block_id"])
+             for each in hw["ctc"]["suggestions"]],
+            [("Green", "63")])
+        # The HW module is given the step's time; the SW one is not.
+        self.assertEqual(hw["time_s"], SIM_TIME_S + DT_S)
+        sw = self.inputs(TRACK_CONTROLLER_SW, ctc)
+        self.assertEqual(
+            [each["block"]["line"] for each in sw["ctc"]["suggestions"]],
+            ["Red"])
+        self.assertNotIn("time_s", sw)
+

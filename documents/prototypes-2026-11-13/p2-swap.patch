+                 "occupied_blocks"]],
+            [("Green", "64")])
+        self.assertEqual(
+            [each["line"] for each in
+             self.inputs(TRACK_CONTROLLER_SW, model)["track_model"][
+                 "occupied_blocks"]],
+            ["Red"])
+
+    def test_readiness_is_the_hw_controllers_on_green(self) -> None:
+        def report(ready: bool) -> dict[str, Any]:
+            # The HW module's encoding: a block's fields beside it.
+            outputs = wayside_outputs(ready=ready)
+            for each in outputs["ctc_reports"]:
+                each["blocks"] = [
+                    {"block": entry["block"], **entry["value"]}
+                    for entry in each["blocks"]
+                ]
+            return outputs
+        events = self.edges.tick_completed(
+            2, SIM_TIME_S, {TRACK_CONTROLLER_HW: report(False)})

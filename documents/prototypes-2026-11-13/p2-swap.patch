+def _starter_files(line: str) -> list[Path]:
+    # The wayside databases that cover ``line``; exits if they leave
+    # a block of the line's layout out (the Pi cannot run a part-line).
+    import json
+    from track_ctrl_hw.territory import load_territory_file
+
+    files = sorted(
+        (ROOT / "TrackCtrlHw/data/waysides").glob(line.lower() + "_*.json")
+    )
+    layout = json.loads(
+        (ROOT / "Track_layout" / f"{line.lower()}_line.json").read_text()
+    )
+    wanted = {str(block["block_number"]) for block in layout["blocks"]}
+    covered = {
+        key.block_id for file in files
+        for key in load_territory_file(file).keys
+    }
+    if wanted - covered:
+        sys.exit(
+            f"track-controller-hw: the wayside files for the {line} Line "
+            f"cover {len(covered & wanted)} of its {len(wanted)} blocks "
+            f"({len(files)} files found); not starting"
+        )
+    return files
+

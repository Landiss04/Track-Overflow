diff -ruN '--exclude=__pycache__' base/TrackCtrlHw/tests/test_integration_sets.py p3-green-data/TrackCtrlHw/tests/test_integration_sets.py
--- base/TrackCtrlHw/tests/test_integration_sets.py	1969-12-31 19:00:00.000000000 -0500
+++ p3-green-data/TrackCtrlHw/tests/test_integration_sets.py	2026-11-12 22:23:17.262109602 -0500
@@ -0,0 +1,328 @@
+"""Every line's ``*_integration_test`` set: coverage, then Green behaviour."""
+
+from __future__ import annotations
+
+import json
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+for folder in (ROOT, ROOT / "TrackModel", ROOT / "TrackCtrlSW"):
+    sys.path.insert(0, str(folder))
+
+from common.harness.track_devices import TrackDevices  # noqa: E402
+from track_ctrl.layout import load_layout_file  # noqa: E402
+from track_ctrl_hw.controller import HwTrackController  # noqa: E402
+from track_ctrl_hw.plc import compile_program  # noqa: E402
+from track_ctrl_hw.territory import load_territory_file  # noqa: E402
+from track_ctrl_hw.wayside import check_program, output_names  # noqa: E402
+from tests.support import DATA, inputs  # noqa: E402
+
+LINES = ("Red", "Green")
+
+
+def stems(line: str) -> list[str]:
+    return sorted(
+        p.stem for p in (DATA / "waysides").glob(
+            f"{line.lower()}_wayside_*_integration_test.json"))
+
+
+def loaded(line: str) -> HwTrackController:
+    controller = HwTrackController()
+    for stem in stems(line):
+        territory = load_territory_file(DATA / "waysides" / f"{stem}.json")
+        controller.load_territory(territory)
+        controller.load_program(
+            territory.wayside_id,
+            (DATA / "plc" / f"{stem}.plc").read_text(), f"{stem}.plc")
+    return controller
+
+
+class Coverage(unittest.TestCase):
+    def test_every_block_device_and_program_is_covered_once(self) -> None:
+        for line in LINES:
+            layout = json.loads(
+                (ROOT / f"TrackModel/{line.lower()}_line.json").read_text())
+            rows = {r["block_number"]: r for r in layout["blocks"]}
+            switches = {r["block_number"] for r in rows.values()
+                        if "switch" in (r.get("infrastructure") or {})}
+            crossings = {r["block_number"] for r in rows.values()
+                         if (r.get("infrastructure") or {})
+                         .get("railway_crossing")}
+            owners: dict[int, str] = {}
+            own_switch: dict[int, str] = {}
+            own_cross: dict[int, str] = {}
+            own_signal: dict[int, str] = {}
+            self.assertTrue(stems(line), line)
+            for stem in stems(line):
+                with self.subTest(line=line, set=stem):
+                    database = json.loads(
+                        (DATA / "waysides" / f"{stem}.json").read_text())
+                    self.assertTrue(database["integration_test_only"])
+                    for block in database["blocks"]:
+                        n = block["block_number"]
+                        self.assertNotIn(n, owners)
+                        owners[n] = stem
+                        self.assertEqual(block, rows[n])
+                    territory = load_territory_file(
+                        DATA / "waysides" / f"{stem}.json")
+                    for s in territory.switches:
+                        self.assertNotIn(int(s.switch_id), own_switch)
+                        own_switch[int(s.switch_id)] = stem
+                        # Its point is in the territory: the parser insists.
+                    for c in territory.crossings:
+                        self.assertNotIn(int(c.block_id), own_cross)
+                        own_cross[int(c.block_id)] = stem
+                    program = compile_program(
+                        (DATA / "plc" / f"{stem}.plc").read_text())
+                    errors, warnings = check_program(program, territory)
+                    self.assertEqual((errors, warnings), ([], []))
+                    # Every device the wayside owns is driven by its program.
+                    for name in output_names(territory):
+                        self.assertIn(name, program.outputs)
+                        if name.startswith("SIG_") and name.endswith("_R"):
+                            own_signal[int(name.split("_")[1])] = stem
+                    # And it loads the way the host loads it.
+                    controller = HwTrackController()
+                    controller.load_territory(territory)
+                    controller.load_program(
+                        territory.wayside_id,
+                        (DATA / "plc" / f"{stem}.plc").read_text(), stem)
+            self.assertEqual(set(owners), set(rows), line)
+            self.assertEqual(set(own_switch), switches, line)
+            self.assertEqual(set(own_signal), switches, line)
+            self.assertEqual(set(own_cross), crossings, line)
+
+
+class GreenReaders(unittest.TestCase):
+    def test_switches_agree_with_harness_and_software_readers(self) -> None:
+        devices = TrackDevices.load()
+        software = load_layout_file(ROOT / "TrackModel/green_line.json")
+        seen = 0
+        for wayside in loaded("Green").snapshot().waysides:
+            for s in wayside.territory.switches:
+                seen += 1
+                place = devices.by_switch("Green", s.switch_id)
+                self.assertEqual(place.point, s.point)
+                self.assertEqual(
+                    tuple(software.switches[s.switch_id]),
+                    (s.point, s.normal_end, s.reverse_end))
+        self.assertEqual(seen, 6)
+
+
+class GreenBehaviour(unittest.TestCase):
+    # switch id, points, normal leg, reverse leg, a train waiting on the
+    # reverse leg sets reverse by itself (it runs into the points)
+    ROUTES = (("12", "13", "12", "1", True),
+              ("28", "28", "29", "150", True),
+              ("76", "77", "76", "101", False),
+              ("85", "85", "86", "100", True))
+    YARD = (("58", "57"), ("62", "63"))
+
+    def step(self, controller, **kw):
+        out = controller.step(0.1, inputs(controller, **kw))
+        self.assertTrue(out.ready)
+        tm = out.track_model
+        return (
+            {k.block_id: v for k, v in tm.switch_commands.items()},
+            {k.block_id: v for k, v in tm.signal_commands.items()},
+            {k.block_id: v for k, v in tm.track_circuits.items()},
+            {k.block_id: v for k, v in tm.crossing_commands.items()},
+        )
+
+    def scan(self, key, **kw):
+        sw, sig, _, _ = self.step(loaded("Green"), **kw)
+        return sw[key], sig[key]
+
+    def test_empty_line_rests_normal_clear_and_passes_speed(self) -> None:
+        controller = loaded("Green")
+        ids = [str(n) for n in range(1, 151)]
+        sw, sig, circuits, crossings = self.step(
+            controller, suggestions={n: (3, 4) for n in ids})
+        self.assertEqual(set(sw.values()), {"normal"})
+        self.assertEqual(len(sw), 6)
+        self.assertNotIn("red", sig.values())
+        self.assertEqual(len(sig), 6)
+        self.assertFalse(any(crossings.values()))
+        self.assertEqual(set(crossings), {"19", "108"})
+        self.assertEqual(len(circuits), 150)
+        for n, c in circuits.items():
+            self.assertEqual((c.speed_mps, c.authority_blocks), (3, 4), n)
+
+    def test_every_speed_is_capped_on_every_block(self) -> None:
+        controller = loaded("Green")
+        limits = {k.block_id: int(b.speed_limit_mps + 1e-9)
+                  for w in controller.snapshot().waysides
+                  for b in w.territory.blocks for k in [b.key]}
+        for speed in (0, 1, 12, 13, 31):
+            _, _, circuits, _ = self.step(
+                controller,
+                suggestions={n: (speed, 10) for n in limits})
+            for n, c in circuits.items():
+                self.assertEqual(c.speed_mps, min(speed, limits[n]), n)
+
+    def test_crossings_drop_for_own_block_or_either_neighbour(self) -> None:
+        for crossing, near in (("19", ("18", "19", "20")),
+                               ("108", ("107", "108", "109"))):
+            for n in near:
+                _, _, _, x = self.step(loaded("Green"), occupied=[n])
+                self.assertTrue(x[crossing], (crossing, n))
+                self.assertEqual(sum(x.values()), 1)
+
+    def test_cross_wayside_separation_at_every_boundary(self) -> None:
+        # 50|51 Green-1/2, 101|102 Green-2/3, 144|145 Green-3/1.
+        for first, second in (("50", "51"), ("101", "102"), ("144", "145")):
+            sugg = {first: (3, 3), second: (3, 2)}
+            _, _, c, _ = self.step(loaded("Green"), occupied=[first],
+                                   suggestions=sugg)
+            self.assertTrue(all(v.authority_blocks > 0 for v in c.values()))
+            _, _, c, _ = self.step(loaded("Green"), occupied=[first, second],
+                                   suggestions=sugg)
+            self.assertEqual(c[first].authority_blocks, 0, first)
+
+    def test_reverse_leg_train_and_closed_normal_select_reverse(self) -> None:
+        for key, point, normal, reverse, trailing in self.ROUTES:
+            with self.subTest(switch=key):
+                self.assertEqual(self.scan(key)[0], "normal")
+                self.assertEqual(
+                    self.scan(key, occupied=[reverse])[0],
+                    "reverse" if trailing else "normal")
+                self.assertEqual(
+                    self.scan(key, closed=[normal])[0],
+                    "reverse" if trailing else "normal")
+                self.assertEqual(self.scan(
+                    key, occupied=[reverse, normal])[0], "normal")
+                self.assertEqual(self.scan(
+                    key, occupied=[reverse], closed=[reverse])[0], "normal")
+
+    def test_route_requests_and_ctc_commands(self) -> None:
+        for key, point, normal, reverse, _ in self.ROUTES:
+            with self.subTest(switch=key):
+                self.assertEqual(self.scan(
+                    key, route_requests={key: "reverse"})[0], "reverse")
+                self.assertEqual(self.scan(
+                    key, closed=[reverse],
+                    route_requests={key: "reverse"})[0], "normal")
+                self.assertEqual(self.scan(
+                    key, occupied=[point], reported={key: "normal"},
+                    route_requests={key: "reverse"})[0], "normal")
+                self.assertEqual(self.scan(
+                    key, switch_commands={key: "normal"},
+                    route_requests={key: "reverse"})[0], "normal")
+        # 76 leads away from its points: a request never throws it under a
+        # train about to enter from 76.
+        self.assertEqual(self.scan(
+            "76", occupied=["76"], route_requests={"76": "reverse"})[0],
+            "normal")
+
+    def test_ctc_command_and_points_lock_every_switch(self) -> None:
+        points = {k: p for k, p, *_ in self.ROUTES}
+        points.update(dict(self.YARD))
+        for key, point in points.items():
+            for requested in ("normal", "reverse"):
+                opposite = "normal" if requested == "reverse" else "reverse"
+                with self.subTest(switch=key, requested=requested):
+                    self.assertEqual(self.scan(
+                        key, switch_commands={key: requested})[0], requested)
+                    self.assertEqual(self.scan(
+                        key, occupied=[point], reported={key: opposite},
+                        switch_commands={key: requested})[0], opposite)
+
+    def test_yard_switches_move_only_on_command(self) -> None:
+        for key, point in self.YARD:
+            for kw in ({}, {"occupied": [str(int(point) - 1)]},
+                        {"closed": [str(int(point) - 1)]},
+                        {"route_requests": {key: "reverse"}}):
+                self.assertEqual(self.scan(key, **kw)[0], "normal", kw)
+
+    def test_signals_follow_the_reported_route(self) -> None:
+        for key, point, normal, reverse, _ in self.ROUTES:
+            for position, selected, other in (("normal", normal, reverse),
+                                              ("reverse", reverse, normal)):
+                kw = dict(switch_commands={key: position},
+                          reported={key: position})
+                with self.subTest(switch=key, route=position):
+                    self.assertNotEqual(self.scan(key, **kw)[1], "red")
+                    self.assertEqual(
+                        self.scan(key, occupied=[selected], **kw)[1], "red")
+                    self.assertEqual(
+                        self.scan(key, closed=[selected], **kw)[1], "red")
+                    self.assertEqual(
+                        self.scan(key, occupied=[point], **kw)[1], "red")
+                    self.assertNotEqual(
+                        self.scan(key, closed=[other], **kw)[1], "red")
+            # Commanded but not reported: moving or failed.
+            self.assertEqual(self.scan(
+                key, switch_commands={key: "reverse"},
+                reported={key: "normal"})[1], "red")
+        for key, point in self.YARD:
+            kw = dict(switch_commands={key: "reverse"},
+                      reported={key: "reverse"})
+            self.assertNotEqual(self.scan(key, **kw)[1], "red")
+            self.assertEqual(self.scan(key, occupied=[point], **kw)[1], "red")
+
+    def walk(self, key, path, *, normal=True, facing=False, **kw):
+        """One train down ``path``, one block a scan; the switch must hold
+        its position while the train is on its points or listed block and
+        authority must stay with the train throughout."""
+        controller = loaded("Green")
+        want = "normal" if normal else "reverse"
+        point = next(p for k, p, *_ in self.ROUTES + tuple(
+            (k, p) for k, p in self.YARD) if k == key)
+        sugg = {n: (3, 3) for n in path}
+        # A train waiting for a leg is held for the one scan the switch
+        # takes to report (commanded, not yet reported: authority 0).
+        for step, block in enumerate([path[0]] + path):
+            sw, sig, circuits, _ = self.step(
+                controller, occupied=[block], suggestions=sugg, **kw)
+            with self.subTest(switch=key, path=path, at=block):
+                if block in {point, key}:
+                    self.assertEqual(sw[key], want)
+                    if block == point:
+                        self.assertEqual(sig[key], "red")
+                if step == 0 and not normal:
+                    # A train facing the points is not held by a moving
+                    # switch (as on Red); only the blocks it will enter are.
+                    if not facing:
+                        self.assertEqual(circuits[block].authority_blocks, 0)
+                    continue
+                self.assertGreater(circuits[block].authority_blocks, 0)
+                self.assertGreater(circuits[block].speed_mps, 0)
+        sw, *_ = self.step(controller, occupied=[path[-1]])
+        return sw[key]
+
+    def test_trains_walk_through_every_switch(self) -> None:
+        # Through the points on each leg; ends on the far side.
+        for key, normal_path, reverse_path in (
+                ("12", ["14", "13", "12", "11"], ["1", "13", "14"]),
+                ("28", ["27", "28", "29", "30"], ["150", "28", "27"]),
+                ("85", ["84", "85", "86", "87"], ["100", "85", "84"])):
+            self.assertEqual(self.walk(key, normal_path), "normal")
+            self.assertEqual(self.walk(key, reverse_path, normal=False),
+                             "normal")
+        # 76: the reverse leg leaves the points, and only a request throws it.
+        self.assertEqual(self.walk("76", ["75", "76", "77", "78"]), "normal")
+        self.assertEqual(
+            self.walk("76", ["78", "77", "101", "102"], normal=False,
+                      facing=True, route_requests={"76": "reverse"}), "normal")
+        # A train on 101 with nothing requested leaves 76 normal.
+        self.assertEqual(self.scan("76", occupied=["101"])[0], "normal")
+        # Yard switches: through on the main line.
+        self.assertEqual(self.walk("58", ["56", "57", "58", "59"]), "normal")
+        self.assertEqual(self.walk("62", ["61", "62", "63", "64"]), "normal")
+
+    def test_a_moving_switch_holds_every_block_it_touches(self) -> None:
+        for key, point, normal, reverse, _ in self.ROUTES:
+            blocks = {point, key, normal, reverse}
+            controller = loaded("Green")
+            _, _, c, _ = self.step(
+                controller, occupied=[],
+                suggestions={n: (3, 3) for n in blocks},
+                switch_commands={key: "reverse"}, reported={key: "normal"})
+            for n in blocks:
+                self.assertEqual(c[n].authority_blocks, 0, (key, n))
+
+
+if __name__ == "__main__":
+    unittest.main()

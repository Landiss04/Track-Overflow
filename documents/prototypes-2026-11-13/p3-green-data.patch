+"""Generate `<line>_wayside_<n>_integration_test.{json,plc}` from a track layout.
+
+    python TrackCtrlHw/tools/gen_waysides.py Green            # write the files
+    python TrackCtrlHw/tools/gen_waysides.py Red --out /tmp/x # write elsewhere
+
+The database is an exact cut of ``TrackModel/<line>_line.json``. The program
+is the Red integration-test pattern, written once per switch / signal /
+crossing / block from the territory the database parses to. Prototype:
+``--check-red`` compares the output for Red with the committed Red files.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "TrackCtrlHw"))
+
+from track_ctrl_hw.territory import parse_territory  # noqa: E402
+
+DATA = ROOT / "TrackCtrlHw" / "data"
+YARD = "yard"
+
+
+def span(*runs: tuple[int, int]) -> list[int]:
+    return [n for a, b in runs for n in range(a, b + 1)]
+
+
+# Every switch with its point and legs, and every crossing's neighbours,
+# stay inside one wayside, so no read-only neighbour is ever a switch leg.
+# (Red is cut as committed; Green is cut for this property: see notes.)
+CUTS: dict[str, list[list[int]]] = {
+    "Red": [span((1, 24), (73, 76)), span((25, 45), (67, 72)),
+            span((46, 66))],
+    "Green": [span((1, 50), (145, 150)), span((51, 101)),
+              span((102, 144))],
+}
+PROVENANCE = {
+    "Red": "Integration test copy; not Braden's program/database. Replace "
+           "or approve before demonstration. K2/K4, Kevin 2026-10-21.",
+    "Green": "Integration test copy generated from TrackModel/green_line.json "
+             "by TrackCtrlHw/tools/gen_waysides.py; not Braden's "
+             "program/database. Replace or approve before demonstration.",
+}
+
+
+def database(line: str, layout: dict, number: int) -> dict:
+    rows = {b["block_number"]: b for b in layout["blocks"]}
+    return {
+        "line": line,
+        "wayside": f"{line}-{number}",
+        "integration_test_only": True,
+        "provenance": PROVENANCE[line],
+        "blocks": [rows[n] for n in CUTS[line][number - 1]],
+    }
+
+
+def _runs(names: list[str]) -> str:
+    """OCC_1 OCC_2 OCC_3 OCC_7 -> OCC_1..3 OCC_7 (consecutive blocks)."""
+    out, i = [], 0
+    while i < len(names):
+        j = i
+        while (j + 1 < len(names) and _num(names[j + 1]) == _num(names[j]) + 1
+               and _stem(names[j + 1]) == _stem(names[i])):
+            j += 1
+        out.append(names[i] if j == i else f"{names[i]}..{_num(names[j])}")
+        i = j + 1
+    return " ".join(out)
+
+
+def _bits(prefix: str, blocks: list[int]) -> str:
+    """CMD_1_0..4 CMD_2_0..4 ..., six to a line like the Red files."""
+    names = [f"{prefix}_{n}_0..4" for n in blocks]
+    return ("\n" + "VAR_IN  " if prefix == "SPD" else "\nVAR_OUT ").join(
+        " ".join(names[i:i + 6]) for i in range(0, len(names), 6))
+
+
+def _num(name: str) -> int:
+    return int(re.search(r"_(\d+)(?:_\d+)?$", name).group(1))
+
+
+def _stem(name: str) -> str:
+    return name.split("_")[0]
+
+
+def program(line: str, layout: dict, db: dict) -> str:
+    terr = parse_territory(db)
+    own = [int(b.key.block_id) for b in terr.blocks]
+    # Whole-line adjacency, either direction, for the signal look-ahead
+    # and the crossing neighbourhood.
+    adj: dict[str, set[str]] = {}
+    for b in layout["blocks"]:
+        for m in b.get("next_blocks", []):
+            if str(m) != YARD:
+                adj.setdefault(str(b["block_number"]), set()).add(str(m))
+                adj.setdefault(str(m), set()).add(str(b["block_number"]))
+    nxt = {str(b["block_number"]): [str(m) for m in b.get("next_blocks", [])]
+           for b in layout["blocks"]}
+    used: set[str] = set()
+
+    def use(name: str) -> str:
+        used.add(name)
+        return name
+
+    def occ(*ns): return " OR ".join(use(f"OCC_{n}") for n in ns)
+    def closed(n): return use(f"CLOSED_{n}")
+
+    sw = [use(f"SWREV_{s.switch_id}") and s for s in terr.switches]
+    body: list[str] = []
+    for s in sw:
+        i, p, n, r = s.switch_id, s.point, s.normal_end, s.reverse_end
+        yard = r == YARD
+        into = (not yard) and p in nxt.get(r, ())
+        body += ["", f"// Switch {i}: points at {p}, normal leg to {n}, "
+                 f"reverse leg to {r}."]
+        if yard:
+            body += ["// The yard leg is the CTC Office's to choose "
+                     "(maintenance); the", "// program never routes into the "
+                     "yard on its own, nor on a request.",
+                     f"AUTO_{i} := 0"]
+        else:
+            body += ["// The CTC Office's route request picks the leg, never "
+                     "a closed one.",
+                     f"REQ_R_{i} := {use(f'REQSW_{i}')} AND "
+                     f"{use(f'REQREV_{i}')} AND NOT {closed(r)}"]
+            if into:
+                body += [
+                    f"REQ_N_{i} := REQSW_{i} AND NOT REQREV_{i} AND NOT "
+                    f"{closed(n)}",
+                    f"// Without one: reverse for a train waiting on {r}, or "
+                    f"when {n} is", f"// closed; never into a train on {n} or "
+                    f"a closed {r}.",
+                    f"AUTO_{i} := REQ_R_{i} OR (NOT REQ_N_{i} AND NOT "
+                    f"REQ_R_{i} AND ({occ(r)} OR {closed(n)}) AND NOT "
+                    f"{occ(n)} AND NOT {closed(r)})"]
+            else:
+                # Green 76/77: the reverse leg leads away from the points,
+                # so a train on it is not a train coming for reverse.
+                body += [f"// {r} leads away from the points, so a train on "
+                         f"it asks for nothing: only a request",
+                         f"// reverses it, and never under a train about to "
+                         f"enter from {n}.",
+                         f"AUTO_{i} := REQ_R_{i} AND NOT {occ(n)}"]
+        lock = occ(*sorted({int(p), int(i)}))
+        body += [
+            "// The CTC Office's command wins while it sends one "
+            "(maintenance).",
+            f"WANT_{i} := ({use(f'CTCSW_{i}')} AND {use(f'CTCREV_{i}')}) OR "
+            f"(NOT CTCSW_{i} AND AUTO_{i})",
+            f"// A train on {' or '.join(sorted({p, i}, key=int))} locks it "
+            "where it reports.",
+            f"LOCK_{i} := {lock}",
+            f"SW_{i} := (LOCK_{i} AND SWREV_{i}) OR (NOT LOCK_{i} AND "
+            f"WANT_{i})",
+            "// Commanded but not reported: moving or failed. Nothing uses "
+            "its route.",
+            f"BAD_{i} := SW_{i} XOR SWREV_{i}",
+        ]
+    for s in sw:
+        i, p, n, r = s.switch_id, s.point, s.normal_end, s.reverse_end
+        # Look two blocks down the normal leg, away from the points.
+        ahead, prev, cur = [], p, n
+        for _ in range(2):
+            more = sorted(adj.get(cur, set()) - {prev})
+            if len(more) != 1:
+                break
+            ahead.append(more[0])
+            prev, cur = cur, more[0]
+        c1, c2 = (ahead + [None, None])[:2]
+        blocked = f"{occ(p)} OR {closed(p)} OR BAD_{i} OR (NOT SWREV_{i} AND " \
+                  f"({occ(n)} OR {closed(n)}))"
+        if r != YARD:
+            blocked += f" OR (SWREV_{i} AND ({occ(r)} OR {closed(r)}))"
+        caution = f"SWREV_{i} OR CTCSW_{i}" + "".join(
+            f" OR {occ(c1)} OR {closed(c1)}" for _ in [0] if c1)
+        body += [
+            "", f"// Signal {i} guards the points at {p}: red over a busy or "
+            "closed route,",
+            "// yellow on the diverging route, in maintenance or with "
+            f"{c1} busy, green",
+            f"// with a train on {c2}, else super green. Exactly one is lit.",
+            f"BLOCKED_{i} := {blocked}",
+            f"CAUTION_{i} := {caution}",
+            f"SIG_{i}_R := BLOCKED_{i}",
+            f"SIG_{i}_Y := NOT BLOCKED_{i} AND CAUTION_{i}",
+            f"SIG_{i}_G := NOT BLOCKED_{i} AND NOT CAUTION_{i}"
+            + (f" AND {occ(c2)}" if c2 else ""),
+            f"SIG_{i}_SG := NOT BLOCKED_{i} AND NOT CAUTION_{i}"
+            + (f" AND NOT {occ(c2)}" if c2 else ""),
+        ]
+    for c in terr.crossings:
+        near = sorted({int(c.block_id)} | {int(x) for x in adj[c.block_id]})
+        body += ["", f"// Crossing {c.block_id}: lights and gates for a train "
+                 f"on {', '.join(map(str, near))}.",
+                 f"XING_{c.block_id} := {occ(*near)}"]
+
+    body += ["", "// A train keeps its authority while its block is open, no "
+             "switch", "// on its route is moving, and every block it could "
+             "move into is", "// clear. At points only the leg the switch "
+             "reports set counts; a", "// train on a leg is held by a train "
+             "on the points either way."]
+    by_point = {s.point: s for s in sw}
+    for b in terr.blocks:
+        n = b.key.block_id
+        near = []
+        for m in b.next_blocks:
+            if m == YARD:
+                continue
+            s = by_point.get(n)
+            if s and m == s.normal_end:
+                near.append(f"(NOT SWREV_{s.switch_id} AND {occ(m)})")
+            elif s and m == s.reverse_end:
+                near.append(f"(SWREV_{s.switch_id} AND {occ(m)})")
+            else:
+                near.append(occ(m))
+        held = [closed(n)]
+        if near:
+            held.append(f"({occ(n)} AND ({' OR '.join(near)}))")
+        held += [f"BAD_{s.switch_id}" for s in sw
+                 if n in {s.point, s.switch_id, s.normal_end, s.reverse_end}]
+        body.append(f"AUTH_{n} := NOT ({' OR '.join(held)})")
+    body += ["", "// Speed: the CTC Office's suggestion, only with authority. "
+             "The", "// wayside's vital block caps it at each block's limit."]
+    for n in own:
+        for bit in range(5):
+            body.append(f"CMD_{n}_{bit} := AUTH_{n} AND "
+                        f"{use(f'SPD_{n}_{bit}')}")
+
+    key = lambda nm: (_stem(nm), _num(nm))
+    ins = sorted(used, key=key)
+    pick = lambda *pre: [x for x in ins if _stem(x) in pre]
+    outs = [f"AUTH_{n}" for n in own]
+    decl = ["VAR_IN  " + _runs(pick("OCC")), "VAR_IN  " + _runs(pick("CLOSED")),
+            ]
+    per = [x for x in ins if _stem(x) in ("SWREV", "CTCSW", "CTCREV")]
+    per.sort(key=lambda x: (_num(x), ["SWREV", "CTCSW", "CTCREV"].index(
+        _stem(x))))
+    if per:
+        decl.append("VAR_IN  " + " ".join(per))
+    req = sorted(pick("REQSW", "REQREV"),
+                 key=lambda x: (_num(x), _stem(x) != "REQSW"))
+    if req:
+        decl.append("VAR_IN  " + " ".join(req))
+    decl += ["VAR_IN  " + _bits("SPD", own)]
+    decl += ["VAR_OUT " + _runs(outs)]
+    for s in sw:
+        decl.append("VAR_OUT " + " ".join(
+            [f"SW_{s.switch_id}"] + [f"SIG_{s.switch_id}_{a}" for a in
+                                     ("R", "Y", "G", "SG")]))
+    if terr.crossings:
+        decl.append("VAR_OUT " + " ".join(f"XING_{c.block_id}"
+                                          for c in terr.crossings))
+    decl.append("VAR_OUT " + _bits("CMD", own))
+    runs = lambda ns: ", ".join(
+        f"{a}..{b}" if a != b else str(a) for a, b in _spans(ns))
+    head = [
+        f"// {line} line, wayside {db['wayside']}: blocks {runs(own)}.",
+        "// Switches " + ("; ".join(
+            f"{s.switch_id} (points {s.point}: normal {s.normal_end}, "
+            f"reverse {s.reverse_end})" for s in sw) or "none") + ".",
+        "// Crossings: " + (", ".join(c.block_id for c in terr.crossings)
+                            or "none") + ".",
+        "//", "// Generated by TrackCtrlHw/tools/gen_waysides.py from "
+        f"TrackModel/{line.lower()}_line.json.",
+        "// Integration test copy: not Braden's program. After this program "
+        "the wayside", "// scans its read-only vital block, which can only "
+        "restrict these outputs.", ""]
+    return "\n".join(head + decl + body) + "\n"
+
+
+def _spans(ns: list[int]):
+    ns = sorted(ns)
+    i = 0
+    while i < len(ns):
+        j = i
+        while j + 1 < len(ns) and ns[j + 1] == ns[j] + 1:
+            j += 1
+        yield ns[i], ns[j]
+        i = j + 1
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("line", choices=sorted(CUTS))
+    ap.add_argument("--out", type=Path, default=DATA)
+    a = ap.parse_args()
+    layout = json.loads(
+        (ROOT / "TrackModel" / f"{a.line.lower()}_line.json").read_text())
+    for number in range(1, len(CUTS[a.line]) + 1):
+        stem = f"{a.line.lower()}_wayside_{number}_integration_test"
+        db = database(a.line, layout, number)
+        (a.out / "waysides").mkdir(parents=True, exist_ok=True)
+        (a.out / "plc").mkdir(parents=True, exist_ok=True)
+        (a.out / "waysides" / f"{stem}.json").write_text(
+            json.dumps(db, indent=2) + "\n")
+        (a.out / "plc" / f"{stem}.plc").write_text(
+            program(a.line, layout, db))
+
+
+if __name__ == "__main__":
+    main()

@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
participant "Track Controller" as TC
participant "Central harness" as H
participant ":TrackModel" as TM
participant "Train Model" as TRM
TC --> H : WaysideCommands (commanded_speed_mps, authority_blocks per block)
H -> H : track_controller_to_track_model(commands)
H -> TM : step(dt, inputs)
TM -> TM : _validate(dt, inputs)  // known block, finite non-negative speed, whole authority
TM -> TM : _apply_commands(commands)
loop each train on the track
  TM -> TM : _feed(train, report)
  TM -> TM : _track_signal(block_id)
  alt _circuit_dead(block_id), or block not commanded this tick
    TM -> TM : TrackSignal(commanded_speed_mps=0, authority_blocks=0)
  else
    TM -> TM : TrackSignal(this tick's speed, this tick's authority)
  end
end
TM --> H : TrackModelOutputs (train_feeds[train_id].track_signal)
H -> H : track_model_to_train_model(outputs, train_id)
H -> TRM : TrainTrackFeed (track_signal)
@enduml

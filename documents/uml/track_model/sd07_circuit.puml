@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
participant "Track Controller" as TC
participant "Central harness" as H
participant ":TrackModel" as TM
participant "Train Model" as TRM
TC --> H : speed (whole m/s) and authority (blocks) per block
H -> TM : step(dt, inputs)
TM -> TM : _validate()  // known block, whole non-negative numbers
TM -> TM : store speed and authority of each block
loop each train on the track
  TM -> TM : _track_signal(train's block)
  alt circuit failed, or block never commanded
    TM -> TM : TrackSignal(speed 0, authority 0)
  else
    TM -> TM : TrackSignal(stored speed, stored authority)
  end
end
TM --> H : TrainFeed.track_signal per train
H -> TRM : track_model_to_train_model()  // speed and authority of the train's block
@enduml

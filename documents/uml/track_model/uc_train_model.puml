@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
left to right direction
skinparam usecaseBackgroundColor #FFF8DC
skinparam usecaseBorderColor #555555
actor "Train Model" as A
rectangle "Track Model" {
  usecase "UC-3 Track Train Position\nand Occupancy" as UC3
  usecase "UC-7 Deliver Track Circuit Signal\n(Speed, Authority)" as UC7
  usecase "UC-8 Send Beacon Data" as UC8
  usecase "UC-10 Sell Tickets and\nBoard Passengers" as UC10
  usecase "UC-4 Report State to\nTrack Controller" as UC4
  usecase "UC-11 Report Ticket Sales" as UC11
}
A -- UC3
A -- UC7
A -- UC10
UC7 ..> UC8 : <<include>>
UC3 ..> UC4 : <<include>>
UC10 ..> UC11 : <<include>>
@enduml

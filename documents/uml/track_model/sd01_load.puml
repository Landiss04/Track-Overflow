@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
actor "Track Builder" as TB
participant "Track Model window" as W
participant ":TrackModelState" as S
participant ":TrackModel" as TM
participant "layout.py" as L
TB -> W : Load track... (choose a .json file)
W -> S : loadLayout(url)
S -> TM : load_layout_file(path)
TM -> L : line_of_file(path)
L --> TM : line
TM -> L : load_layout(line_paths)
activate L
L -> L : _read_line(data, path)
L -> L : _read_block(line, raw)
L -> L : _read_switches(line, raw_blocks, by_number)
L -> L : _check_directions(line, exits, switches, blocks)
L --> TM : Layout
deactivate L
alt file is valid
  TM -> TM : _adopt(layout)
  TM -> TM : _restart()
  TM --> S : line
  S -> S : linesChanged.emit(), changed.emit()
  S --> W : linesChanged, changed
  W -> TB : line shown, trains cleared
else bad file (LayoutError)
  TM --> S : LayoutError (nothing changed)
  S -> S : _set_load_message(message)
  S --> W : loadMessage
  W -> TB : error shown, old track kept
end
@enduml

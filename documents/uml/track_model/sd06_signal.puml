@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
participant "Track Controller" as TC
participant "Central harness" as H
participant ":TrackModel" as TM
TC --> H : WaysideCommands (signal aspects, crossing gates)
H -> H : track_controller_to_track_model(commands)
H -> TM : step(dt, inputs)
TM -> TM : _validate(dt, inputs)  // unknown signal or crossing: nothing changes
TM -> TM : _apply_commands(commands)
TM -> TM : _controller_outputs()
loop each signal and each crossing
  TM -> TM : _signal_state(block_id)  // RED if the block has a power failure
  TM -> TM : _gate_closed(block_id)  // down if the block has a power failure
end
TM --> H : TrackModelOutputs (signal_states, crossing_states)
H -> H : track_model_to_track_controller(outputs)
H -> TC : step(dt, inputs with TrackReadback)
@enduml

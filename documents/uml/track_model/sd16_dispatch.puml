@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
actor Dispatcher
participant "CTC Office" as CTC
participant "Track Controller" as TC
participant "Track Model" as TM
participant "Train Model" as TRM
participant "Train Controller" as TrC
note over CTC, TrC : Every message passes through the central harness, once per tick.
Dispatcher -> CTC : dispatch_train(train_id, destination)
CTC -> CTC : plan route
loop every tick (dt = 0.1 s)
  CTC -> TC : suggested speed, authority (per block)
  TC -> TC : PLC scan, vital supervisor
  TC -> TM : speed, authority, switches, signals, gates (per block)
  TM -> TM : place trains, set occupancy, build feeds
  TM -> TC : occupancy, switch / signal / gate state, failures
  TC -> CTC : occupancy and device state
  TM -> TRM : track info, speed, authority, beacon, boarded
  TM -> TrC : signal light seen on entering a block
  TM -> CTC : tickets sold this tick
  TRM -> TM : block, offset, speed, doors
  TRM -> TrC : track signal, beacon, speed
  TrC -> TRM : power command, brakes
end
TrC -> TRM : service brake (authority used up)
TRM -> TM : speed 0, doors open at the station
TM -> TRM : passengers boarded
@enduml

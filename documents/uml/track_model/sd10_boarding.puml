@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
participant "Train Model" as TRM
participant "Central harness" as H
participant ":TrackModel" as TM
loop every tick
  TM -> TM : _sell_tickets()  // each station may sell one ticket
  TM -> TM : waiting passengers of the station + 1
end
TRM --> H : speed 0, doors_open, passenger_capacity
H -> TM : step(dt, inputs)
TM -> TM : _board(block, report)
alt station block, speed 0 and a door open
  TM -> TM : boarded = min(waiting, capacity)
  TM -> TM : waiting = waiting - boarded
else
  TM -> TM : boarded = 0
end
TM --> H : TrainFeed.passengers_boarded
H -> TRM : feed with passengers boarded
@enduml

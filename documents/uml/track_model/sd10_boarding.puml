@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
participant "Train Model" as TRM
participant "Central harness" as H
participant ":TrackModel" as TM
TRM --> H : TrainTrackReport (actual_speed_mps = 0, doors_open, passenger_capacity)
H -> H : train_model_to_track_model(reports)
H -> TM : step(dt, inputs)
TM -> TM : _sell_tickets()
note right : each station: _waiting[station] += sold
loop each train on the track
  TM -> TM : _feed(train, report)
  TM -> TM : _board(block, report)
  alt station block, speed 0 and a door open
    TM -> TM : boarded = min(_waiting[station], passenger_capacity)
    TM -> TM : _waiting[station] -= boarded
  else
    TM -> TM : return 0
  end
end
TM --> H : TrackModelOutputs (train_feeds[train_id].passengers_boarded)
H -> H : track_model_to_train_model(outputs, train_id)
H -> TRM : TrainTrackFeed (passengers_boarded)
@enduml

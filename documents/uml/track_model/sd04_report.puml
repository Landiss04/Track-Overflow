@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
participant "Central harness" as H
participant ":TrackModel" as TM
participant "Track Controller" as TC
participant "CTC Office" as CTC
H -> TM : step(dt, inputs)
TM -> TM : _controller_outputs()  // actual state of every device
TM --> H : TrackControllerOutputs (occupancy, switches, gates, signals,\nfailures, heaters, track temperature)
H -> H : track_model_to_track_controller()
H -> TC : step(dt, inputs with the read-back)
TC --> H : report per wayside
H -> CTC : occupancy and device state (through the Track Controller)
note over TM : A failure injected between ticks\nrebuilds the read-back at once.
@enduml

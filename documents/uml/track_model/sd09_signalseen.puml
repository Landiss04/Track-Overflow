@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
participant "Central harness" as H
participant ":TrackModel" as TM
participant "Train Controller" as TC
H -> TM : step(dt, inputs)
loop each train on the track
  TM -> TM : _signal_seen(train)
  alt train.entered_this_tick and the block has a signal
    TM -> TM : _signal_state(block_id)  // commanded aspect, RED without power
  else
    TM -> TM : return None
  end
end
TM --> H : TrackModelOutputs (signal_seen[train_id])
H -> H : track_model_to_train_controller(outputs, train_id)
H -> TC : step(dt, inputs with signal_light_ahead)  // sent directly, kept by the Train Controller
@enduml

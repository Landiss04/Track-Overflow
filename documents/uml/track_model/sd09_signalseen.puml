@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
participant "Central harness" as H
participant ":TrackModel" as TM
participant "Train Controller" as TC
H -> TM : step(dt, inputs)
loop each train on the track
  TM -> TM : _signal_seen(train)
  alt train entered a block with a signal this tick
    TM -> TM : _signal_state(block)  // commanded aspect, RED without power
  else
    TM -> TM : none
  end
end
TM --> H : signal_seen per train
H -> H : track_model_to_train_controller()
H -> TC : step(dt, signal light seen)  // sent directly, kept by the Train Controller
@enduml

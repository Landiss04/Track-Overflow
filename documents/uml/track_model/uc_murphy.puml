@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
left to right direction
skinparam usecaseBackgroundColor #FFF8DC
skinparam usecaseBorderColor #555555
actor "Murphy" as A
rectangle "Track Model" {
  usecase "UC-12 Set Ambient Temperature" as UC12
  usecase "UC-13 Switch Track Heaters" as UC13
  usecase "UC-14 Inject or Clear Failure" as UC14
  usecase "UC-3 Track Train Position\nand Occupancy" as UC3
}
A -- UC12
A -- UC14
UC12 ..> UC13 : <<include>>
UC14 ..> UC3 : <<extend>>
@enduml

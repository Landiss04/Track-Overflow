@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
left to right direction
skinparam usecaseBackgroundColor #FFF8DC
skinparam usecaseBorderColor #555555
actor "Track Controller" as A
rectangle "Track Model" {
  usecase "UC-4 Report State to\nTrack Controller" as UC4
  usecase "UC-5 Apply Switch Position" as UC5
  usecase "UC-6 Apply Signal Lights\nand Crossing Gates" as UC6
  usecase "UC-7 Deliver Track Circuit Signal\n(Speed, Authority)" as UC7
  usecase "UC-8 Send Beacon Data" as UC8
}
A -- UC4
A -- UC5
A -- UC6
A -- UC7
UC7 ..> UC8 : <<include>>
@enduml

@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
participant "Train Model" as TRM
participant "Central harness" as H
participant ":TrackModel" as TM
participant ":Layout" as L
TRM --> H : TrainTrackReport (block, offset_m, speed)
H -> H : train_model_to_track_model(reports)
H -> TM : step(dt, inputs)
TM -> TM : _validate(dt, inputs)
TM -> TM : _move_trains(reports)
loop each train on the track
  TM -> TM : _advance(train_id, train, offset_m)  // offset_m = offset + carry_m
  alt offset_m >= block length
    TM -> L : next_block(block_id, previous_block_id, switch_states)
    L --> TM : block_id (None = yard, same block = dead end)
    TM -> TM : _carry_into(train, offset_in_left_m)
  else offset_m < 0 (rolling back)
    TM -> L : previous_block(block_id, previous_block_id)
    L --> TM : block_id
    TM -> TM : _behind(target, old)
    TM -> TM : _carry_into(train, offset_in_left_m)
  else still inside the block
    TM -> TM : return (no change)
  end
end
TM -> TM : _controller_outputs()
TM --> H : TrackModelOutputs (block_occupancy, train_feeds)
H -> H : track_model_to_train_model(outputs, train_id)
H -> TRM : TrainTrackFeed (the Train Model resets its offset to 0)
@enduml

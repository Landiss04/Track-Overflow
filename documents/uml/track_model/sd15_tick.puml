@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
participant "Central harness" as H
participant ":TrackModel" as TM
participant ":Layout" as L
H -> TM : step(dt, TrackModelInputs)
activate TM
TM -> TM : _validate(dt, inputs)
alt invalid input
  TM --> H : InvalidInputError (nothing changed)
else valid
  TM -> TM : _apply_commands(controller)  // switch moves unless its block has no power
  TM -> TM : _update_track_temps(dt)
  loop each train report
    TM -> TM : _move_trains() / _advance()
    TM -> L : next_block(block, came_from, switches)
    L --> TM : block, YARD or same block
  end
  TM -> TM : _sell_tickets()
  loop each train
    TM -> TM : _feed(train, report)  // track info, signal, beacon, boarding
  end
  TM -> TM : _controller_outputs(), _ctc_outputs(), _signal_seen()
  TM --> H : TrackModelOutputs
end
deactivate TM
@enduml

@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
participant "Central harness" as H
participant ":ModuleLink" as ML
participant ":TrackModelProcess" as P
participant "wire" as W
participant ":TrackModel" as TM
participant ":Layout" as L
H -> ML : STEP message (tick, dt, sim time, inputs as JSON)
ML -> P : step(tick, dt, sim_time_s, inputs)
P -> W : decode_inputs(inputs, sim_time_s)
W --> P : TrackModelInputs
P -> TM : step(dt, TrackModelInputs)
activate TM
TM -> TM : _validate(dt, inputs)
alt invalid input
  TM --> P : InvalidInputError (nothing changed)
  P --> ML : TickRejectedError
  ML --> H : tick refused, logged
else valid
  TM -> TM : _apply_commands(controller)  // switch moves unless its block has no power
  TM -> TM : _update_track_temps(dt)
  loop each train report
    TM -> TM : _move_trains() / _advance()
    TM -> L : next_block(block, came_from, switches)
    L --> TM : block, YARD or same block
  end
  TM -> TM : _sell_tickets()
  loop each train
    TM -> TM : _feed(train, report)  // track info, signal, beacon, boarding
  end
  TM -> TM : _controller_outputs(), _ctc_outputs(), _signal_seen()
  TM --> P : TrackModelOutputs
  P -> W : encode_outputs(outputs)
  P --> ML : outputs as JSON
  ML --> H : reply
  P -> P : mark_step(), redraw the window (at most every 100 ms)
end
deactivate TM
@enduml

@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
left to right direction
skinparam usecaseBackgroundColor #FFF8DC
skinparam usecaseBorderColor #555555
actor "Track Builder" as TB
actor "Murphy" as MU
actor "Track Controller" as TC
actor "Train Model" as TRM
actor "Train Controller" as TRC
actor "CTC Office" as CTC
rectangle "Track Model" {
  usecase "UC-1 Load Track Layout" as UC1
  usecase "UC-2 Display Track Properties" as UC2
  usecase "UC-3 Track Train Position\nand Occupancy" as UC3
  usecase "UC-4 Report State to\nTrack Controller" as UC4
  usecase "UC-5 Apply Switch Position" as UC5
  usecase "UC-6 Apply Signal Lights\nand Crossing Gates" as UC6
  usecase "UC-7 Deliver Track Circuit\nSignal (Speed, Authority)" as UC7
  usecase "UC-8 Send Beacon Data" as UC8
  usecase "UC-9 Send Signal Light\nto Train Controller" as UC9
  usecase "UC-10 Sell Tickets and\nBoard Passengers" as UC10
  usecase "UC-11 Report Ticket Sales" as UC11
  usecase "UC-12 Set Ambient Temperature" as UC12
  usecase "UC-13 Switch Track Heaters" as UC13
  usecase "UC-14 Inject or Clear Failure" as UC14
}
TB --> UC1
TB --> UC2
MU --> UC12
MU --> UC14
TC --> UC5
TC --> UC6
TC --> UC7
UC4 --> TC
TRM --> UC3
TRM --> UC10
UC7 --> TRM
UC8 --> TRM
UC10 --> TRM
UC9 --> TRC
UC11 --> CTC
UC1 ..> UC2 : <<include>>
UC3 ..> UC4 : <<include>>
UC7 ..> UC8 : <<include>>
UC10 ..> UC11 : <<include>>
UC12 ..> UC13 : <<include>>
UC14 ..> UC3 : <<extend>>
@enduml

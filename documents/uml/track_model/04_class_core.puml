@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFFBE6
skinparam classBorderColor #555555
hide empty members
skinparam nodesep 40
skinparam ranksep 55
class TrackModel <<model.py>> {
  +config : TrackConfig
  -_blocks : dict[str, Block]
  -_switch_cmd, _switches : dict[str, SwitchPosition]
  -_signal_cmd, _crossing_cmd : dict
  -_failures : dict[str, TrackFailure]
  -_commanded_speed : dict[str, float]  // this tick only
  -_authority : dict[str, int]  // this tick only
  -_trains : dict[str, _Train]
  -_waiting : dict[str, int]
  -_track_temp_c : dict[str, float]
  +step(dt, inputs) : TrackModelOutputs
  +snapshot() : TrackModelSnapshot
  +set_block_failure(block_id, failure) : None
  +set_ambient_temp(temp_c) : None
  +load_layout_file(path) : str
  -_adopt(layout) : None
  -_restart() : None
  -_validate(dt, inputs) : None
  -_apply_commands(commands) : None
  -_update_track_temps(dt) : None
  -_move_trains(reports) : None
  -_advance(train_id, train, offset_m) : None
  -_carry_into(train, offset_in_left_m) : float
  -_sell_tickets() : dict[str, int]
  -_board(block, report) : int
  -_feed(train, report) : TrainFeed
  -_track_signal(block_id) : TrackSignal
  -_signal_state(block_id) : SignalAspect
  -_gate_closed(block_id) : bool
  -_heater_on(section_id) : bool
  -_signal_seen(train) : SignalAspect | None
  -_controller_outputs() : TrackControllerOutputs
  -_ctc_outputs() : CtcOutputs
}
class _Train <<private dataclass>> {
  +block_id : str
  +previous_block_id : str | None
  +polarity : bool
  +offset_m : float
  +carry_m : float
  +actual_speed_mps : float
  +entered_this_tick : bool
}
class Layout <<frozen dataclass>> {
  +blocks : Mapping[str, Block]
  +switches : Mapping[str, Switch]
  +neighbours : Mapping[str, frozenset[str]]
  +signal_block_ids : tuple[str, ...]
  +beacons : Mapping[str, Beacon]
  +next_block(block_id, came_from, switch_states) : str | None
  +previous_block(block_id, came_from) : str
}
class Block <<frozen dataclass>> {
  +block_id : str
  +line : str
  +section : str
  +number : int
  +length_m : float
  +grade_deg : float
  +speed_limit_mps : float
  +elevation_m : float
  +station_name : str | None
  +platform_side : str | None
  +underground : bool
  +has_crossing : bool
  +next_block_ids : tuple[str | None, ...]
  +bidirectional : bool
  +section_id : str
}
class Switch <<frozen dataclass>> {
  +switch_id : str
  +point_block_id : str
  +normal_block_id : str | None
  +reverse_block_id : str | None
  +from_yard : bool
}
class TrackConfig <<frozen dataclass>> {
  +layout_paths : tuple[str, ...]
  +ticket_probability : float
  +seed : int
}
class "layout.py\n<<module functions>>" as LF {
  load_layout(paths) : Layout
  line_of_file(path) : str
}
class TrackModelError <<Exception>>
class InvalidInputError <<Exception>>
class UnknownIdError <<Exception>>
class LayoutError <<Exception>>
TrackModel "1" *-- "0..*" _Train
TrackModel "1" --> "1" Layout
TrackModel --> TrackConfig
TrackModel ..> LF : uses
LF ..> Layout : builds
Layout "1" *-- "1..*" Block
Layout "1" *-- "0..*" Switch
TrackModelError <|-- InvalidInputError
InvalidInputError <|-- UnknownIdError
TrackModelError <|-- LayoutError
@enduml

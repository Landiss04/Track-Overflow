@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
participant ":TrackModel" as TM
participant "Central harness" as H
participant "CTC Office" as CTC
H -> TM : step(dt, inputs)
TM -> TM : _sell_tickets()
TM -> TM : _ctc_outputs()
TM --> H : TrackModelOutputs.ctc (CtcOutputs.tickets_sold_now)
H -> H : track_model_to_ctc_office(outputs)
H -> CTC : step(dt, inputs with TicketSales)  // direct, no running total
@enduml

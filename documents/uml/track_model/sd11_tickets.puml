@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
participant ":TrackModel" as TM
participant "Central harness" as H
participant "CTC Office" as CTC
TM -> TM : _sell_tickets()  // tickets sold this tick, by station
TM --> H : CtcOutputs.tickets_sold_now
H -> H : track_model_to_ctc_office()  // (count, station) pairs
H -> CTC : step(dt, inputs with ticket sales)  // direct, no running total
@enduml

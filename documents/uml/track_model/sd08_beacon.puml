@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
participant "Central harness" as H
participant ":TrackModel" as TM
participant ":Layout" as L
participant "Train Model" as TRM
H -> TM : step(dt, inputs)
loop each train on the track
  TM -> TM : _feed(train, report)
  TM -> L : beacons.get(block_id)
  alt block next to a station
    L --> TM : Beacon (station_name, platform_side, underground)
  else
    L --> TM : None
  end
end
TM --> H : TrackModelOutputs (train_feeds[train_id].beacon)
H -> H : track_model_to_train_model(outputs, train_id)
H -> TRM : TrainTrackFeed (beacon)
@enduml

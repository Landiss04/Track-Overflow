@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #E8F1FB
skinparam classBorderColor #555555
hide empty members
skinparam nodesep 45
skinparam ranksep 55
interface "TrackModel\n<<Protocol, interface.py>>" as P {
  +step(dt : float, inputs : TrackModelInputs) : TrackModelOutputs
  +snapshot() : TrackModelSnapshot
  +set_block_failure(block_id : str, failure : TrackFailure) : None
  +set_ambient_temp(temp_c : float) : None
  +load_layout_file(path : str) : str
  +edit_block(block_id : str, edit : BlockEdit) : None
  +reset() : None
}
class "TrackModel\n<<model.py>>" as M
class "track_model_edges\n<<pure functions, common/harness>>" as E {
  track_controller_to_track_model(commands) : TrackControllerCommands
  train_model_to_track_model(reports) : dict[str, TrainReport]
  track_model_to_track_controller(outputs) : TrackReadback
  track_model_to_train_model(outputs, train_id) : TrainTrackFeed
  track_model_to_train_controller(outputs, train_id) : SignalAspect
  track_model_to_ctc_office(outputs) : TicketSales
}
class "Central harness" as H
P <|.. M
H --> P : step() every tick
H ..> E : maps each edge
note right of P : edit_block and reset are\ntest-only. snapshot, set_block_failure,\nset_ambient_temp and load_layout_file\nserve the Track Model window.
@enduml

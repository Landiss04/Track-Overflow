@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
participant "Track Controller" as TC
participant "Central harness" as H
participant ":TrackModel" as TM
TC --> H : switch commands {switch: NORMAL or REVERSE}
H -> H : track_controller_to_track_model()
H -> TM : step(dt, inputs)
TM -> TM : _validate()  // unknown switch: UnknownIdError, nothing changes
loop each commanded switch
  alt the switch block has a power failure
    TM -> TM : keep the actual position
  else
    TM -> TM : actual position = commanded position
  end
end
TM --> H : switch_states (actual positions)
H -> TC : read-back through track_model_to_track_controller()
@enduml

@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
participant "Track Controller" as TC
participant "Central harness" as H
participant ":TrackModel" as TM
TC --> H : WaysideCommands (switch commands {switch: NORMAL or REVERSE})
H -> H : track_controller_to_track_model(commands)
H -> TM : step(dt, inputs)
TM -> TM : _validate(dt, inputs)  // unknown switch: UnknownIdError, nothing changes
TM -> TM : _apply_commands(commands)
loop each commanded switch
  TM -> TM : _powered_off(block_id)
  alt the switch block has a power failure
    TM -> TM : keep the actual position
  else
    TM -> TM : _switches[switch_id] = commanded position
  end
end
TM -> TM : _controller_outputs()
TM --> H : TrackModelOutputs (switch_states)
H -> H : track_model_to_track_controller(outputs)
H -> TC : step(dt, inputs with TrackReadback)
@enduml

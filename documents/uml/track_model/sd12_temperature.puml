@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
actor Murphy
participant "Track Model window" as W
participant ":TrackModelState" as S
participant ":TrackModel" as TM
Murphy -> W : type the ambient temperature (deg F)
W -> S : setAmbientF(temp_f)
S -> S : temp_c = (temp_f - 32) * 5 / 9
S -> TM : set_ambient_temp(temp_c)
TM -> TM : the window is the source (the harness sends none);\na value set here is kept until the module restarts
S -> W : refresh (ambient temperature shown)
@enduml

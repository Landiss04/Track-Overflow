@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
actor Murphy
participant "Track Model window" as W
participant ":TrackModelState" as S
participant ":TrackModel" as TM
Murphy -> W : type the ambient temperature (deg F)
W -> S : setAmbientF(temp_f)
S -> TM : set_ambient_temp(temp_c)  // temp_c = (temp_f - 32) * 5 / 9
TM -> TM : _ambient_override_c = temp_c  // kept until the module restarts
S -> S : refresh()
S -> TM : snapshot()
TM --> S : TrackModelSnapshot (ambient_temp_c)
S --> W : changed
W -> Murphy : ambient temperature shown
@enduml

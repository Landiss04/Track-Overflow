@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #E8F1FB
skinparam classBorderColor #555555
hide empty members
skinparam nodesep 45
skinparam ranksep 60
interface "TrackModel\n<<Protocol>>" as P
class TrackModelState <<QObject, ui bridge>> {
  +running : bool
  +elapsed : str
  +blockRows : list
  +switchRows : list
  +signalRows : list
  +sectionRows : list
  +trainRows : list
  +stationRows : list
  +selectedDetails : list
  +refresh() : None
  +selectBlock(block_id) : None
  +setSelectedFailure(name) : None
  +setAmbientF(temp_f) : None
  +loadLayout(url) : None
}
class LinkServer <<QObject, test_link>> {
  +listen() : bool
  +notify_outputs() : None
  +close() : None
}
class LinkClient <<QObject, test_link>> {
  +connect_to_server() : None
  +step(dt, inputs) : bool
  +set_block_failure(block_id, failure) : bool
  +reset() : bool
}
class TrackModelTestHarness <<QObject, test_ui>> {
  +setRunning(running) : None
  +setFast(fast) : None
  +addTrain(train_id, block_id) : None
  +stepOnce() : None
}
class "codec\n<<test_link/codec.py>>" as CD {
  encode_inputs(inputs) : Json
  decode_inputs(data) : TrackModelInputs
  encode_outputs(outputs) : Json
  decode_outputs(data) : TrackModelOutputs
}
TrackModelState --> P : snapshot(), actions
LinkServer --> P : step(), edit_block(), reset()
LinkServer ..> CD
LinkClient ..> CD
LinkClient --> LinkServer : local socket,\nJSON lines
TrackModelTestHarness --> LinkClient
LinkServer ..> TrackModelState : changed, stepped
@enduml

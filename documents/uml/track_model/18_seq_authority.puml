@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
participant "CTC Office" as CTC
participant "Central harness" as H
participant "Track Controller" as TC
participant "Track Model" as TM
participant "Train Model" as TRM
participant "Train Controller" as TrC
H -> CTC : step(dt, inputs)
CTC --> H : suggested speed and authority per block
H -> TC : step(dt, inputs)
activate TC
TC -> TC : PLC scan, vital supervisor
TC --> H : WaysideCommands (speed and authority per block, switch, signal, crossing commands)
deactivate TC
H -> H : track_controller_to_track_model(commands)
H -> TM : step(dt, inputs)
activate TM
TM -> TM : _validate(dt, inputs)
TM -> TM : _apply_commands(commands)
TM -> TM : _move_trains(reports)
TM -> TM : _feed(train, report)
TM --> H : TrackModelOutputs
deactivate TM
H -> H : track_model_to_train_model(outputs, train_id)
H -> TRM : step(dt, inputs with TrainTrackFeed)  // speed and authority of the train's block
H -> H : track_model_to_train_controller(outputs, train_id)
H -> TrC : step(dt, inputs with signal_light_ahead)
TRM --> H : TrainTrackReport (block, offset_m, speed, doors)  // used by the next tick
@enduml

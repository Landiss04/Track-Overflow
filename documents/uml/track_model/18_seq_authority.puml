@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
participant "CTC Office" as CTC
participant "Central harness" as H
participant "Track Controller" as TC
participant "Track Model" as TM
participant "Train Model" as TRM
participant "Train Controller" as TrC
H -> CTC : step(dt, inputs)
CTC --> H : suggested speed and authority per block
H -> TC : step(dt, inputs)
activate TC
TC -> TC : PLC scan, vital supervisor
TC --> H : speed and authority per block, switch, signal, crossing commands
deactivate TC
H -> H : track_controller_to_track_model()
H -> TM : step(dt, TrackModelInputs)
activate TM
TM -> TM : validate, store commands, move trains
TM --> H : TrackModelOutputs
deactivate TM
H -> H : track_model_to_train_model(), track_model_to_train_controller()
H -> TRM : step(dt, feed with speed and authority of the train's block)
H -> TrC : step(dt, signal light seen)
TRM --> H : block, offset, speed, doors (used by the next tick)
@enduml

@startuml
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam BackgroundColor white
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 20
autonumber
actor Murphy
participant "Track Model window" as W
participant ":TrackModelState" as S
participant ":TrackModel" as TM
participant "Central harness" as H
Murphy -> W : select a block, choose BROKEN_RAIL / TRACK_CIRCUIT / POWER (or NONE to clear)
W -> S : selectBlock(block_id)
W -> S : setSelectedFailure(name)
S -> TM : set_block_failure(block_id, failure)
TM -> TM : _failures[block_id] = failure
S -> S : refresh()
S --> W : changed
W -> Murphy : block shown as failed
... next tick ...
H -> TM : step(dt, inputs)
TM -> TM : _circuit_dead(block_id)  // block reads occupied, track circuit dead
TM -> TM : _powered_off(block_id)  // POWER only: switch held, light RED, gates down, heaters off
TM -> TM : _controller_outputs()
TM --> H : TrackModelOutputs (block_occupancy, failure_status, train_feeds with speed 0, authority 0)
@enduml

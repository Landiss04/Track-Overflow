@startuml sd14_track_circuits
!include ../style.iuml
autonumber

participant "Wayside" as W
participant "PLC (user program\n+ vital block)" as PLC
participant "Central\nHarness" as H
participant "Track Model" as TM
participant "Train Model" as TrM
participant "Train Controller" as TC

W -> PLC : scan both channels\n(SPD_n_0..4, OCC, CLOSED, ...)
PLC --> W : AUTH_n, CMD_n_0..4
loop every block n with a suggestion
  W -> W : speed = Σ CMD_n_b × 2^b (whole m/s)
  W -> W : authority = CTC count if AUTH_n,\nelse 0
end
W --> H : track_circuits {block: (speed, authority)}
H -> TM : (tick k+1) per-block command
TM -> TrM : track signal to the train in the block
TM -> TM : clear the block's values to zero
TrM -> TC : commanded speed and authority
note over W, PLC
  The program caps speed at the block's limit and ANDs every
  CMD bit with AUTH_n, so withheld authority sends no speed.
end note
@enduml

@startuml class_core_control
!include ../style.iuml
hide empty members
left to right direction

package "track_ctrl_hw (Qt-free core): control" {
  interface TrackController <<Protocol>> {
    +step(dt: float, inputs: TrackControllerInputs): TrackControllerOutputs
    +snapshot(): TrackControllerSnapshot
    +load_territory(territory: Territory): tuple[str]
    +load_program(wayside_id: str, source: str, file_name: str): ProgramInfo
    +reset(): None
  }

  class PiLinkServer <<planned>> {
    -_port: serial device /dev/ttyGS0
    -_controller: HwTrackController
    +serve(): None
    -_handle(request: dict): dict
  }

  class HwTrackController {
    -_waysides: dict[str, Wayside]
    -_time_s: float | None
    -_ticks: int
    +line: str | None
    +wayside_ids: tuple[str]
    +ticks: int
    +not_ready_reasons(): tuple[str]
    +step(dt, inputs): TrackControllerOutputs
    +snapshot(): TrackControllerSnapshot
    +load_territory(territory): tuple[str]
    +load_program(wayside_id, source, file_name): ProgramInfo
    +reset(): None
  }

  class Wayside {
    -_territory: Territory
    -_program: Program | None
    -_vital: Program <<planned>>
    -_program_info: ProgramInfo | None
    -_scan_info: ScanInfo
    -_commanded: dict[BlockKey, SwitchPosition]
    -_circuits: dict[BlockKey, TrackCircuitCommand]
    -_holding: str
    +territory: Territory
    +program: Program | None
    +not_ready_reason: str
    +owns(key: BlockKey): bool
    +load_program(source, file_name, time_s): ProgramInfo
    +adopt_program(previous: Wayside): bool
    +scan(dt, time_s, ctc, track_model, stall): WaysideScan
    +snapshot(): WaysideSnapshot
    +reset(): None
    -_run_program(...): dict[str, bool] | None
    -_drive(values): None
    -_hold_restrictive(reason: str): None
  }

  class WaysideScan {
    +track_circuits: dict[BlockKey, TrackCircuitCommand]
    +switch_commands: dict[BlockKey, SwitchPosition]
    +crossing_commands: dict[BlockKey, bool]
    +signal_commands: dict[BlockKey, SignalAspect]
    +report: CtcReport
  }

  class Program
  note right of Program : see PLC engine

  class wire <<module>> {
    +inputs_to_wire / inputs_from_wire
    +outputs_to_wire / outputs_from_wire
    +territory_to_wire / territory_from_wire
    +snapshot_to_wire / snapshot_from_wire <<planned>>
  }

  class territory <<module>> {
    +load_territory_file(path): Territory
    +parse_territory(data): Territory
    +parse_switch(key, text, ids): Switch
  }

  class TrackControllerError
  class TerritoryError
  class PlcError {
    +diagnostics: tuple[str]
  }
  class InvalidTimeStepError
  class InvalidInputError
  class WireFormatError
}

PiLinkServer --> HwTrackController : drives
PiLinkServer ..> wire
HwTrackController ..|> TrackController
HwTrackController "1" *-- "1..*" Wayside : runs >
Wayside --> "0..1" Program : user program
Wayside ..> "1" Program : vital block <<planned>>
Wayside ..> WaysideScan : returns

TrackControllerError <|-- TerritoryError
TrackControllerError <|-- PlcError
TrackControllerError <|-- InvalidTimeStepError
TrackControllerError <|-- InvalidInputError
TrackControllerError <|-- WireFormatError
territory ..> TerritoryError : raises
@enduml

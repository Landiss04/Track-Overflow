@startuml class_boundary_territory
!include ../style.iuml
hide empty members
left to right direction

package "Identity and territory" {
  class BlockKey <<frozen>> {
    +line: str
    +section: str
    +block_id: str
    +label: str
    +ref: BlockRef
  }
  class BlockRef <<frozen>> {
    +line: str
    +block_id: str
    +label: str
  }
  class Block <<frozen>> {
    +key: BlockKey
    +length_m: float
    +speed_limit_mps: float
  }
  class Switch <<frozen>> {
    +key: BlockKey
    +point: str
    +normal_end: str
    +reverse_end: str
    +switch_id: str
  }
  class Territory <<frozen>> {
    +line: str
    +wayside_id: str
    +blocks: tuple[Block]
    +switches: tuple[Switch]
    +crossings: tuple[BlockKey]
  }
  enum SwitchPosition {
    normal
    reverse
  }
  enum SignalAspect {
    red
    yellow
    green
    super_green
  }
}

Territory *-- "1..*" Block
Territory *-- "*" Switch
Block --> BlockKey
Switch --> BlockKey
BlockKey ..> BlockRef : ref
@enduml

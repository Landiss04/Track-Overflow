@startuml sd13_crossings
!include ../style.iuml
autonumber

participant "Wayside" as W
participant "PLC (user program\n+ vital block)" as PLC
participant "Central\nHarness" as H
participant "Track Model" as TM

W -> PLC : scan both channels
alt a train on the crossing's block or beside it
  PLC --> W : XING_c = 1
else clear
  PLC --> W : XING_c = 0
end
W -> W : crossing_commands[c] = XING_c
W --> H : outputs (tick k)
H -> TM : (tick k+1) lights on and gates down,\nor off and up
TM --> H : crossings_active read-back
H -> W : (next tick) read-back kept\nfor the CTC report
@enduml

@startuml sd01_load_database
!include ../style.iuml
autonumber

actor Programmer as P
participant "Main window\n(QML)" as QML
participant "TrackControllerState" as State
participant "territory" as Terr
participant "RemoteTrackController" as Remote
participant "HardwareRelay\n+ SerialTransport" as Relay
box "Raspberry Pi 5" #F2F5F9
participant "PiLinkServer\n+ TrackCore" as Pi
participant "HwTrackController" as Ctrl
end box

P -> QML : **Load database**, pick a file
QML -> State : loadDatabase(url)
State -> Terr : load_territory_file(path)
alt unreadable or malformed
  Terr --> State : TerritoryError
  State --> QML : problem("Database not loaded")
else valid
  Terr --> State : Territory
  State -> Remote : load_territory(territory)
  Remote -> Relay : call_action("load_territory",\nterritory_to_wire)
  Relay -> Pi : ACTION over USB
  Pi -> Ctrl : load_territory(territory)
  alt another line, or a block\nanother wayside governs
    Ctrl --> Pi : TerritoryError
    Pi --> Relay : refused, with reason
    Relay --> Remote : RemoteActionError
    Remote --> State : TerritoryError
    State --> QML : problem("Database not loaded")
  else accepted
    Ctrl -> Ctrl : add or replace the wayside;\nkeep its program if it fits
    Ctrl --> Pi : notices
    Pi --> Relay : ACK + VIEW (packed snapshot)
    Relay --> Remote : viewChanged: cache snapshot
    Relay --> State : refresh()
    State --> QML : wayside listed, **Not ready**
  end
end
@enduml

@startuml sd01_load_database
!include ../style.iuml
autonumber

actor Programmer as P
participant "Main window\n(QML)" as QML
participant "TrackControllerState" as State
participant "territory" as Terr
participant "RemoteTrackController" as Remote
participant "HardwareRelay" as Relay
box "Raspberry Pi 5" #F2F5F9
participant "PiLinkServer\n+ TrackCore" as Pi
participant "HwTrackController" as Ctrl
participant "Wayside" as W
end box

P -> QML : **Load database**, pick a file
QML -> State : loadDatabase(location)
State -> Terr : load_territory_file(path)
alt unreadable or malformed
  Terr --> State : raise TerritoryError(reason)
  State --> QML : problem.emit("Database not loaded",\nstr(error), [])
else valid
  Terr --> State : territory: Territory
  State -> Remote : load_territory(territory)
  Remote -> Relay : call_action("load_territory",\n{"territory": territory_to_wire(territory)})
  Relay -> Pi : ACTION {id, action, args} (USB)
  Pi -> Ctrl : core.action(): load_territory(\nterritory_from_wire(args["territory"]))
  alt territory.line != line, or another\nwayside owns(key) for a block
    Ctrl --> Pi : raise TerritoryError(reason)
    Pi --> Relay : REJECTED {id, reason, error}
    Relay --> Remote : raise RemoteActionError(reason)
    Remote --> State : raise TerritoryError(reason)
    State --> QML : problem.emit("Database not loaded",\nstr(error), [])
  else accepted
    Ctrl -> W : Wayside(territory)
    opt the replaced wayside had a program
      Ctrl -> W : adopt_program(previous)
      W --> Ctrl : kept: bool (False adds a notice)
    end
    Ctrl -> Ctrl : self._waysides[wayside_id] = wayside
    Ctrl --> Pi : notices: tuple[str]
    Pi --> Relay : ACK {id, result=notices,\nview={"snapshot": pack(snapshot())}}
    Relay -> Remote : viewChanged.emit(view)\n→ _view(): self._snapshot = unpack(...)
    Relay --> Remote : reply["result"]
    Remote --> State : notices
    State -> State : self._selected = wayside_id;\nrefresh()
    State --> QML : changed.emit();\nnotice.emit("PLC program unloaded", msg)\nfor each notice
  end
end
@enduml

@startuml sd15_report
!include ../style.iuml
autonumber

participant "Wayside ×N" as W
participant "HwTrackController\n(on the Pi)" as Ctrl
participant "Central\nHarness" as H
participant "CTC Office" as CTC
actor Dispatcher as D

loop every wayside, every scan
  W -> W : CtcReport: wayside, line, time,\nready + reason; per block: occupied,\nswitch, signal and crossing read-back
  W --> Ctrl : report
end
Ctrl --> H : ctc_reports (tick k outputs)
H -> H : flatten per line; a line is ready\nwhen every wayside reports ready
H -> CTC : (tick k+1) occupancy, switch, crossing\nand signal states; ready per line
CTC -> CTC : follow trains from occupancy
alt line not ready
  CTC -> CTC : dispatch nothing and send no\nspeed or authority on that line
end
CTC --> D : map shows occupancy and states
@enduml

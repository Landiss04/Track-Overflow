@startuml sd11_command_switches
!include ../style.iuml
autonumber

participant "Wayside" as W
participant "PLC (user program\n+ vital block)" as PLC
participant "Central\nHarness" as H
participant "Track Model" as TM
participant "Track Controller\nwindow" as Win

W -> PLC : scan both channels\n(OCC, SWREV, CTCSW, CTCREV, ...)
alt train on the switch's blocks
  PLC --> W : SW_s = SWREV_s\n(locked where it reports)
else clear
  PLC --> W : SW_s from the program's rule;\nobeys CTCSW_s / CTCREV_s
end
W -> W : _drive: switch s commanded\nreverse if SW_s, else normal
W --> H : switch_commands (tick k outputs)
H -> TM : (tick k+1) switch command
TM -> TM : switch machine moves
TM --> H : switch_positions read-back
H -> W : (next tick) SWREV_s
W -> W : agreeing = commanded = reported
W --> Win : Switches table: commanded,\nreported, agreement
note over PLC, W
  While SW_s and SWREV_s differ (moving or failed), the program
  turns the switch's signal red and zeroes authority over it.
end note
@enduml

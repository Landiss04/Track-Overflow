@startuml class_host_ui
!include ../style.iuml
hide empty members
left to right direction

package "Qt / QML" {
  class "Main.qml / TrackController.qml\nPlcDetailsDialog.qml / LastReportDialog.qml" as Qml <<QML>>
  class QObject
  class QAbstractListModel
}

package "track_ctrl_hw (host process): presentation" {
  class TrackControllerState {
    -_controller: TrackController
    -_selected: str
    -_timer: QTimer, every 100 ms
    -_blocks, _office, _switches, _devices, _report: RowsModel
    +changed: Signal
    +diagramChanged: Signal
    +problem: Signal[title, message, details]
    +notice: Signal[title, message]
    +line / waysides / selectedWayside / ready / notReadyText
    +program / diagram / maintenanceText / channelFault
    +loadDatabase(location: str) <<Slot>>
    +loadProgram(location: str) <<Slot>>
    +selectWayside(wayside_id: str) <<Slot>>
    +refresh() <<Slot>>
  }

  class RowsModel {
    +set_rows(rows: list[dict]): None
    +rowCount(): int
    +data(index, role): Any
    +roleNames(): dict
  }

  class views <<module>> {
    +block_rows(snapshot): list[dict]
    +office_rows(snapshot): list[dict]
    +switch_rows(snapshot): list[dict]
    +device_rows(snapshot): list[dict]
    +report_rows(snapshot): list[dict]
    +program_details(snapshot): dict
    +maintenance_text(snapshot): str
    +diagram(snapshot, geometry): dict
  }
  class display <<module>> {
    +mph(speed_mps): str
    +feet(length_m): str
    +blocks(count): str
    +clock(time_s): str
  }
  class schematic <<module>> {
    +layout(territory): dict
  }
  class territory <<module>> {
    +load_territory_file(path): Territory
  }
}

interface TrackController <<Protocol>>

Qml ..> TrackControllerState : binds properties,\ncalls slots
QObject <|-- TrackControllerState
QAbstractListModel <|-- RowsModel
TrackControllerState *-- "5" RowsModel
TrackControllerState --> TrackController
TrackControllerState ..> views
TrackControllerState ..> territory
views ..> display
views ..> schematic
@enduml

@startuml sd02_load_program
!include ../style.iuml
autonumber

actor Programmer as P
participant "Main window\n(QML)" as QML
participant "TrackControllerState" as State
participant "RemoteTrackController" as Remote
participant "HardwareRelay\n+ SerialTransport" as Relay
box "Raspberry Pi 5" #F2F5F9
participant "PiLinkServer\n+ TrackCore" as Pi
participant "HwTrackController" as Ctrl
participant "Wayside" as W
participant "plc" as PLC
end box

P -> QML : **New PLC**, pick a file
QML -> State : loadProgram(url)
State -> State : read the file\n(at most 1 MB, UTF-8)
State -> Remote : load_program(wayside,\nsource, file_name)
Remote -> Relay : call_action("load_program")
Relay -> Pi : ACTION over USB
Pi -> Ctrl : load_program(...)
Ctrl -> W : load_program(source, ...)
W -> PLC : compile_program(source)
note over W, PLC
  Every statement is compiled
  twice: a tree for channel A,
  postfix code for channel B.
end note
PLC --> W : Program (diagnostics)
W -> W : check_program()\nnames must be this\nwayside's I/O
alt any error
  W --> Pi : PlcError(diagnostics)
  Pi --> Relay : refused, with diagnostics
  Relay --> Remote : RemoteActionError
  Remote --> State : PlcError(diagnostics)
  State --> QML : problem("PLC program not\nloaded", every line)
else no errors
  W -> W : install; hold fail-safe\nuntil the next scan
  W --> Pi : ProgramInfo
  Pi --> Relay : ACK (packed) + VIEW
  Relay --> Remote : ProgramInfo, snapshot
  Remote --> State : ProgramInfo
  State --> QML : program name, checksum;\n**Ready** once every\nwayside has a program
end
@enduml

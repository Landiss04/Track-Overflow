@startuml sd02_load_program
!include ../style.iuml
title SD-02 Load PLC program (UC-02)
autonumber

actor Programmer as P
participant "Main window\n(QML)" as QML
participant "TrackControllerState" as State
participant "RemoteTrackController\n+ PiSerialLink" as Remote <<planned>>
box "Raspberry Pi 5" #F2F5F9
participant "PiLinkServer" as Pi <<planned>>
participant "HwTrackController" as Ctrl
participant "Wayside" as W
participant "plc" as PLC
end box

P -> QML : click **New PLC**
QML -> P : file dialog
P -> QML : choose red_wayside_N.plc
QML -> State : loadProgram(url)
alt no wayside selected
  State --> QML : problem("No wayside", ...)
else
  State -> State : read the file (at most 1 MB, UTF-8)
  State -> Remote : load_program(wayside_id, source, file_name)
  Remote -> Pi : {"id", "op": "load_program", wayside_id, source}
  Pi -> Ctrl : load_program(wayside_id, source, file_name)
  Ctrl -> W : load_program(source, file_name, time_s)
  W -> PLC : compile_program(source)
  note right of PLC
    Every statement is compiled twice:
    a tree for channel A and postfix
    code for channel B.
  end note
  PLC --> W : Program (diagnostics)
  W -> W : check_program(program, territory)\nnames must be this wayside's I/O
  alt any error
    W --> Ctrl : PlcError(diagnostics)
    Ctrl --> Pi : PlcError
    Pi --> Remote : {"id", "error": "PlcError", diagnostics}
    Remote --> State : raise PlcError
    State --> QML : problem("PLC program not loaded", message, diagnostics)
    QML --> P : every problem with its line number
  else no errors
    W -> W : install program, reset ScanInfo,\nhold fail-safe until the next scan
    W --> Ctrl : ProgramInfo (checksum, counts, warnings)
    Ctrl --> Pi : ProgramInfo
    Pi --> Remote : {"id", "ok": ProgramInfo}
    Remote --> State : ProgramInfo
    State -> State : refresh()
    State --> QML : changed
    QML --> P : program name and checksum;\n**Ready** once every wayside has a program
  end
end
@enduml

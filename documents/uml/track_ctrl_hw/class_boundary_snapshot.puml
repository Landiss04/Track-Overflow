@startuml class_boundary_snapshot
!include ../style.iuml
hide empty members
left to right direction

package "Snapshot (for the window)" {
  class TrackControllerSnapshot <<frozen>> {
    +line: str | None
    +waysides: tuple[WaysideSnapshot]
    +time_s: float | None
    +ticks: int
    +ready: bool
    +not_ready: tuple[str]
  }
  class WaysideSnapshot <<frozen>> {
    +territory: Territory
    +program: ProgramInfo | None
    +scan: ScanInfo
    +switches: tuple[SwitchState]
    +signal_commands / signal_reports
    +crossing_commands / crossing_reports
    +track_circuits
    +occupied_blocks / closed_blocks
    +suggestions / switch_requests
    +holding: str
    +report: CtcReport | None
  }
  class ProgramInfo <<frozen>> {
    +file_name: str
    +loaded_at_s: float | None
    +checksum: str
    +boolean_count: int
    +statement_count: int
    +warnings: tuple[str]
  }
  class ScanInfo <<frozen>> {
    +scans: int
    +last_scan_s: float | None
    +interval_s: float | None
    +last_duration_s: float
    +overruns: int
    +channels_agree: bool
    +channel_fault: str
  }
  class SwitchState <<frozen>> {
    +switch: Switch
    +commanded: SwitchPosition
    +reported: SwitchPosition | None
    +agreeing: bool
  }
}

TrackControllerSnapshot *-- "*" WaysideSnapshot
WaysideSnapshot *-- "0..1" ProgramInfo
WaysideSnapshot *-- ScanInfo
WaysideSnapshot *-- "*" SwitchState
@enduml

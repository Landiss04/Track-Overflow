@startuml sd07_run_scan_cycle
!include ../style.iuml
autonumber

participant "Central\nHarness" as H
box "Host PC — Track Ctrl HW process" #F7F9FC
participant "ModuleLink" as Link
participant "HardwareRelay" as Relay
end box
box "Raspberry Pi 5" #F2F5F9
participant "PiLinkServer" as Pi
participant "TrackCore" as Core
participant "HwTrackController" as Ctrl
participant "Wayside ×N" as W
end box

H -> Link : STEP {id, tick, dt=0.1, sim_time_s, inputs}
Link -> Relay : submit_step(request)
Relay -> Pi : transport.write(encode(request)) (USB)
Pi -> Pi : handle(request) → _execute(request)
Pi -> Core : step(request)
Core -> Ctrl : step(request["dt"], inputs_from_wire(inputs))
Ctrl -> Ctrl : _validate(inputs)
alt dt not finite and positive, or any input invalid
  Ctrl --> Core : raise InvalidInputError(reason)
  Core --> Pi : InvalidInputError
  Pi --> Relay : REJECTED {id, tick, reason, error}
  Relay --> Link : reply.emit(reply)\n→ reply_rejected(id, tick, reason)
  Link --> H : REJECTED {id, tick, reason}
else valid
  Ctrl -> Ctrl : stall = f"Wayside {id} is not ready: ..."\nfor the first wayside.not_ready_reason, else ""
  loop for wayside in self._waysides.values()
    Ctrl -> W : scan(dt, inputs.time_s, inputs.ctc,\ninputs.track_model, stall)
    W -> W : values, holding = _run_program(occupied, closed,\nsuggestions, requests, track_model, ctc)
    W -> W : program.scan_a(image); program.scan_b(image)
    W -> W : vital.scan_a / scan_b <<planned>>
    alt values is None
      W -> W : _hold_restrictive(holding) (SD-16)
    else
      W -> W : _drive(values) (SD-11 to SD-14)
    end
    W -> W : report = CtcReport(...) (SD-15);\nself._scan_info = ScanInfo(scans + 1, ...)
    W --> Ctrl : WaysideScan(track_circuits, switch_commands,\ncrossing_commands, signal_commands, report)
  end
  Ctrl -> Ctrl : self._time_s = inputs.time_s; self._ticks += 1
  Ctrl --> Core : TrackControllerOutputs(track_model, ctc_reports)
  Core --> Pi : outputs_to_wire(outputs)
  Pi -> Pi : _record(request, reply) (journal)
  Pi --> Relay : OUTPUTS {id, tick, outputs, metrics}
  Relay --> Link : reply.emit(reply)\n→ reply_outputs(id, tick, outputs)
  Link --> H : OUTPUTS {id, tick, outputs}
end
note over H, W
  The Pi has no clock. At 10x the harness sends 100 ticks per second and
  waits for each reply, so USB round trip plus scan must stay under 10 ms.
end note
@enduml

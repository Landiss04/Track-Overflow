@startuml sd07_run_scan_cycle
!include ../style.iuml
autonumber

participant "Central\nHarness" as H
box "Host PC — Track Ctrl HW process" #F7F9FC
participant "ModuleLink" as Link
participant "HardwareRelay\n+ SerialTransport" as Relay
end box
box "Raspberry Pi 5" #F2F5F9
participant "PiLinkServer" as Pi
participant "TrackCore" as Core
participant "HwTrackController" as Ctrl
participant "Wayside ×N" as W
end box

H -> Link : STEP {id, tick k, dt 0.1,\nsim_time, inputs}
Link -> Relay : submit_step(request)
Relay -> Pi : STEP over USB
Pi -> Core : step(request)
Core -> Ctrl : step(dt, inputs)\ntime_s = sim_time
Ctrl -> Ctrl : validate dt and every input
alt invalid
  Ctrl --> Pi : InvalidInputError
  Pi --> Relay : REJECTED, reason
  Relay --> Link : reply_rejected
  Link --> H : REJECTED (tick logged)
else valid
  Ctrl -> Ctrl : stall = first wayside not ready
  loop every wayside of the line
    Ctrl -> W : scan(dt, time_s, ctc, track_model, stall)
    W -> W : input image (SD-08 to SD-10)
    W -> W : user program on channels\nA and B; compare
    W -> W : vital block on A and B\n<<planned>>
    W -> W : drive outputs (SD-11 to SD-14)\nor hold fail-safe (SD-16)
    W -> W : CtcReport (SD-15)
    W --> Ctrl : WaysideScan
  end
  Ctrl --> Core : TrackControllerOutputs
  Core --> Pi : outputs_to_wire
  Pi -> Pi : journal the reply
  Pi --> Relay : OUTPUTS over USB
  Relay --> Link : reply_outputs
  Link --> H : OUTPUTS {id, tick k}
end
note over H, W
  The Pi has no clock. At 10x the harness sends 100 ticks per second and
  waits for each reply, so USB round trip plus scan must stay under 10 ms.
end note
@enduml

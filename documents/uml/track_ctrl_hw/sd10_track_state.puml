@startuml sd10_track_state
!include ../style.iuml
autonumber

participant "Track Model" as TM
participant "Central\nHarness" as H
participant "HwTrackController\n(on the Pi)" as Ctrl
participant "Wayside" as W

TM -> H : outputs: occupied blocks, switch positions,\ncrossing states, signal aspects lit
H -> H : a failed block (broken rail, circuit,\npower) is folded into occupancy
H -> Ctrl : STEP: track_model inputs\n(path as SD-07)
Ctrl -> Ctrl : validate keys (BlockKey)\nand values
Ctrl -> W : scan(...)
W -> W : OCC_n = 1 for each occupied block\n(a train or a failure)
W -> W : SWREV_s = 1 if switch s reports reverse
W -> W : keep switch, crossing and signal\nread-back for the report (SD-15)\nand the agreement check (SD-11)
@enduml

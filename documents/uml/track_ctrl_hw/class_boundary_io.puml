@startuml class_boundary_io
!include ../style.iuml
hide empty members
left to right direction

package "Inputs (every tick)" {
  class TrackControllerInputs <<frozen>> {
    +time_s: float
    +ctc: CtcInputs
    +track_model: TrackModelInputs
  }
  class CtcInputs <<frozen>> {
    +closed_blocks: frozenset[BlockRef]
    +switch_commands: Mapping[BlockRef, SwitchPosition]
    +suggestions: Mapping[BlockRef, Suggestion]
  }
  class Suggestion <<frozen>> {
    +speed_mps: int
    +authority_blocks: int
  }
  class TrackModelInputs <<frozen>> {
    +occupied_blocks: frozenset[BlockKey]
    +switch_positions: Mapping[BlockKey, SwitchPosition]
    +crossings_active: Mapping[BlockKey, bool]
    +signal_aspects: Mapping[BlockKey, SignalAspect]
  }
}

package "Outputs (every tick)" {
  class TrackControllerOutputs <<frozen>> {
    +track_model: TrackModelOutputs
    +ctc_reports: tuple[CtcReport]
    +ready: bool
    +not_ready(): tuple[CtcReport]
  }
  class TrackModelOutputs <<frozen>> {
    +track_circuits: Mapping[BlockKey, TrackCircuitCommand]
    +switch_commands: Mapping[BlockKey, SwitchPosition]
    +crossing_commands: Mapping[BlockKey, bool]
    +signal_commands: Mapping[BlockKey, SignalAspect]
  }
  class TrackCircuitCommand <<frozen>> {
    +speed_mps: int
    +authority_blocks: int
  }
  class CtcReport <<frozen>> {
    +wayside_id: str
    +line: str
    +sent_at_s: float
    +ready: bool
    +blocks: Mapping[BlockKey, BlockReport]
    +reason: str
  }
  class BlockReport <<frozen>> {
    +occupied: bool
    +switch_position: SwitchPosition | None
    +crossing_active: bool | None
    +signal_aspect: SignalAspect | None
  }
}

TrackControllerInputs *-- CtcInputs
TrackControllerInputs *-- TrackModelInputs
CtcInputs *-- "*" Suggestion
TrackControllerOutputs *-- TrackModelOutputs
TrackControllerOutputs *-- "*" CtcReport
TrackModelOutputs *-- "*" TrackCircuitCommand
CtcReport *-- "*" BlockReport
@enduml

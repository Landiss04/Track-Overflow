@startuml sd06_scan_cycle
!include ../style.iuml
autonumber

participant "HwTrackController" as Ctrl
participant "Wayside" as W
participant "User program\n(Program)" as U
participant "Vital block\n(Program)" as V <<planned>>

Ctrl -> W : scan(dt, time_s, ctc, track_model, stall)
activate W
W -> W : keep only this wayside's blocks:\noccupied, closed, suggestions, CTC switch requests
alt another wayside is not ready (stall), no program, or a latched channel fault
  W -> W : _hold_restrictive(reason)\nevery signal red, every crossing active,\nspeed 0 and authority 0, switches stay put
  note right of W : UC-16 Hold fail-safe outputs
else program runs
  W -> W : build the input image\nOCC_n, CLOSED_n, SPD_n_0..4,\nSWREV_s, CTCSW_s, CTCREV_s
  par channel A
    W -> U : scan_a(image)
    U --> W : outputs A
  else channel B
    W -> U : scan_b(image)
    U --> W : outputs B
  end
  alt A ≠ B
    W -> W : latch channel fault, _hold_restrictive(fault)
  else A = B
    W -> W : vital image = image + P_<name> for\nevery user output (AUTH, CMD, SW, SIG, XING)
    par channel A
      W -> V : scan_a(vital image)
      V --> W : outputs A
    else channel B
      W -> V : scan_b(vital image)
      V --> W : outputs B
    end
    alt A ≠ B
      W -> W : latch channel fault, _hold_restrictive(fault)
    else A = B
      W -> W : _drive(values)
      note right of W
        UC-11 SW_s -> switch command normal / reverse
        UC-12 SIG_s_R/Y/G/SG -> aspect (red first)
        UC-13 XING_c -> crossing on / off
        UC-14 CMD_n_0..4 -> speed m/s;
              AUTH_n ? CTC authority : 0
      end note
    end
  end
end
W -> W : CtcReport: occupancy, switch / signal / crossing\nread-back, ready, reason (UC-15)
W -> W : ScanInfo: scans, duration, overruns
W --> Ctrl : WaysideScan
deactivate W
@enduml

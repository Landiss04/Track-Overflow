@startuml sd04_monitor
!include ../style.iuml
autonumber

actor Programmer as P
participant "Main window\n(QML)" as QML
participant "TrackControllerState" as State
participant "views / display" as Views
participant "RowsModel ×5" as Rows
participant "RemoteTrackController" as Remote
participant "HardwareRelay" as Relay
box "Raspberry Pi 5" #F2F5F9
participant "PiLinkServer\n+ TrackCore" as Pi
end box

loop after a request, when VIEW_INTERVAL_S (200 ms) has passed
  Pi -> Relay : VIEW {tick, view={"snapshot": pack(snapshot())}}
  Relay -> Relay : _take_view(view)
  Relay -> Remote : viewChanged.emit(view)
  Remote -> Remote : _view(): self._snapshot = unpack(view["snapshot"])
end
loop self._timer: every 100 ms
  State -> State : _refresh_if_dirty()
  State -> Remote : ticks
  Remote --> State : self._snapshot.ticks
  opt ticks != self._seen_ticks
    State -> State : refresh()
    State -> Remote : snapshot()
    Remote --> State : TrackControllerSnapshot
    State -> Views : wayside(snapshot, selected); block_rows(),\noffice_rows(), switch_rows(), device_rows(),\nreport_rows(); display.mph(), feet(), clock()
    Views --> State : list[dict] per table, display units
    State -> Rows : set_rows(rows) (updated in place)
    State --> QML : changed.emit(); diagramChanged.emit()
  end
end
opt zoom in / out or **Fit**
  P -> QML : zoom or fit
  QML -> QML : diagram scale (QML only)
end
@enduml

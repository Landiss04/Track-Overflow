@startuml class_host
!include ../style.iuml
title Track Controller (HW) — Host-side classes (run on the PC)
hide empty members

package "Qt / QML" {
  class QObject
  class QAbstractListModel
  class QSerialPort
  class "Main.qml / TrackController.qml\nPlcDetailsDialog.qml / LastReportDialog.qml" as Qml <<QML>>
}

package "track_ctrl_hw (host process)" {
  class TrackControllerState {
    -_controller: TrackController
    -_selected: str
    -_timer: QTimer, every 100 ms
    -_blocks, _office, _switches, _devices, _report: RowsModel
    +changed: Signal
    +diagramChanged: Signal
    +problem: Signal[title, message, details]
    +notice: Signal[title, message]
    +loadDatabase(location: str) <<Slot>>
    +loadProgram(location: str) <<Slot>>
    +selectWayside(wayside_id: str) <<Slot>>
    +refresh() <<Slot>>
    +line / waysides / selectedWayside / ready / notReadyText
    +program / diagram / maintenanceText / channelFault
  }

  class RowsModel {
    +set_rows(rows: list[dict]): None
    +rowCount(): int
    +data(index, role): Any
    +roleNames(): dict
  }

  class views <<module>> {
    +block_rows(snapshot): list[dict]
    +office_rows(snapshot): list[dict]
    +switch_rows(snapshot): list[dict]
    +device_rows(snapshot): list[dict]
    +report_rows(snapshot): list[dict]
    +program_details(snapshot): dict
    +maintenance_text(snapshot): str
    +diagram(snapshot, geometry): dict
  }
  class display <<module>> {
    +mph(speed_mps): str
    +feet(length_m): str
    +blocks(count): str
    +clock(time_s): str
  }
  class schematic <<module>> {
    +layout(territory): dict
  }
  class territory <<module>> {
    +load_territory_file(path): Territory
  }

  class RemoteTrackController <<planned>> {
    -_link: PiSerialLink
    +step(dt, inputs): TrackControllerOutputs
    +snapshot(): TrackControllerSnapshot
    +load_territory(territory): tuple[str]
    +load_program(wayside_id, source, file_name): ProgramInfo
    +reset(): None
  }
  note right of RemoteTrackController
    Same Protocol as HwTrackController.
    Each call becomes one request over USB
    (newline JSON via wire.py); errors come
    back typed (PlcError, TerritoryError, ...).
  end note

  class PiSerialLink <<planned>> {
    -_port: QSerialPort
    -_next_id: int
    +open(): bool
    +request(op: str, payload: dict): dict
  }
  note bottom of PiSerialLink
    Finds the Pi by its USB identity, never a
    fixed COM number (D027).
  end note

  class HarnessEndpoint <<planned>> {
    -_controller: TrackController
    +on_message(line: str): None
    -_reply(id: int, tick: int, outputs): None
  }
}

interface TrackController <<Protocol>>

QObject <|-- TrackControllerState
QAbstractListModel <|-- RowsModel
Qml ..> TrackControllerState : binds properties,\ncalls slots
TrackControllerState *-- "5" RowsModel
TrackControllerState --> TrackController
TrackControllerState ..> views
TrackControllerState ..> territory
views ..> display
views ..> schematic
RemoteTrackController ..|> TrackController
RemoteTrackController --> PiSerialLink
PiSerialLink --> QSerialPort
HarnessEndpoint --> TrackController : step()
@enduml

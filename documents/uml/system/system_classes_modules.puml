@startuml system_classes_modules
!include ../style.iuml
hide empty members
left to right direction

package "CTC Office" {
  interface CtcOffice <<Protocol>> {
    +step(dt, inputs): CtcOutputs
    +snapshot(): CtcSnapshot
    +dispatch(...) / cancel_dispatch(...)
    +set_block_closed(...) / set_switch(...)
    +load_schedule(...) / set_automatic_mode(...)
    +set_clock_speedup(...) / set_clock_paused(...)
  }
  class StubCtcOffice
  class CtcOfficeProcess
}

package "Track Controller" {
  interface TrackController <<Protocol>> {
    +step(dt, inputs): TrackControllerOutputs
    +snapshot(): TrackControllerSnapshot
    +load_program(...)
    +reset()
  }
  class "SwTrackController\n(Green)" as SwTC
  class "TrackControllerProcess" as TCP
  class "RemoteTrackController\n(host, Red)" as RemoteTC
  class "TrackCore → HwTrackController\n(Raspberry Pi)" as HwTC
}

package "Track Model" {
  interface TrackModel <<Protocol>> {
    +step(dt, inputs): TrackModelOutputs
    +snapshot()
    +load_layout_file(path)
    +set_block_failure(...) / set_ambient_temp(...)
  }
  class "TrackModel (model.py)" as TMImpl
  class TrackModelProcess
}

package "Train Model" {
  interface TrainModel <<Protocol>> {
    +step(dt, inputs): TrainModelOutputs
    +snapshot()
    +set_failures(...)
    +pull_passenger_emergency_brake()
  }
  class "TrainModel (model.py)" as TrMImpl
  class TrainModelProcess
}

package "Train Controller" {
  class TrainControllerFleet {
    +add(train_id, line)
    +remove(train_id)
    +step_all(dt, inputs): commands
  }
  class ControllerCore {
    +step(...)
    +detect_failures()
    +respond_to_failures()
  }
  class "TrainControllerProcess\n(Green)" as TrCP
  class "RemoteTrainFleet\n(host, Red)" as RemoteTr
  class "TrainCore → fleet\n(Raspberry Pi)" as HwTr
}

StubCtcOffice ..|> CtcOffice
CtcOfficeProcess --> StubCtcOffice : steps
SwTC ..|> TrackController
TCP --> SwTC : steps
RemoteTC ..|> TrackController
RemoteTC --> HwTC : USB serial
TMImpl ..|> TrackModel
TrackModelProcess --> TMImpl : steps
TrMImpl ..|> TrainModel
TrainModelProcess --> TrMImpl : steps
TrainControllerFleet "1" *-- "*" ControllerCore : one per train
TrCP --> TrainControllerFleet : steps
RemoteTr --> HwTr : USB serial
HwTr --> TrainControllerFleet
@enduml

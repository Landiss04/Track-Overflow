@startuml sd02_mode
!include ../style.iuml
title SD-02 Change operating mode (UC-02)
autonumber

actor Dispatcher as D
box "CTC Office process" #F7F9FC
participant "CtcHeader\nOPERATING MODE (QML)" as UI
participant "Main.qml" as Main
participant "CtcHost" as Host
participant "StubCtcOffice" as Model
end box

D -> UI : Automatic, Manual or Maintenance
UI -> Main : modeActivated(index)
Main -> Main : modeIndex = index;\nshow that mode's view
Main -> Host : setAutomaticMode(index == Automatic)
Host -> Model : set_automatic_mode(active)
Main -> Host : setMaintenanceMode(index == Maintenance)
Host -> Model : set_maintenance_mode(active)
alt leaving Maintenance
  Model -> Model : drop every switch command;\nclosed blocks stay closed,\npending closures still close
end
alt Automatic
  Model -> Model : the loaded schedule's runs\ndispatch themselves from the next step
else Manual or Maintenance
  Model -> Model : every scheduled run holds where it is
end
Host --> Main : revision += 1
Main -> D : Automatic view: Selected train, Load schedule,\nAuto dispatch, Throughput\nManual view: Dispatch train, Selected train\n(reroute, return to yard), Throughput\nMaintenance view: Close block, Set switch position,\nActive closures, Throughput
note over Model
  The mode itself is sent to no module:
  the Track Controller gets the closed blocks instead.
end note
@enduml

@startuml sd17_reports
!include ../style.iuml
title SD-17 Receive Track Controller reports (UC-17)
autonumber

participant "Track Controller\n(every wayside)" as TC
participant "Central Harness" as H
box "CTC Office process" #F7F9FC
participant "CtcOfficeProcess" as Proc
participant "wire" as Wire
participant "StubCtcOffice" as Model
participant "_Layout" as L
end box

TC --> H : tick k−1 outputs: one CtcReport per wayside\n(wayside ID, line, ready, reason; per block:\noccupied, switch position, crossing active, ...)
H -> H : track_controller_to_ctc():\noccupancy per block; switches (normal / reverse);\ncrossings (active / inactive from the flag);\nwaysides (ID, line, ready, reason)
H -> Proc : STEP (tick k, inputs.track_controller)
Proc -> Wire : inputs_from_wire()
Wire --> Proc : TrackControllerInputs
Proc -> Model : step(...) (via CtcHost)
Model -> L : validate_inputs(inputs)
L -> L : every line, block, switch and crossing on the layout;\nvalues in range; no block, switch or crossing\nreported twice with different values
alt invalid
  L --> Model : InvalidInputError
  Model --> Proc : the tick is refused (SD-16)
else valid
  Model -> Model : these become the step's inputs
  Model -> Model : occupancy → tracking (SD-18)
  Model -> Model : switch positions → a switch not reported\nset for a route cuts authority short (SD-21)
  Model -> Model : waysides → ready lines (SD-24)
  Model -> Model : crossings → shown on the map (SD-11)
end
@enduml

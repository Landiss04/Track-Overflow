@startuml sd10_set_switch
!include ../style.iuml
title SD-10 Set a switch position (UC-10)
autonumber

actor Dispatcher as D
box "CTC Office process" #F7F9FC
participant "SwitchPanel\n(Maintenance)" as UI
participant "CtcHost" as Host
participant "StubCtcOffice" as Model
end box

D -> UI : Line, Switch
UI -> Host : switchOptions(line), switchDetail(line, switch)
Host -> Model : snapshot()
Host --> UI : Normal (12-13) / Reverse (1-13);\nReported by track controller; Commanded by CTC
D -> UI : Normal or Reverse
D -> UI : Send to track controller
UI -> Host : setSwitch(line, switch_id, 0 or 1)
Host -> Model : set_switch(line, switch_id, "normal" or "reverse")
alt not in maintenance mode
  Model --> Host : MaintenanceModeRequiredError
else the switch's block is occupied
  Model --> Host : UnsafeActionError "Green block 12 is occupied;\nits switch cannot be moved under a train."
else accepted
  Model -> Model : switches[(line, switch)] = position
  Model --> Host : ok
end
Host --> UI : "" or the reason
UI -> D : "Sent: Green switch 12 → reverse." or the reason
note over Model
  The command goes out every step while maintenance
  mode lasts (SD-22). The reported position follows once
  the wayside's PLC program has moved the switch.
end note

== Release ==
D -> UI : Release
UI -> Host : releaseSwitch(line, switch_id)
Host -> Model : release_switch(line, switch_id)
UI -> D : "Released Green switch 12 to the track controller."
@enduml

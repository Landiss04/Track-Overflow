@startuml sd19_schedule_run
!include ../style.iuml
title SD-19 Run the schedule (UC-19)
autonumber

box "CTC Office process" #F7F9FC
participant "StubCtcOffice" as Model
participant "AutoDispatcher" as AD
end box

Model -> Model : _run_schedule()
alt not Automatic mode, dispatch paused, or no schedule
  note over Model : returns at once: every run holds
else
  Model -> AD : step(World(now_s, ready_lines,\nheads, orders, lost))
  loop each run
    AD -> AD : _locate(plan, world)
    note right of AD : moves its place along its path\nup to where its head is
  end
  loop each run on a ready line
    AD -> AD : _advance(plan, progress, world)
    alt queued and due (05:00 + departure)
      AD -> AD : _out_of_yard(plan, progress, 0)
      note right of AD : → in yard: Order to its first stop
    else en route and its head is at the stop
      note right of AD : → dwelling until now + DWELL_S (45 s)
    else dwelling and the 45 s are up
      AD -> AD : _release(plan, progress, leg + 1)
      note right of AD : → en route: Order to the next stop,\nor to the yard entry after the last
    else due to move on, but a two-way zone ahead\nis in use the other way
      AD -> AD : _blocking(plan, progress, target)
      note right of AD : → held: waits at its stop or in the yard,\nor, turned round a loop, Order on with\nauthority stopping a block short of the\nloop's end (hold_at)
    else to yard and its blocks have cleared\nat the yard entry
      note right of AD : → done: Cancel(train)
    end
  end
  AD --> Model : [Order(train_id, line, block_id, due_s) | Cancel(train_id)]
  loop each action
    alt Order
      Model -> Model : dispatch(train_id, line, block_id, due_s)
      opt UnsafeActionError: the stop is closed or closing
        Model -> AD : skip_stop(train_id)
        AD --> Model : Order to the next stop
      end
    else Cancel
      Model -> Model : drop the run's order\n(it is back in the yard)
    end
  end
end
note over AD
  Two-way zones: Green 77–85 and 13–28, Red 16–52.
  Reserved by direction: trains share a zone going
  the same way, never opposite ways, so runs are
  never sent to meet head-on. Loops are one way.
end note
@enduml

@startuml class_core
!include ../style.iuml
title CTC Office — Core classes: the module and train tracking (no Qt)
hide empty members
set separator none

package "ctc.interface" {
  interface CtcOffice <<Protocol>> {
    +step(dt, inputs, sim_time_s): CtcOutputs
    +snapshot(): CtcSnapshot
    +validate_inputs(inputs)
    +stage_inputs(inputs)
    +dispatch(train_id, line, destination_block_id, arrival_s)
    +return_to_yard(train_id)
    +set_block_closed(line, block_id, closed)
    +set_switch(line, switch_id, position)
    +release_switch(line, switch_id)
    +set_maintenance_mode(active)
    +set_clock_speedup(active)
    +set_clock_paused(paused)
    +load_schedule(schedule)
    +set_automatic_mode(active)
    +set_dispatch_paused(paused)
  }
}

package "ctc.model" {
  class StubCtcOffice {
    -_orders: dict[str, DispatchOrder]
    -_closed, _pending: set[BlockRef]
    -_switches: dict[tuple[str, str], str]
    -_granted: dict[str, tuple[str, ...]]
    -_maintenance, _automatic, _dispatch_paused: bool
    -_clock_speedup, _clock_paused: bool
    -_released: dict[str, str]
    -_in_service, _returning: set[str]
    -_tickets: dict[str, int]
    -_elapsed_s: float
    +place_train(train_id, line, block_id)
    -_release()
    -_retire()
    -_run_schedule()
    -_compute_authorities(): tuple[TrainAuthority, ...]
    -_suggested_speed_mps(line, block_id, ...): int
    -_choose_route(line, block, destination, came_from)
    -_outputs(): CtcOutputs
  }
  class _Layout {
    +block(line, block_id, what)
    +switch(line, switch_id, what)
    +crossing(line, crossing_id, what)
    +validate_inputs(inputs)
  }
  class CtcError <<exception>>
  class InvalidTimeStepError <<exception>>
  class InvalidInputError <<exception>>
  class MaintenanceModeRequiredError <<exception>>
  class UnsafeActionError <<exception>>
}

package "ctc.tracking" {
  class TrainTracker {
    +trains: dict[str, Tracked]
    +lost: set[str]
    +place(train_id, line, block_id)
    +update(occupied, now_s, plans, waiting)
  }
  class Tracked <<frozen>> {
    line: str
    blocks: tuple[str, ...]
    reach_m: float
    speed_mps: float
    came_from: str | None
    +head(): str
  }
  class Plan <<frozen>> {
    next_block: str | None
    head_length_m: float
    speed_mps: float
  }
  class Waiting <<frozen>> {
    train_id: str
    line: str
  }
}

class AutoDispatcher <<ctc.scheduler, see class_services>>
class TrackGraph <<ctc.routing, see class_services>>

StubCtcOffice ..|> CtcOffice
StubCtcOffice *-- _Layout
StubCtcOffice *-- TrainTracker
StubCtcOffice *-- "0..1" AutoDispatcher
StubCtcOffice *-- "1 per line" TrackGraph
StubCtcOffice ..> CtcError : raises
CtcError <|-- InvalidTimeStepError
CtcError <|-- InvalidInputError
CtcError <|-- MaintenanceModeRequiredError
CtcError <|-- UnsafeActionError
TrainTracker *-- "*" Tracked
TrainTracker ..> Plan : reads
TrainTracker ..> Waiting : reads
@enduml

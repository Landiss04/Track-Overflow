@startuml uc_track_model
!include ../style.iuml
left to right direction
title CTC Office — Use cases of the Track Model

actor "Track Model\n(through the harness)" as tm

rectangle "CTC Office" {
  usecase "UC-16 Run one step" as UC16 #FFFFFF;line:9AA5B1;text:5A6672
  usecase "UC-23 Receive ticket sales" as UC23
  usecase "UC-14 View throughput metrics" as UC14 #FFFFFF;line:9AA5B1;text:5A6672
}

UC23 <-- tm : tickets sold\nper station
UC16 ..> UC23 : <<include>>
UC23 ..> UC14 : feeds

note bottom of UC16
  Grey: other actors' use cases, shown for
  their links. UC-16 belongs to the Central
  Harness, UC-14 to the Dispatcher.
end note
@enduml

@startuml sd20_release_retire
!include ../style.iuml
title SD-20 Release and retire trains (UC-20)
autonumber

box "CTC Office process" #F7F9FC
participant "StubCtcOffice" as Model
participant "TrainTracker" as Tr
end box
participant "Central Harness\n(roster)" as H
participant "Train Model and\nthe line's Train Controller" as TM

== Release (step n) ==
Model -> Model : _release()
Model -> Model : _waiting()
note right of Model : ordered trains not on the track,\nmost behind schedule first
loop each waiting train
  alt a released train on the line is not yet on the track
    note over Model : skip the line (one at a time)
  else line not ready, or yard exit block occupied, closed,\nclosing or within a train's authority
    note over Model : the train keeps waiting
  else _scheduler_holds(train_id)
    note over Model : the train keeps waiting
  else
    Model -> Model : _released[train_id] = line
    note right of Model : it holds the yard exit block\n(Green 63, Red 9)
  end
end
Model --> H : outputs.new_trains = [NewTrain(train_id, line)]\n(once, on this step only)
H -> H : Roster.apply(outputs, sim_time_s)
H -> TM : (next tick) placement_report(yard exit block)\nas the train's Train Model report

== Leaving the yard (a later step) ==
H -> Model : step (yard exit block now occupied)
Model -> Tr : update(occupied, now_s, plans, waiting = released trains)
Tr --> Model : the released train is on the track
note over Model : it gets suggestions from now on (SD-21)

== Retire (step m) ==
Model -> Model : _retire()
loop each train with authority
  opt _sent_to_yard(train_id), its destination is a yard entry\nblock (Green 57, Red 9), authority 0 there\nand _at_a_stand(train, order)
    Model -> Model : del _orders[train_id]
    note right of Model : out of service
  end
end
Model --> H : outputs.retired_trains = [RetiredTrain(train_id)]
H -> H : Roster.apply(outputs, sim_time_s)
H -> TM : the train is removed
H -> Model : (next step) the yard entry block is clear
note over Model : a scheduled run is "done" (SD-19)
@enduml

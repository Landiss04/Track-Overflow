@startuml uc_ctc_office
!include ../style.iuml
title CTC Office — Use Cases
left to right direction

actor "Dispatcher" as disp
actor "Central Harness\n(shared clock, roster)" as harness
actor "Track Controller" as tc
actor "Track Model" as tm

rectangle "CTC Office — Green and Red Lines" {
  usecase "UC-01 Control the\nsimulation clock" as UC01
  usecase "UC-02 Change operating mode" as UC02
  usecase "UC-03 Dispatch a train\nto a station" as UC03
  usecase "UC-04 Dispatch a train\nto a block" as UC04
  usecase "UC-05 Reroute or cancel\na train's order" as UC05
  usecase "UC-06 Return a train\nto the yard" as UC06
  usecase "UC-07 Load a schedule" as UC07
  usecase "UC-08 Monitor and pause\nautomatic dispatch" as UC08
  usecase "UC-09 Close or reopen a block" as UC09
  usecase "UC-10 Set a switch position" as UC10
  usecase "UC-11 Monitor the track map" as UC11
  usecase "UC-12 Monitor train occupancy" as UC12
  usecase "UC-13 View the selected train" as UC13
  usecase "UC-14 View throughput metrics" as UC14
  usecase "UC-15 Handle notices and\nreversal alerts" as UC15

  usecase "UC-16 Run one step" as UC16
  usecase "UC-17 Receive Track\nController reports" as UC17
  usecase "UC-18 Follow trains\nfrom occupancy" as UC18
  usecase "UC-19 Run the schedule" as UC19
  usecase "UC-20 Release and\nretire trains" as UC20
  usecase "UC-21 Send speed and\nauthority suggestions" as UC21
  usecase "UC-22 Send closures and\nswitch commands" as UC22
  usecase "UC-23 Receive ticket sales" as UC23
  usecase "UC-24 Hold a line\nthat is not ready" as UC24
}

disp --> UC01
disp --> UC02
disp --> UC03
disp --> UC04
disp --> UC05
disp --> UC06
disp --> UC07
disp --> UC08
disp --> UC09
disp --> UC10
disp --> UC11
disp --> UC12
disp --> UC13
disp --> UC14
disp --> UC15

UC01 --> harness : clock_paused,\nclock_speedup
UC16 <-- harness
UC16 ..> UC17 : <<include>>
UC16 ..> UC18 : <<include>>
UC16 ..> UC19 : <<include>>
UC16 ..> UC20 : <<include>>
UC16 ..> UC21 : <<include>>
UC16 ..> UC22 : <<include>>
UC16 ..> UC23 : <<include>>
UC24 ..> UC16 : <<extend>>
UC12 ..> UC13 : <<extend>>
UC05 ..> UC13 : <<extend>>

UC17 <-- tc
UC21 --> tc
UC22 --> tc
UC23 <-- tm
UC20 --> harness : new_trains,\nretired_trains
@enduml

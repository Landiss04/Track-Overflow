@startuml uc_dispatcher
!include ../style.iuml
left to right direction
title CTC Office — Use cases of the Dispatcher

actor "Dispatcher" as disp

rectangle "CTC Office" {
  usecase "UC-01 Control the\nsimulation clock" as UC01
  usecase "UC-02 Change operating mode" as UC02
  usecase "UC-03 Dispatch a train\nto a station" as UC03
  usecase "UC-04 Dispatch a train\nto a block" as UC04
  usecase "UC-05 Reroute\na train" as UC05
  usecase "UC-06 Return a train\nto the yard" as UC06
  usecase "UC-07 Load a schedule" as UC07
  usecase "UC-08 Monitor and pause\nautomatic dispatch" as UC08
  usecase "UC-09 Close or reopen a block" as UC09
  usecase "UC-10 Set a switch position" as UC10
  usecase "UC-11 Monitor the track map" as UC11
  usecase "UC-12 Monitor train occupancy" as UC12
  usecase "UC-13 View the selected train" as UC13
  usecase "UC-14 View throughput metrics" as UC14
  usecase "UC-15 Handle notices and\nreversal alerts" as UC15
}

disp --> UC01
disp --> UC02
disp --> UC03
disp --> UC04
disp --> UC05
disp --> UC06
disp --> UC07
disp --> UC08
disp --> UC09
disp --> UC10
disp --> UC11
disp --> UC12
disp --> UC14
disp --> UC15

UC12 <.. UC13 : <<extend>>\nSelect train
UC15 <.. UC13 : <<extend>>\nSelect train
UC05 ..> UC13 : <<extend>>\nManual mode
UC06 ..> UC13 : <<extend>>\nManual mode
@enduml

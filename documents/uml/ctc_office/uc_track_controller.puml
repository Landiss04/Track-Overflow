@startuml uc_track_controller
!include ../style.iuml
left to right direction
title CTC Office — Use cases of the Track Controller

actor "Track Controller\n(every wayside,\nthrough the harness)" as tc

rectangle "CTC Office" {
  usecase "UC-16 Run one step" as UC16 #FFFFFF;line:9AA5B1;text:5A6672
  usecase "UC-17 Receive Track\nController reports" as UC17
  usecase "UC-18 Follow trains\nfrom occupancy" as UC18
  usecase "UC-21 Send speed and\nauthority suggestions" as UC21
  usecase "UC-22 Send closures and\nswitch commands" as UC22
  usecase "UC-24 Hold a line\nthat is not ready" as UC24
}

UC17 <-- tc : occupancy, switch and\ncrossing states, readiness
UC18 <-- tc : occupancy
UC24 <-- tc : a wayside not ready
UC21 --> tc : suggested speed and\nauthority per block
UC22 --> tc : closed blocks,\nswitch commands
UC16 ..> UC17 : <<include>>
UC16 ..> UC18 : <<include>>
UC16 ..> UC21 : <<include>>
UC16 ..> UC22 : <<include>>
UC24 ..> UC16 : <<extend>>

note top of UC16
  Grey: the Central Harness's use case,
  shown for its include and extend links.
end note
@enduml

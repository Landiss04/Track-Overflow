@startuml sd21_suggestions
!include ../style.iuml
title SD-21 Send speed and authority suggestions (UC-21)
autonumber

box "CTC Office process" #F7F9FC
participant "StubCtcOffice" as Model
participant "TrackGraph" as G
end box
participant "Central Harness" as H
participant "Track Controller\n(the line's)" as TC

loop each train with an order that is on the track, on a ready line
  Model -> G : route(head block, destination, avoid, came_from)\n— round closed, closing and failed blocks and\nstanding trains if the detour is at most 2x
  G --> Model : route (or none: authority 0, "no route")
end
Model -> Model : order the trains: most behind schedule first
loop each train (twice: keep grants first, then extend)
  Model -> G : authority(route, obstructions, reported switches,\nblocks other trains hold)
  G --> Model : AuthorityLimit: blocks, end block, reason\n(destination, occupied, closed, closing,\nswitch, reserved)
  Model -> Model : the blocks within it are this train's\nuntil it has passed them
end
loop each train with an authority
  opt authority ≥ 1
    Model -> Model : next block: speed for that block\nwith one block less; authority − 1
  end
  Model -> Model : head block: speed = min(limit m/s rounded\ndown − 1, √(2 × 1.2 × length within authority));\nauthority = blocks
end
Model --> H : suggestions: (train, line, block, speed, authority)
H -> H : ctc_to_track_controller(line): keep the line's,\nkey by block, drop the train ID; two for one block:\nthe lower speed and authority each
H -> TC : (tick k+1) suggested speed and authority per block
TC -> TC : the PLC program passes them, or 0,\ndown that block's track circuit
@enduml

@startuml sd16_step
!include ../style.iuml
title SD-16 Run one step (UC-16)
autonumber

participant "Central Harness\n(shared clock, roster)" as H
box "CTC Office process" #F7F9FC
participant "ModuleLink" as Link
participant "CtcOfficeProcess" as Proc
participant "wire" as Wire
participant "HarnessClockBridge" as Clock
participant "CtcHost" as Host
participant "StubCtcOffice" as Model
end box

H -> Link : STEP {id, tick: k, dt: 0.1, sim_time_s, inputs}
Link -> Proc : step(tick, dt, sim_time_s, inputs)
Proc -> Wire : inputs_from_wire(inputs)
alt unknown keys or malformed JSON
  Proc --> Link : TickRejectedError
  Link --> H : rejection; module unchanged
end
Proc -> Host : step_at(dt, sim_time_s, inputs)
Host -> Model : step(dt, inputs, sim_time_s)
Model -> Model : _elapsed_at(sim_time_s)
Model -> Model : _layout.validate_inputs(inputs) (SD-17)
note right of Model
  dt finite and positive; time after the
  module's; every input valid against the layout.
end note
alt invalid
  Model --> Host : InvalidInputError / InvalidTimeStepError
  Host --> Proc : raise
  Proc --> Link : TickRejectedError
  Link --> H : rejection; the harness logs it\nand keeps the last outputs
else valid
  ref over Model : SD-18 _tracker.update(...)
  ref over Model : SD-23 _tickets[station] += tickets
  ref over Model : SD-19 _run_schedule()
  Model -> Model : _pending → _closed\nfor each pending closure whose block is clear
  ref over Model : SD-20 _retire()
  Model -> Model : _granted = _authorities()\non _ready_lines() (SD-24)
  Model -> Model : _plans = _make_plans()
  ref over Model : SD-20 _release()
  ref over Model : SD-21, SD-22 _outputs()
  Model --> Host : CtcOutputs
  Host -> Host : _count_sales(sim_time_s, inputs)
  Host --> Proc : CtcOutputs
  Proc -> Clock : show_time(sim_time_s)
  Proc -> Proc : _give_dispatches()
  Proc -> Proc : _redraw.start()
  Proc -> Wire : to_wire(outputs)
  Proc --> Link : outputs
  Link --> H : reply {id, tick: k, outputs}
  Proc ->> Host : refresh()\n(_redraw timeout, at most every 200 ms)
end
@enduml

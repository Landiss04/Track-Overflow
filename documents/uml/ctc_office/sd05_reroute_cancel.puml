@startuml sd05_reroute_cancel
!include ../style.iuml
title SD-05 Reroute a train (UC-05)
autonumber

actor Dispatcher as D
box "CTC Office process" #F7F9FC
participant "SelectedTrainPanel\n(Manual mode)" as UI
participant "CtcHost" as Host
participant "StubCtcOffice" as Model
participant "TrackGraph" as G
end box

D -> UI : New destination, Reroute
UI -> Host : dispatchTrain(train_id, line, block_id, "")
Host -> Model : dispatch(train_id, line, block_id, None)
alt refused (as SD-03)
  Model --> Host : UnsafeActionError
  Host --> UI : the reason
else accepted
  Model -> Model : the new order replaces the old one
  Model --> Host : ok
  Host --> UI : ""
end
UI -> D : "T1 rerouted." or the reason
...next step...
Model -> G : route(head block, new destination,\navoid, came_from)
G --> Model : a route that carries on the way\nthe train is going (never back)

note over D, UI
  There is no Cancel order: the dispatcher may
  replace a train's order, never withdraw it.
end note
@enduml

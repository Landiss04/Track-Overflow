@startuml sd05_reroute_cancel
!include ../style.iuml
title SD-05 Reroute a train (UC-05)
autonumber

actor Dispatcher as D
box "CTC Office process" #F7F9FC
participant "SelectedTrainPanel\n(Manual mode)" as UI
participant "CtcHost" as Host
participant "StubCtcOffice" as Model
participant "TrackGraph" as G
end box

D -> UI : rerouteSelect.committed(block_id)
D -> UI : rerouteArrival.committed("HH:MM")
note right of D : Arrival is optional.
D -> UI : "Reroute".clicked()
UI -> Host : dispatchTrain(train_id, line, block_id, "HH:MM")
Host -> Model : dispatch(train_id, line, block_id, arrival_s)
alt refused (as SD-03)
  Model --> Host : UnsafeActionError
  Host --> UI : the refusal's text
else accepted
  note over Model
    The new order replaces the old one.
  end note
  Model --> Host : ok
  Host --> UI : ""
end
UI -> UI : report(error, done)
UI -> D : "T1 rerouted." or the reason
...next step...
Model -> Model : _choose_route(train, order)
Model -> G : route(head block, new destination,\navoid, came_from)
G --> Model : a route that carries on the way\nthe train is going (never back)
@enduml

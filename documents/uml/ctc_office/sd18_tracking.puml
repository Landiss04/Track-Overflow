@startuml sd18_tracking
!include ../style.iuml
title SD-18 Follow trains from occupancy (UC-18)
autonumber

box "CTC Office process" #F7F9FC
participant "StubCtcOffice" as Model
participant "TrainTracker" as Tr
end box

Model -> Tr : update(occupied blocks, now_s,\nlast step's plans, released trains)
Tr -> Tr : new = occupied − last occupied;\ncleared = last occupied − occupied;\nfailures in cleared blocks end
loop each followed train
  Tr -> Tr : how far it could have gone since the last step:\nreach += fastest it may be going × dt;\nspeed eases down at the service brake rate
end
loop each followed train with a next block on its plan
  alt next block newly occupied and the train could\nhave covered half its own block
    Tr -> Tr : the train moves in: it holds both blocks;\ncame_from = its old head block
  else newly occupied too early
    Tr -> Tr : not this train (a failure, below)
  end
end
loop each line's yard exit block (Green 63, Red 9)
  opt newly occupied and not held by a train
    Tr -> Tr : the train the CTC Office released\non that line is now there
  end
end
loop each followed train
  Tr -> Tr : drop its blocks that cleared
  opt all its blocks cleared
    alt it was at a yard entry block
      Tr -> Tr : it went back into the yard
    else
      Tr -> Tr : lost: dropped quietly ("Not located");\nits order stays
    end
  end
end
Tr -> Tr : failures += newly occupied blocks no train claims
Tr --> Model : trains (blocks, head, came_from), lost, failures
note over Model
  A failure gets no authority and routes go round it,
  but every window shows it only as an occupied block.
end note
@enduml

@startuml sd18_tracking
!include ../style.iuml
title SD-18 Follow trains from occupancy (UC-18)
autonumber

box "CTC Office process" #F7F9FC
participant "StubCtcOffice" as Model
participant "TrainTracker" as Tr
end box

Model -> Tr : update(occupied, now_s, plans, waiting)
note right of Model
  occupied = _occupied(inputs); plans = the last step's
  _make_plans(); waiting = the released trains.
end note
note over Tr
  new = occupied − last occupied;
  cleared = last occupied − occupied;
  failures in cleared blocks end.
end note
loop each followed train
  note over Tr
    How far it could have gone since the last step:
    reach += fastest it may be going × dt;
    speed eases down at the service brake rate.
  end note
end
loop each followed train with a next block on its plan
  alt next block newly occupied and the train could\nhave covered half its own block
    note over Tr
      The train moves in: it holds both blocks;
      came_from = its old head block.
    end note
  else newly occupied too early
    note over Tr : not this train (a failure, below)
  end
end
loop each line's yard exit block (Green 63, Red 9)
  opt newly occupied and not held by a train
    note over Tr
      The waiting train the CTC Office
      released on that line is now there.
    end note
  end
end
loop each followed train
  note over Tr : drop its blocks that cleared
  opt all its blocks cleared
    alt it was at a yard entry block
      note over Tr : it went back into the yard
    else
      note over Tr
        lost: dropped quietly ("Not located");
        its order stays
      end note
    end
  end
end
note over Tr : failures += newly occupied blocks no train claims
Model -> Tr : trains, lost, failures
Tr --> Model : Tracked (line, blocks, head, came_from,\nspeed_mps) per train; lost; failures
note over Model
  A failure gets no authority and routes go round it,
  but every window shows it only as an occupied block.
end note
@enduml

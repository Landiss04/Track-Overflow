@startuml sd13_selected_train
!include ../style.iuml
title SD-13 View the selected train (UC-13)
autonumber

actor Dispatcher as D
box "CTC Office process" #F7F9FC
participant "OccupancyWindow\nor ReversalAlert" as Pick
participant "Main.qml" as Main
participant "SelectedTrainPanel" as Sel
participant "TrackMap" as Map
participant "CtcHost" as Host
participant "StubCtcOffice" as Model
end box

D -> Pick : "Select train".clicked()
Pick -> Main : trainSelected(trainId)\nor selectRequested(trainId)
Main -> Main : selectedTrainId = trainId
Main -> Sel : trainId
loop after each step
  Host -> Sel : stateChanged()
  Sel -> Host : trainDetail(trainId)
  Host -> Model : snapshot()
  Model --> Host : the train's blocks, order, TrainAuthority\n(blocks, end block, reason, at, route,\nheld by, reverse at), suggestions, run
  Host --> Sel : current block, next station, suggested speed (mph),\nauthority and "Authority to", "Limited by" (destination,\nblock occupied / closed / closing, switch not set,\nheld by another train), destination, arrival,\ndwell at next stop, reversal needed
  Sel -> Host : routeDetail(trainId)
  Host --> Sel : route chips
  Main -> Host : routeStates(selectedTrainId)
  Host --> Main : "Line:block" -> within / beyond authority
  Main -> Map : routeStates
  Map -> D : route highlighted: within authority, beyond it
end
opt Manual mode
  Sel -> D : Reroute (SD-05), Return to yard (SD-06)
end
@enduml

@startuml sd06_return_to_yard
!include ../style.iuml
title SD-06 Return a train to the yard (UC-06)
autonumber

actor Dispatcher as D
box "CTC Office process" #F7F9FC
participant "SelectedTrainPanel\n(Manual mode)" as UI
participant "CtcHost" as Host
participant "StubCtcOffice" as Model
end box

D -> UI : Return to yard
UI -> Host : returnToYard(train_id)
Host -> Model : return_to_yard(train_id)
alt the train is not on the track
  Model --> Host : InvalidInputError "T1 is not on the track; ..."
else a run of the loaded schedule
  Model --> Host : InvalidInputError "G1 is a run of the loaded\nschedule; the schedule sends it back itself."
else
  Model -> Model : yard entry block of its line:\nGreen 57, Red 9
  Model -> Model : dispatch(train_id, line, entry block)
  alt refused (line not ready, entry block closed or closing)
    Model --> Host : UnsafeActionError
  else accepted
    Model -> Model : mark the train as returning
    Model --> Host : ok
  end
end
Host --> UI : "" or the refusal's text
UI -> D : "T1 sent back to the yard." or the reason
note over Model
  Once the train has stopped at the yard entry block with
  authority 0, it is retired like a scheduled run (SD-20).
  A later order or a cancel withdraws the return.
end note
@enduml

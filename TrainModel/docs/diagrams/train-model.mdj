						{
							"_type": "UMLNoteView",
							"_id": "AAAAAAGTrM0000000000705=",
							"_parent": {
								"$ref": "AAAAAAGTrM0000000000004="
							},
							"font": "Arial;13;0",
							"text": "Failure effects. Engine: traction is zeroed. Brake: the service brake is blocked; the emergency brake still works. Signal pickup: the commanded speed and authority passed through to the Train Controller are zeroed. Failures are not reported to the Train Controller.",
							"left": 1758,
							"top": 981,
							"width": 380,
							"height": 95
						},
						{
							"_type": "UMLNoteView",
							"_id": "AAAAAAGTrM0000000000706=",
							"_parent": {
								"$ref": "AAAAAAGTrM0000000000004="
							},
							"font": "Arial;13;0",
							"text": "The Train Model is physics only (D009): no speed governing, no 70 km/h cap, no traction cut under braking, no door interlock. A passenger brake pull latches; its release is undecided (D011). The included use cases are the stages of every step.",
							"left": 240,
							"top": 981,
							"width": 380,
							"height": 95
						}

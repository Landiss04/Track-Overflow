										{
											"_type": "UMLNoteView",
											"_id": "AAAAAAGTrM0000000002582=",
											"_parent": {
												"$ref": "AAAAAAGTrM0000000002166="
											},
											"font": "Arial;13;0",
											"text": "Message 6: static call on the TrainModel class imported into the test UI process (model.py). No message crosses a process for it.",
											"left": 3331,
											"top": 120,
											"width": 300,
											"height": 70
										},
										{
											"_type": "UMLNoteView",
											"_id": "AAAAAAGTrM0000000002583=",
											"_parent": {
												"$ref": "AAAAAAGTrM0000000002166="
											},
											"font": "Arial;13;0",
											"text": "Message 11: one line of JSON over a local socket (QLocalSocket): {\"op\": \"step\", \"id\", \"dt\", \"inputs\", \"clear_passenger_brake\"}. The reply carries the same id: {\"op\": \"outputs\"} or {\"op\": \"error\", \"kind\", \"message\"}. SocketLink blocks until it arrives (2 s timeout).",
											"left": 3331,
											"top": 210,
											"width": 300,
											"height": 125
										},
										{
											"_type": "UMLNoteView",
											"_id": "AAAAAAGTrM0000000002584=",
											"_parent": {
												"$ref": "AAAAAAGTrM0000000002166="
											},
											"font": "Arial;13;0",
											"text": "Message 13: with override_passenger_brake, TrainModelState first calls validate_inputs() and then clear_passenger_brake_for_test() (test only), so an invalid step leaves the latch alone.",
											"left": 3331,
											"top": 355,
											"width": 300,
											"height": 95
										},
										{
											"_type": "UMLNoteView",
											"_id": "AAAAAAGTrM0000000002585=",
											"_parent": {
												"$ref": "AAAAAAGTrM0000000002166="
											},
											"font": "Arial;13;0",
											"text": "Inner alt: a defensive backstop. The test UI already ran validate_inputs() before sending, so this path is not expected.",
											"left": 3331,
											"top": 470,
											"width": 300,
											"height": 70
										},
										{
											"_type": "UMLNoteView",
											"_id": "AAAAAAGTrM0000000002586=",
											"_parent": {
												"$ref": "AAAAAAGTrM0000000002166="
											},
											"font": "Arial;13;0",
											"text": "Message 37: SocketLink.outputsChanged is connected to TestHarnessState.outputsChanged, so the harness re-emits it here. TestLinkServer also pushes outputs on snapshotChanged, but skips the requester, which gets them in its reply.",
											"left": 3331,
											"top": 560,
											"width": 300,
											"height": 110
										}
									]
								}
							],

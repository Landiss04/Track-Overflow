        </mxCell>
        <mxCell id="note-physics-only" value="The Train Model is physics only (D009). Speed limiting, the 70 km/h cap, the door interlock and cutting traction under braking belong to the Train Controller." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="560" y="853" width="300" height="102" as="geometry" />
        </mxCell>
        <mxCell id="note-failures" value="Murphy injects failures at the devices tagged {failure}. Engine: traction is zeroed. Brake: the service brake is blocked; the emergency brake still works. Signal pickup: the commanded speed and authority passed to the Train Controller are zeroed. Failures are not reported to the Train Controller." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
